# Copia este archivo como .env y cambia los valores. Nunca subas .env al repositorio.
FLASK_ENV_CONFIG=development
DATABASE_URL=postgresql+psycopg://control_pro:CAMBIAR@localhost:5432/control_pro
TEST_DATABASE_URL=postgresql+psycopg://control_pro:CAMBIAR@localhost:5432/control_pro_test
SECRET_KEY=cambiar-por-una-cadena-aleatoria-larga
JWT_SECRET_KEY=cambiar-por-otra-cadena-aleatoria-de-al-menos-32-caracteres
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
# Tienda en línea para personas (carrito y pagos). false = solo solicitudes de sucursales
CANAL_TIENDA=false
# Reglas de negocio
RESERVA_HORAS=24
PERMITIR_DIVISION=true
COSTO_ENVIO=150.00
ENVIO_GRATIS_DESDE=1500.00
IVA_TASA=0.16
INTENTOS_MAXIMOS=5
BLOQUEO_MINUTOS=15
# Solo desarrollo: devuelve el token de recuperación en la respuesta mientras no haya SMTP
EXPONER_TOKEN_RECUPERACION=true
CORREO_PROVEEDOR=consola
# Correo real (CORREO_PROVEEDOR=smtp). Las credenciales viven solo en el entorno del backend.
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=
SMTP_TLS=true
# Formulario público de contacto: buzón que lo recibe. Vacío o sin SMTP = deshabilitado (responde 503).
CONTACTO_DESTINATARIO=
CONTACTO_MAX_POR_HORA=5
