else if(page==='Incidencias'){v=`<div class="panel"><div class="panelhead"><div><h2>Centro de incidencias</h2><p>Conserva la evidencia original al resolver.</p></div><button class="btn primary" onclick="openModal('incident')">＋ Nueva incidencia</button></div>${table(['FOLIO','TIPO','PEDIDO','PRIORIDAD','ESTADO','ACCIÓN'],data.incidents.map(i=>`<tr><td>${i.id}</td><td>${i.type}<small style="display:block;color:#94a3b8;margin-top:3px">${esc(i.description)}</small></td><td>${i.orderId}</td><td>${status(i.priority)}</td><td>${status(i.status)}</td><td><button class="btn" onclick="openModal('incident-detail','${i.id}')">Gestionar</button></td></tr>`).join(''))}</div>`}
else if(page==='Conformidades'){v=table(['EMPLEADO','PEDIDO','PAQUETE','ESTADO','FECHA','VALORACIÓN','OBSERVACIONES'],data.deliveries.filter(d=>d.status==='Entregado').map(d=>`<tr><td>${esc(data.employees.find(e=>e.id===d.employee)?.name)}</td><td>${d.orderId}</td><td>${d.packageId}</td><td>${status(d.status)}</td><td>${d.signedAt}</td><td>${d.rating}/5</td><td>${esc(d.note||'—')}</td></tr>`).join(''))}
else if(page==='Actividad reciente'){v=`<div class="panel"><div class="panelhead"><h2>Auditoría de operaciones</h2><button class="btn" onclick="exportCSV(data.audit,'auditoria.csv')">↓ Exportar CSV</button></div><div class="activity">${data.audit.filter(a=>`${a.action} ${a.detail}`.toLowerCase().includes(q)).map(a=>`<div class="event"><b>${esc(a.action)}</b><p>${esc(a.detail)}</p><small>${esc(a.user||'Usuario')} · ${esc(a.date)}</small></div>`).join('')}</div></div>`}
else if(page==='Notificaciones'){v=`<div class="panel"><div class="panelhead"><h2>Notificaciones</h2><button class="btn" onclick="data.notifications.forEach(n=>n.read=true);save();render()">Marcar todas leídas</button></div><div class="activity">${data.notifications.map(n=>`<div class="event"><b>${n.read?'':'● '}${esc(n.text)}</b><p>${n.date}</p><button class="btn" onclick="n.read=true;save();render()">Marcar leída</button></div>`).join('')}</div></div>`}
else if(page==='Usuarios y permisos'){v=`<div class="grid" style="grid-template-columns:repeat(3,minmax(0,1fr))">${['Administrador','Representante de sucursal','Gerente de ventas','Responsable de inventario','Supervisor / auditor'].map(r=>`<div class="card"><div class="label">ROL DE DEMOSTRACIÓN</div><h3>${r}</h3><p style="font-size:11px;color:#64748b;line-height:1.6">${({'Administrador':'Acceso completo a la demostración.','Representante de sucursal':'Pedidos, recepción, entregas e incidencias.','Gerente de ventas':'Revisión, aprobación y rechazo de pedidos.','Responsable de inventario':'Órdenes, paquetes y guías.','Supervisor / auditor':'Reportes e historial de operación.'})[r]}</p><button class="btn" onclick="document.getElementById('role').value='${r}';render()">Cambiar rol</button></div>`).join('')}</div><div class="notice">La autorización visual no sustituye controles de seguridad en un backend real.</div>`}
else if(page==='Configuración'){v=`<div class="panel"><div class="panelhead"><div><h2>Reglas de productos por puesto</h2><p>Configura las reglas en el catálogo.</p></div></div><div class="activity">${['Enfermería','Administración','Mantenimiento','Seguridad','Intendencia','Almacén'].map(j=>`<div class="event"><b>${j}</b><p>${data.products.filter(p=>p.jobs.includes(j)).map(p=>p.name).join(', ')||'Sin productos autorizados'}</p></div>`).join('')}</div></div><div class="panel"><div class="panelhead"><h2>Mantenimiento de la demo</h2><button class="btn danger" onclick="if(confirm('¿Restablecer los datos iniciales?')){data=structuredClone(seed);save();render();toast('Demostración restablecida')} ">↻ Restablecer datos</button></div><div class="notice">Persistencia local en este navegador. No uses información personal real.</div></div>`}
else if(page==='Reportes'){v=`<div class="grid">${[['Pedidos',data.orders.length],['Empleados',data.employees.length],['Entregas completadas',data.deliveries.filter(d=>d.status==='Entregado').length],['Incidencias abiertas',data.incidents.filter(i=>!['Resuelta','Cerrada'].includes(i.status)).length]].map(x=>`<div class="card"><div class="label">${x[0]}</div><strong>${x[1]}</strong><small>Indicador calculado</small></div>`).join('')}</div><div class="panel"><div class="panelhead"><h2>Exportar reportes</h2></div><div class="toolbar">${['Pedidos','Empleados','Incidencias','Paquetes','Entregas','Auditoría'].map(s=>`<button class="btn" onclick="exportReport('${s}')">↓ ${s} CSV</button>`).join('')}</div></div>`}
else if(page==='Modo demostración'){let steps=[['1. Crear pedido','El representante selecciona empleados y uniformes.','Pedidos'],['2. Aprobar pedido','El gerente autoriza y genera inventario.','Aprobaciones'],['3. Liberar inventario','El responsable libera la orden.','Órdenes de inventario'],['4. Preparar paquetes','Agrupa los kits de empleados.','Preparación y paquetes'],['5. Registrar guía','Añade el número de guía ficticio.','Envíos y guías'],['6. Simular transporte','Avanza los eventos de envío.','Envíos y guías'],['7. Recibir paquete','Confirma la recepción física.','Recepción en sucursal'],['8. Entregar kits','Registra la firma individual.','Entregas individuales'],['9. Resolver incidencias','Consulta y cierra incidencias.','Incidencias']];v=`<div class="panel"><div class="panelhead"><div><h2>Recorrido completo</h2><p>Las confirmaciones de usuario no se saltan automáticamente.</p></div><button class="btn danger" onclick="if(confirm('¿Restablecer demo?')){data=structuredClone(seed);save();render()}">Reiniciar</button></div><div class="activity">${steps.map((s,i)=>`<div class="event" style="display:flex;align-items:center;gap:12px"><div style="width:32px;height:32px;display:grid;place-items:center;border-radius:50%;background:#eff6ff;color:#2563eb;font-weight:700">${i+1}</div><div style="flex:1"><b>${s[0]}</b><p>${s[1]}</p></div><button class="btn" onclick="go('${s[2]}')">Abrir módulo →</button></div>`).join('')}</div></div><div class="notice">Regla clave: transportista entregado ≠ recepción en sucursal ≠ conformidad individual del empleado.</div>`}
document.getElementById('view').innerHTML=v;document.querySelector('.heading>button').style.display=['Dashboard','Pedidos'].includes(page)?'':'none';}
function releaseInv(id){let i=data.inventory.find(x=>x.id===id);i.status='Liberada para preparación';log('Orden liberada',id);save();render();toast('Orden liberada.')}
function exportReport(s){let rows=s==='Pedidos'?data.orders.map(o=>({folio:o.id,sucursal:o.branch,fecha:o.date,estado:o.status})):s==='Empleados'?data.employees:s==='Incidencias'?data.incidents:s==='Paquetes'?data.packages:s==='Entregas'?data.deliveries:data.audit;exportCSV(rows,'control-pro-'+s.toLowerCase()+'.csv')}
document.getElementById('modalbg').addEventListener('click',e=>{if(e.target.id==='modalbg')closeModal()});render();
</script></body></html>
