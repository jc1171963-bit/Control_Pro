 if(modal==='deliver'){const delivery=data.deliveries.find(d=>d.id===selected);const emp=data.employees.find(e=>e.id===delivery?.employeeId);const o=data.orders.find(x=>x.id===delivery?.orderId);const its=o?.items.filter(i=>i.employeeId===delivery?.employeeId)||[];return <form className="form-stack" onSubmit={e=>{e.preventDefault();if(!hasInk.current){onToast('Captura la firma del empleado antes de confirmar.');return}if(!checked){onToast('Confirma que revisaste los artículos entregados.');return}const c=canvasRef.current;const signature=c?.toDataURL('image/png')||'';onUpdate(d=>{const del=d.deliveries.find(x=>x.id===selected)!;del.status='Entregado';del.signedAt=now();del.signature=signature;del.rating=Number(rating);del.note=note;d.audit.unshift({id:id('AUD'),date:now(),user:role,action:'Entrega individual confirmada',detail:`${emp?.name} · ${delivery?.orderId}`});const ord=d.orders.find(x=>x.id===delivery?.orderId);if(ord){const relevant=d.deliveries.filter(x=>x.orderId===ord.id);if(relevant.length>0&&relevant.every(x=>x.status==='Entregado'))ord.status='Completado'}d.notifications.unshift({id:id('NOT'),text:`Entrega individual confirmada para ${emp?.name}.`,read:false,date:today()});return d});onClose();onToast('Entrega registrada con firma y conformidad.')}}><div className="person-hero"><div className="avatar large">{emp?.name.split(' ').map(x=>x[0]).slice(0,2).join('')}</div><div><h3>{emp?.name}</h3><p>{emp?.job} · {emp?.branch}</p><span className="muted small-text">Pedido {delivery?.orderId} · Paquete {delivery?.packageId}</span></div></div><h3 className="section-title">Artículos esperados</h3><div className="delivery-items">{its.map((it,i)=><div key={i}><div><b>{data.products.find(p=>p.id===it.productId)?.name}</b><small>Talla {it.size} · Cantidad {it.qty}</small></div><Status value={it.exception?'Excepción pendiente':'Esperado'}/></div>)}</div><label className="checkbox-line"><input type="checkbox" checked={checked} onChange={e=>setChecked(e.target.checked)}/> Confirmo que revisé los artículos, tallas y cantidades entregadas.</label><label>Valoración de conformidad<select value={rating} onChange={e=>setRating(e.target.value)}>{[5,4,3,2,1].map(n=><option key={n} value={n}>{n} de 5 {n===5?'· Excelente':n===4?'· Bueno':n===3?'· Regular':n===2?'· Malo':'· Muy malo'}</option>)}</select></label><label>Observaciones<textarea value={note} onChange={e=>setNote(e.target.value)} rows={2} placeholder="Comentarios del empleado…"/></label><div className="signature-label"><div><b>Firma de conformidad</b><small>Firma dibujada con mouse o dedo.</small></div><button type="button" className="text-button" onClick={clearSignature}>Borrar firma</button></div><canvas ref={canvasRef} width={520} height={150} className="signature-canvas" onMouseDown={drawStart} onMouseMove={drawMove} onMouseUp={drawEnd} onMouseLeave={drawEnd} onTouchStart={drawStart} onTouchMove={drawMove} onTouchEnd={drawEnd}/><div className="signature-foot"><span><Fingerprint size={14}/> La firma se guarda solo en este navegador.</span><span>Firma simple de demostración; no es firma electrónica avanzada.</span></div><div className="modal-actions"><button type="button" className="btn secondary" onClick={onClose}>Cancelar</button><button className="btn primary"><Check size={16}/> Confirmar entrega</button></div></form>}
 if(modal==='new-incident')return <form className="form-stack" onSubmit={e=>{e.preventDefault();const f=new FormData(e.currentTarget);const iid=id('INC-2026');const oid=String(f.get('order')||data.orders[0]?.id);const eid=String(f.get('employee')||'');const incident={id:iid,orderId:oid,employeeId:eid||undefined,type:String(f.get('type')||'Otro'),priority:String(f.get('priority')||'Media'),status:'Abierta',description:String(f.get('description')||''),created:today()};onUpdate(d=>{d.incidents.unshift(incident);d.audit.unshift({id:id('AUD'),date:now(),user:role,action:'Incidencia registrada',detail:`${iid} · ${incident.type}`});d.notifications.unshift({id:id('NOT'),text:`Nueva incidencia ${iid}: ${incident.type}.`,read:false,date:today()});return d});onClose();onToast('Incidencia registrada.')}}><div className="form-grid"><label>Pedido relacionado<select name="order">{data.orders.map(o=><option key={o.id}>{o.id}</option>)}</select></label><label>Empleado afectado<select name="employee"><option value="">No aplica / paquete</option>{data.employees.map(e=><option key={e.id} value={e.id}>{e.name}</option>)}</select></label><label>Tipo<select name="type">{['Talla incorrecta','Artículo faltante','Artículo incorrecto','Artículo dañado','Kit incompleto','Paquete no recibido','Producto no autorizado','Otro'].map(t=><option key={t}>{t}</option>)}</select></label><label>Prioridad<select name="priority"><option>Baja</option><option selected>Media</option><option>Alta</option><option>Crítica</option></select></label></div><label>Descripción<textarea name="description" rows={3} required placeholder="Describe la incidencia y la evidencia disponible…"/></label><div className="modal-actions"><button type="button" className="btn secondary" onClick={onClose}>Cancelar</button><button className="btn primary"><Plus size={15}/> Registrar incidencia</button></div></form>;
 if(modal==='incident-detail'&&incident)return <div className="detail-stack"><div className="detail-summary"><div><span className="detail-label">INCIDENCIA</span><h3>{incident.id}</h3><p>{incident.type} · Creada {incident.created}</p></div><Status value={incident.status}/></div><div className="note-box"><b>Descripción original</b><p>{incident.description}</p><small>Pedido {incident.orderId} · Empleado {data.employees.find(e=>e.id===incident.employeeId)?.name||'No especificado'}</small></div><label>Estado<select value={incident.status} onChange={e=>onIncidentChange(incident.id,e.target.value)}>{['Abierta','En revisión','En resolución','Resuelta','Cerrada'].map(s=><option key={s}>{s}</option>)}</select></label><label>Resolución / comentario<textarea value={resolution||incident.resolution||''} onChange={e=>setResolution(e.target.value)} rows={3} placeholder="Describe la solución sin borrar la evidencia original…"/></label><div className="modal-actions"><button className="btn secondary" onClick={onClose}>Cerrar</button><button className="btn primary" onClick={()=>{onIncidentChange(incident.id,incident.status,resolution);onClose()}}><Check size={15}/> Guardar resolución</button></div></div>;
 return <div className="empty-state"><div><FileText size={24}/></div><b>Información no disponible</b><p>El registro puede haber cambiado o ya no existe.</p><button className="btn secondary" onClick={onClose}>Cerrar</button></div>;
}
function canApprove(role:Role){return role==='Administrador'||role==='Gerente de ventas'}
function Reports({data,exportCsv}:{data:AppData;exportCsv:(rows:Record<string,unknown>[],name:string)=>void}){const [report,setReport]=useState('Pedidos');const [branch,setBranch]=useState('Todas');const orders=data.orders.filter(o=>branch==='Todas'||o.branch===branch);const deliveries=data.deliveries.filter(d=>{const o=data.orders.find(x=>x.id===d.orderId);return branch==='Todas'||o?.branch===branch});return <><div className="report-kpis"><div className="panel"><span>Pedidos registrados</span><b>{orders.length}</b><small>En sucursales filtradas</small></div><div className="panel"><span>Kits / artículos</span><b>{orders.reduce((n,o)=>n+o.items.reduce((s,i)=>s+i.qty,0),0)}</b><small>Solicitados en pedidos</small></div><div className="panel"><span>Entregas completadas</span><b>{deliveries.filter(d=>d.status==='Entregado').length}</b><small>Conformidad individual</small></div><div className="panel"><span>Incidencias abiertas</span><b>{data.incidents.filter(i=>!['Resuelta','Cerrada'].includes(i.status)).length}</b><small>Requieren seguimiento</small></div></div><div className="panel"><div className="toolbar"><div className="filter-pills">{['Pedidos','Entregas','Incidencias','Paquetes'].map(s=><button className={report===s?'selected':''} key={s} onClick={()=>setReport(s)}>{s}</button>)}</div><div className="toolbar-right"><select value={branch} onChange={e=>setBranch(e.target.value)}><option>Todas</option><option>Toluca</option><option>Querétaro</option><option>Puebla</option></select><button className="btn primary" onClick={()=>{if(report==='Pedidos')exportCsv(orders.map(o=>({folio:o.id,fecha:o.created,sucursal:o.branch,empleados:new Set(o.items.map(i=>i.employeeId)).size,articulos:o.items.reduce((n,i)=>n+i.qty,0),estado:o.status})),'reporte-pedidos.csv');else if(report==='Entregas')exportCsv(deliveries.map(d=>({empleado:data.employees.find(e=>e.id===d.employeeId)?.name,pedido:d.orderId,paquete:d.packageId,estado:d.status,fecha:d.signedAt||'',valoracion:d.rating||''})),'reporte-entregas.csv');else if(report==='Incidencias')exportCsv(data.incidents.map(i=>({folio:i.id,tipo:i.type,pedido:i.orderId,prioridad:i.priority,estado:i.status,fecha:i.created,resolucion:i.resolution||''})),'reporte-incidencias.csv');else exportCsv(data.packages.map(p=>({paquete:p.id,pedido:p.orderId,guia:p.guide||'',kits:p.employeeIds.length,estado:p.status,recepcion:p.received?'Confirmada':'Pendiente'})),'reporte-paquetes.csv')}}><Download size={15}/> Exportar CSV</button></div></div>{report==='Pedidos'&&<table><thead><tr><th>FOLIO</th><th>FECHA</th><th>SUCURSAL</th><th>EMPLEADOS</th><th>ARTÍCULOS</th><th>ESTADO</th></tr></thead><tbody>{orders.map(o=><tr key={o.id}><td>{o.id}</td><td>{o.created}</td><td>{o.branch}</td><td>{new Set(o.items.map(i=>i.employeeId)).size}</td><td>{o.items.reduce((n,i)=>n+i.qty,0)}</td><td><Status value={o.status}/></td></tr>)}</tbody></table>}{report==='Entregas'&&<table><thead><tr><th>EMPLEADO</th><th>PEDIDO</th><th>PAQUETE</th><th>ESTADO</th><th>FECHA</th></tr></thead><tbody>{deliveries.map(d=><tr key={d.id}><td>{data.employees.find(e=>e.id===d.employeeId)?.name}</td><td>{d.orderId}</td><td>{d.packageId}</td><td><Status value={d.status}/></td><td>{d.signedAt||'—'}</td></tr>)}</tbody></table>}{report==='Incidencias'&&<table><thead><tr><th>FOLIO</th><th>TIPO</th><th>PEDIDO</th><th>PRIORIDAD</th><th>ESTADO</th></tr></thead><tbody>{data.incidents.map(i=><tr key={i.id}><td>{i.id}</td><td>{i.type}</td><td>{i.orderId}</td><td><Status value={i.priority}/></td><td><Status value={i.status}/></td></tr>)}</tbody></table>}{report==='Paquetes'&&<table><thead><tr><th>PAQUETE</th><th>PEDIDO</th><th>GUÍA</th><th>KITS</th><th>ESTADO</th><th>RECEPCIÓN</th></tr></thead><tbody>{data.packages.map(p=><tr key={p.id}><td>{p.id}</td><td>{p.orderId}</td><td>{p.guide||'—'}</td><td>{p.employeeIds.length}</td><td><Status value={p.status}/></td><td>{p.received?'Confirmada':'Pendiente'}</td></tr>)}</tbody></table>}</div><div className="panel report-chart"><div className="panel-header"><div><h2>Resumen de pedidos por estado</h2><p>Conteo calculado desde los registros actuales</p></div><FileBarChart size={19} className="muted"/></div><div className="status-chart">{['En revisión','Aprobado','En preparación','En tránsito','Completado','Rechazado'].map((s,i)=>{const n=orders.filter(o=>o.status===s).length;const max=Math.max(1,...orders.map(o=>orders.filter(x=>x.status===x.status).length));return <div className="bar-row" key={s}><div><span>{s}</span><b>{n}</b></div><div className="bar-track"><div className={`bar-fill b${i%5}`} style={{width:`${n/Math.max(1,orders.length)*100}%`}}/></div></div>})}</div></div></>}
function DemoPage({data,go,onReset}:{data:AppData;go:(p:string)=>void;onReset:()=>void}){const steps=[{title:'Crear pedido',desc:'El representante selecciona empleados, productos y tallas.',role:'Representante de sucursal',page:'orders',done:data.orders.some(o=>o.id==='PED-2026-001'||o.status!=='Borrador')},{title:'Enviar a revisión',desc:'El pedido queda en la bandeja del gerente.',role:'Representante de sucursal',page:'orders',done:data.orders.some(o=>o.status==='En revisión')},{title:'Aprobar pedido',desc:'El gerente valida la solicitud y genera una orden de inventario.',role:'Gerente de ventas',page:'approvals',done:data.orders.some(o=>o.inventoryId)},{title:'Liberar inventario',desc:'El responsable libera la orden autorizada.',role:'Responsable de inventario',page:'inventory',done:data.inventory.some(i=>i.status==='Liberada para preparación'||i.status==='En preparación')},{title:'Preparar paquetes',desc:'Se agrupan kits por empleado y se crea el paquete.',role:'Responsable de inventario',page:'packages',done:data.packages.length>0},{title:'Registrar guías',desc:'Se captura el transportista y la guía ficticia.',role:'Responsable de inventario',page:'shipments',done:data.packages.some(p=>!!p.guide)},{title:'Simular envío',desc:'Avanza los eventos de transporte sin confirmar la recepción.',role:'Responsable de inventario',page:'shipments',done:data.packages.some(p=>p.status==='Entregado por transportista'||p.received)},{title:'Confirmar recepción',desc:'El representante verifica físicamente el contenido del paquete.',role:'Representante de sucursal',page:'receiving',done:data.packages.some(p=>p.received)},{title:'Entregar y cerrar',desc:'Cada empleado firma su propia conformidad o registra una incidencia.',role:'Representante de sucursal',page:'deliveries',done:data.deliveries.length>0&&data.deliveries.every(d=>d.status==='Entregado')}];const next=steps.find(s=>!s.done);return <><div className="demo-hero"><div className="demo-hero-icon"><ListChecks size={26}/></div><div><span className="eyebrow">RECORRIDO GUIADO</span><h2>De la solicitud a la conformidad</h2><p>Completa las etapas en orden. El simulador no omite aprobaciones, recepciones físicas ni firmas.</p></div><button className="btn secondary" onClick={onReset}><RotateCcw size={15}/> Reiniciar demo</button></div><div className="demo-progress"><div><span>Progreso del recorrido</span><b>{steps.filter(s=>s.done).length} de {steps.length} etapas</b></div><div className="progress-track"><div style={{width:`${steps.filter(s=>s.done).length/steps.length*100}%`}}/></div></div><div className="demo-steps">{steps.map((s,i)=><div className={`demo-step ${s.done?'done':''} ${next?.title===s.title?'current':''}`} key={s.title}><div className="step-rail"><div className="step-circle">{s.done?<Check size={17}/>:i+1}</div>{i<steps.length-1&&<div className="step-line"/>}</div><div className="step-main"><div className="step-top"><h3>{s.title}</h3><Status value={s.done?'Completado':next?.title===s.title?'Siguiente paso':'Pendiente'}/></div><p>{s.desc}</p><div className="step-meta"><span><Users size={14}/>{s.role}</span></div></div><button className={`btn ${next?.title===s.title?'primary':'secondary'}`} onClick={()=>go(s.page)}>{next?.title===s.title?'Continuar':'Abrir módulo'} <ArrowRight size={15}/></button></div>)}</div><div className="info-banner"><div className="info-icon"><ShieldCheck size={20}/></div><div><b>Separación de responsabilidades</b><p>El transportista puede marcar un envío como entregado, pero solo el representante confirma la recepción y cada empleado confirma su kit individual.</p></div></div></>}
