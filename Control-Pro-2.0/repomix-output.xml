  {page==='orders'&&<div className="panel"><div className="toolbar"><div className="filter-pills">{['Todos','En revisión','Aprobado','En preparación','En tránsito','Completado','Rechazado'].map(s=><button key={s} className={filter===s?'selected':''} onClick={()=>setFilter(s)}>{s}</button>)}</div><button className="btn secondary" onClick={()=>exportCsv(filteredOrders.map(o=>({folio:o.id,fecha:o.created,sucursal:o.branch,empleados:new Set(o.items.map(i=>i.employeeId)).size,articulos:allItems(o),estado:o.status,total:totalCost(o)})),'control-pro-pedidos.csv')}><Download size={15}/> Exportar</button></div><OrdersTable orders={filteredOrders} data={data} onOpen={o=>open('order-detail',o.id)}/></div>}
  {page==='approvals'&&<div className="panel"><div className="panel-header"><div><h2>Bandeja de aprobación</h2><p>Revisa la solicitud antes de autorizar inventario.</p></div><span className="count-badge">{data.orders.filter(o=>o.status==='En revisión').length} pendientes</span></div><OrdersTable orders={data.orders.filter(o=>o.status==='En revisión').filter(o=>`${o.id} ${o.branch}`.toLowerCase().includes(search.toLowerCase()))} data={data} onOpen={o=>open('order-detail',o.id)} approval onApprove={approve} onReject={o=>open('reject-order',o.id)}/></div>}
  {page==='employees'&&<div className="panel"><div className="toolbar"><div className="filter-pills"><button className={filter==='Todos'?'selected':''} onClick={()=>setFilter('Todos')}>Todos</button><button className={filter==='Toluca'?'selected':''} onClick={()=>setFilter('Toluca')}>Toluca</button><button className={filter==='Querétaro'?'selected':''} onClick={()=>setFilter('Querétaro')}>Querétaro</button><button className={filter==='Puebla'?'selected':''} onClick={()=>setFilter('Puebla')}>Puebla</button></div><button className="btn secondary" onClick={()=>exportCsv(employees.map(e=>({numero:e.number,nombre:e.name,sucursal:e.branch,puesto:e.job,estado:e.active?'Activo':'Inactivo',alta:e.joined})),'control-pro-empleados.csv')}><Download size={15}/> Exportar CSV</button></div><table><thead><tr><th>EMPLEADO</th><th>NÚMERO</th><th>SUCURSAL</th><th>PUESTO</th><th>ESTADO</th><th>ALTA</th><th></th></tr></thead><tbody>{employees.filter(e=>filter==='Todos'||e.branch===filter).map(e=><tr key={e.id}><td><div className="person-cell"><div className="avatar small">{e.name.split(' ').map(x=>x[0]).slice(0,2).join('')}</div><div><b>{e.name}</b><small>{e.id}</small></div></div></td><td>{e.number}</td><td>{e.branch}</td><td>{e.job}</td><td><Status value={e.active?'Activo':'Inactivo'}/></td><td>{e.joined}</td><td><button className="row-action" onClick={()=>open('employee-detail',e.id)}><Eye size={16}/></button></td></tr>)}</tbody></table><div className="table-footer">Mostrando {employees.filter(e=>filter==='Todos'||e.branch===filter).length} empleados <span>• Datos de demostración</span></div></div>}
  {page==='catalog'&&<div className="panel"><div className="toolbar"><div className="filter-pills">{['Todos','Batas','Prendas','Protección','Calzado','Accesorios'].map(s=><button className={filter===s?'selected':''} key={s} onClick={()=>setFilter(s)}>{s}</button>)}</div><button className="btn secondary" onClick={()=>exportCsv(data.products.map(p=>({sku:p.sku,producto:p.name,categoria:p.category,tallas:p.sizes.join('/'),precio:p.price,puestos:p.jobs.join('; '),estado:p.active?'Activo':'Inactivo'})),'control-pro-catalogo.csv')}><Download size={15}/> Exportar</button></div><div className="product-grid">{data.products.filter(p=>(filter==='Todos'||p.category===filter)&&`${p.name} ${p.sku} ${p.category}`.toLowerCase().includes(search.toLowerCase())).map(p=><div className="product-card" key={p.id}><div className="product-visual"><Shirt size={30}/><span>{p.category}</span></div><div className="product-card-body"><div className="product-sku">{p.sku}</div><h3>{p.name}</h3><div className="product-price">{money(p.price)} <small>precio de referencia</small></div><div className="size-row">{p.sizes.slice(0,6).map(s=><span key={s}>{s}</span>)}</div><div className="job-tags">{p.jobs.slice(0,3).map(j=><span key={j}>{j}</span>)}</div><button className="btn secondary full" onClick={()=>open('product-detail',p.id)}>Ver producto <ArrowRight size={14}/></button></div></div>)}</div><div className="disclaimer">Los precios y reglas por puesto son datos ficticios de demostración; deben validarse con la empresa.</div></div>}
  {page==='branches'&&<div className="branch-grid">{['Toluca','Querétaro','Puebla'].map((b,i)=><div className="panel branch-card" key={b}><div className="branch-top"><div className="branch-icon"><Building2 size={21}/></div><Status value="Operativa"/></div><h2>Sucursal {b}</h2><p>{['Av. Independencia 120, Centro','Blvd. Bernardo Quintana 400','Av. Juárez 85, Centro'][i]}</p><div className="branch-metrics"><div><b>{data.employees.filter(e=>e.branch===b).length}</b><span>Empleados</span></div><div><b>{data.orders.filter(o=>o.branch===b&&!['Completado','Rechazado'].includes(o.status)).length}</b><span>Pedidos activos</span></div></div><button className="btn secondary full" onClick={()=>{setFilter(b);go('employees');setFilter(b)}}>Ver empleados <ArrowRight size={15}/></button></div>)}</div>}
  {page==='inventory'&&<div className="panel"><div className="panel-header"><div><h2>Órdenes de inventario</h2><p>Se generan al aprobar un pedido. No se duplican.</p></div><span className="count-badge">{data.inventory.length} órdenes</span></div><table><thead><tr><th>FOLIO</th><th>PEDIDO ORIGEN</th><th>SUCURSAL</th><th>FECHA</th><th>ARTÍCULOS</th><th>ESTADO</th><th>ACCIONES</th></tr></thead><tbody>{data.inventory.filter(i=>`${i.id} ${i.orderId} ${i.branch} ${i.status}`.toLowerCase().includes(search.toLowerCase())).map(i=>{const o=data.orders.find(x=>x.id===i.orderId);return <tr key={i.id}><td><b>{i.id}</b></td><td>{i.orderId}</td><td>{i.branch}</td><td>{i.created}</td><td>{o?allItems(o):0}</td><td><Status value={i.status}/></td><td><button className="btn tiny secondary" onClick={()=>open('inventory-detail',i.id)}>Detalle</button>{i.status!=='Liberada para preparación'&&<button className="btn tiny primary" onClick={()=>{update(d=>{const inv=d.inventory.find(x=>x.id===i.id)!;inv.status='Liberada para preparación';d.audit.unshift({id:id('AUD'),date:now(),user:role,action:'Orden liberada',detail:i.id});return d});setToast('Orden liberada para preparación.')}}>Liberar</button>}</td></tr>})}</tbody></table>{data.inventory.length===0&&<Empty title="Sin órdenes de inventario" text="Aprueba un pedido para generar la primera orden."/>}</div>}
  {page==='packages'&&<div className="panel"><div className="panel-header"><div><h2>Preparación y paquetes</h2><p>Asigna los kits de una orden a paquetes de envío.</p></div><button className="btn primary" onClick={()=>open('new-package')}><Plus size={15}/> Crear paquete</button></div><table><thead><tr><th>PAQUETE</th><th>PEDIDO</th><th>EMPLEADOS / KITS</th><th>GUÍA</th><th>ESTADO</th><th>ACCIONES</th></tr></thead><tbody>{data.packages.filter(p=>`${p.id} ${p.orderId} ${p.status} ${p.guide||''}`.toLowerCase().includes(search.toLowerCase())).map(p=><tr key={p.id}><td><b>{p.id}</b></td><td>{p.orderId}</td><td>{p.employeeIds.length}</td><td>{p.guide||'—'}</td><td><Status value={p.status}/></td><td><button className="btn tiny secondary" onClick={()=>open('package-detail',p.id)}>Ver contenido</button>{p.status==='Preparado'&&<button className="btn tiny primary" onClick={()=>open('new-guide',p.id)}>Registrar guía</button>}</td></tr>)}</tbody></table>{data.packages.length===0&&<Empty title="Aún no hay paquetes" text="Crea un paquete para una orden autorizada."/>}</div>}
  {page==='shipments'&&<div className="panel"><div className="panel-header"><div><h2>Envíos y guías</h2><p>Seguimiento de transporte con eventos simulados.</p></div><span className="demo-chip"><Activity size={14}/> Seguimiento simulado</span></div><table><thead><tr><th>PAQUETE</th><th>SUCURSAL</th><th>TRANSPORTISTA</th><th>GUÍA</th><th>ÚLTIMO EVENTO</th><th>ESTADO</th><th></th></tr></thead><tbody>{data.packages.filter(p=>p.guide&&`${p.id} ${p.guide} ${p.status}`.toLowerCase().includes(search.toLowerCase())).map(p=><tr key={p.id}><td><b>{p.id}</b><small className="cell-sub">{p.orderId}</small></td><td>{data.orders.find(o=>o.id===p.orderId)?.branch||'—'}</td><td>{p.carrier||'—'}</td><td>{p.guide}</td><td>{p.tracking[p.tracking.length-1]||'—'}</td><td><Status value={p.status}/></td><td><button className="btn tiny secondary" onClick={()=>open('tracking-detail',p.id)}>Seguimiento</button>{p.status!=='Entregado por transportista'&&<button className="btn tiny primary" onClick={()=>simulateTracking(p.id)}>Siguiente evento</button>}</td></tr>)}</tbody></table>{data.packages.every(p=>!p.guide)&&<Empty title="Sin guías registradas" text="Registra una guía para un paquete preparado."/>}</div>}
  {page==='receiving'&&<div className="panel"><div className="panel-header"><div><h2>Recepción en sucursal</h2><p>La entrega del transportista no confirma la recepción física.</p></div></div><table><thead><tr><th>PAQUETE</th><th>PEDIDO</th><th>SUCURSAL</th><th>KITS ESPERADOS</th><th>ESTADO DE RECEPCIÓN</th><th>ACCIÓN</th></tr></thead><tbody>{data.packages.filter(p=>`${p.id} ${p.orderId} ${p.status}`.toLowerCase().includes(search.toLowerCase())).map(p=><tr key={p.id}><td><b>{p.id}</b></td><td>{p.orderId}</td><td>{data.orders.find(o=>o.id===p.orderId)?.branch||'—'}</td><td>{p.employeeIds.length}</td><td><Status value={p.received?p.status:'Pendiente de recepción'}/></td><td>{!p.received?<button className="btn tiny primary" onClick={()=>open('receive-package',p.id)}>Verificar recepción</button>:<button className="btn tiny secondary" onClick={()=>open('package-detail',p.id)}>Ver detalle</button>}</td></tr>)}</tbody></table>{data.packages.length===0&&<Empty title="No hay paquetes por recibir" text="Los paquetes preparados aparecerán aquí."/>}</div>}
  {page==='deliveries'&&<div className="panel"><div className="panel-header"><div><h2>Entregas individuales</h2><p>Cada empleado requiere su propia confirmación de entrega.</p></div><span className="count-badge">{data.deliveries.filter(d=>d.status!=='Entregado').length} pendientes</span></div><table><thead><tr><th>EMPLEADO</th><th>PEDIDO</th><th>PAQUETE</th><th>ARTÍCULOS</th><th>ESTADO</th><th>CONFORMIDAD</th><th></th></tr></thead><tbody>{data.deliveries.filter(d=>{const e=data.employees.find(x=>x.id===d.employeeId);return `${e?.name} ${d.orderId} ${d.status}`.toLowerCase().includes(search.toLowerCase())}).map(d=>{const e=data.employees.find(x=>x.id===d.employeeId);const o=data.orders.find(x=>x.id===d.orderId);return <tr key={d.id}><td><div className="person-cell"><div className="avatar small">{e?.name.split(' ').map(x=>x[0]).slice(0,2).join('')}</div><div><b>{e?.name||d.employeeId}</b><small>{e?.job}</small></div></div></td><td>{d.orderId}</td><td>{d.packageId}</td><td>{o?.items.filter(i=>i.employeeId===d.employeeId).length||0}</td><td><Status value={d.status}/></td><td>{d.signature?<span className="signed"><CheckCircle2 size={14}/> Firma registrada</span>:'—'}</td><td>{d.status!=='Entregado'&&<button className="btn tiny primary" onClick={()=>open('deliver',d.id)}>Entregar kit</button>}</td></tr>})}</tbody></table>{data.deliveries.length===0&&<Empty title="No hay entregas habilitadas" text="Confirma primero la recepción de un paquete."/>}</div>}
  {page==='conformities'&&<div className="panel"><div className="panel-header"><div><h2>Conformidades</h2><p>Registro de entregas, firmas y observaciones de recepción.</p></div><button className="btn secondary" onClick={()=>exportCsv(data.deliveries.map(d=>({entrega:d.id,empleado:data.employees.find(e=>e.id===d.employeeId)?.name,pedido:d.orderId,paquete:d.packageId,estado:d.status,fecha:d.signedAt||'',calificacion:d.rating||'',observaciones:d.note||''})),'control-pro-conformidades.csv')}><Download size={15}/> Exportar</button></div><table><thead><tr><th>EMPLEADO</th><th>PEDIDO</th><th>ESTADO</th><th>FECHA</th><th>VALORACIÓN</th><th>OBSERVACIONES</th></tr></thead><tbody>{data.deliveries.filter(d=>d.status==='Entregado').map(d=><tr key={d.id}><td>{data.employees.find(e=>e.id===d.employeeId)?.name}</td><td>{d.orderId}</td><td><Status value={d.status}/></td><td>{d.signedAt||'—'}</td><td>{d.rating?`${d.rating}/5`:'—'}</td><td>{d.note||'—'}</td></tr>)}</tbody></table>{data.deliveries.filter(d=>d.status==='Entregado').length===0&&<Empty title="Aún no hay conformidades" text="Las entregas firmadas aparecerán en este apartado."/>}</div>}
  {page==='incidents'&&<div className="panel"><div className="panel-header"><div><h2>Centro de incidencias</h2><p>Registra y da seguimiento a diferencias de artículos o paquetes.</p></div><button className="btn primary" onClick={()=>open('new-incident')}><Plus size={15}/> Nueva incidencia</button></div><table><thead><tr><th>FOLIO</th><th>TIPO</th><th>PEDIDO / EMPLEADO</th><th>PRIORIDAD</th><th>FECHA</th><th>ESTADO</th><th>ACCIÓN</th></tr></thead><tbody>{data.incidents.filter(i=>`${i.id} ${i.type} ${i.orderId} ${i.status}`.toLowerCase().includes(search.toLowerCase())).map(i=><tr key={i.id}><td><b>{i.id}</b></td><td>{i.type}<small className="cell-sub">{i.description}</small></td><td>{i.orderId}<small className="cell-sub">{data.employees.find(e=>e.id===i.employeeId)?.name||'Paquete'}</small></td><td><Status value={i.priority}/></td><td>{i.created}</td><td><Status value={i.status}/></td><td><button className="btn tiny secondary" onClick={()=>open('incident-detail',i.id)}>Gestionar</button></td></tr>)}</tbody></table>{data.incidents.length===0&&<Empty title="Sin incidencias" text="Cuando se detecte una diferencia, regístrala aquí."/>}</div>}
  {page==='reports'&&<Reports data={data} exportCsv={exportCsv}/>}
  {page==='notifications'&&<div className="panel"><div className="panel-header"><div><h2>Centro de notificaciones</h2><p>Alertas operativas de la demostración.</p></div><button className="btn secondary" onClick={()=>update(d=>{d.notifications.forEach(n=>n.read=true);return d})}>Marcar todas como leídas</button></div><div className="notification-list">{data.notifications.filter(n=>`${n.text} ${n.date}`.toLowerCase().includes(search.toLowerCase())).map(n=><div className={`notification-row ${n.read?'read':''}`} key={n.id}><div className="notification-icon"><Bell size={17}/></div><div className="notification-copy"><b>{n.text}</b><small>{n.date}</small></div>{!n.read&&<span className="unread-label">Nueva</span>}<button className="row-action" onClick={()=>update(d=>{const item=d.notifications.find(x=>x.id===n.id);if(item)item.read=true;return d})} title="Marcar como leída"><Check size={16}/></button></div>)}</div></div>}
  {page==='users'&&<div className="panel"><div className="panel-header"><div><h2>Usuarios y permisos de demostración</h2><p>Cambia el rol desde el selector superior para probar las vistas.</p></div><ShieldCheck size={22} className="muted"/></div><div className="role-cards">{roles.map((r,i)=><div className={`role-card ${r===role?'current':''}`} key={r}><div className="role-card-icon"><ShieldCheck size={19}/></div><b>{r}</b><p>{['Acceso completo a módulos y configuración.','Gestiona empleados, pedidos y recepción de su sucursal.','Revisa, aprueba, devuelve o rechaza pedidos.','Administra órdenes, preparación, paquetes y guías.','Consulta reportes, estados e historial de auditoría.'][i]}</p><button className={`btn ${r===role?'primary':'secondary'} full`} onClick={()=>setRole(r)}>{r===role?'Rol activo':'Cambiar a este rol'}</button></div>)}</div><div className="warning-note"><AlertTriangle size={17}/><p>La restricción visual por rol es solo demostrativa. En producción, los permisos deben validarse también en el backend y la API.</p></div></div>}
  {page==='settings'&&<div className="settings-grid"><div className="panel"><div className="panel-header"><div><h2>Reglas por puesto</h2><p>Productos autorizados para la solicitud normal.</p></div></div>{['Enfermería','Administración','Mantenimiento','Seguridad','Intendencia','Almacén'].map(job=><div className="rule-row" key={job}><div><b>{job}</b><small>{data.products.filter(p=>p.jobs.includes(job)).map(p=>p.name).join(', ')||'Sin productos asignados'}</small></div><span className="rule-count">{data.products.filter(p=>p.jobs.includes(job)).length} productos</span></div>)}<div className="disclaimer">Para editar las reglas globales, modifica los puestos autorizados de cada producto en el catálogo.</div></div><div className="panel"><div className="panel-header"><div><h2>Datos de demostración</h2><p>Preferencias y mantenimiento local.</p></div><Settings size={19} className="muted"/></div><div className="setting-action"><div><b>Restablecer los datos</b><p>Elimina los cambios de este navegador y recupera los datos de ejemplo.</p></div><button className="btn danger" onClick={reset}><RotateCcw size={15}/> Restablecer</button></div><div className="setting-action"><div><b>Exportar auditoría</b><p>Descarga el historial de acciones registrado en esta sesión.</p></div><button className="btn secondary" onClick={()=>exportCsv(data.audit.map(a=>({...a})),'control-pro-auditoria.csv')}><Download size={15}/> Exportar CSV</button></div><div className="setting-action"><div><b>Almacenamiento</b><p>Los cambios se guardan localmente mediante localStorage.</p></div><span className="demo-chip">Local</span></div></div></div>}
  {page==='demo'&&<DemoPage data={data} go={go} onReset={reset}/>}
  </div><footer className="footer"><span>© 2026 Control Pro</span><span><span className="footer-dot"/> Prototipo funcional · Datos simulados</span><span>Versión 1.0.0</span></footer></main>
  {modal&&<Modal title={modalTitle(modal,selected,data)} onClose={()=>setModal('')}><ModalContent modal={modal} selected={selected} data={data} role={role} onClose={()=>setModal('')} onToast={setToast} onUpdate={update} onApprove={approve} onSubmitOrder={submitOrder} onAddEmployee={addEmployee} onAddProduct={addProduct} onRegisterGuide={registerGuide} onConfirmReceive={confirmReceive} onIncidentChange={changeIncident} onOpen={open} onLog={log} /></Modal>}
  {toast&&<div className="toast"><CheckCircle2 size={18}/><span>{toast}</span><button onClick={()=>setToast('')}><X size={15}/></button></div>}
 </div>
}

function pageTitle(p:string){return ({dashboard:'Dashboard',activity:'Actividad reciente',orders:'Pedidos',catalog:'Catálogo y kits',employees:'Empleados',branches:'Sucursales',approvals:'Aprobaciones',inventory:'Órdenes de inventario',packages:'Preparación y paquetes',shipments:'Envíos y guías',receiving:'Recepción en sucursal',deliveries:'Entregas individuales',incidents:'Incidencias',conformities:'Conformidades',reports:'Reportes',notifications:'Notificaciones',users:'Usuarios y permisos',settings:'Configuración',demo:'Modo demostración'} as Record<string,string>)[p]||'Control Pro'}
function pageSubtitle(p:string){return ({dashboard:'Vista general de pedidos, inventario y entregas.',activity:'Consulta quién hizo qué y cuándo dentro de la operación.',orders:'Administra solicitudes consolidadas por sucursal y empleado.',catalog:'Productos, tallas, precios de referencia y elegibilidad por puesto.',employees:'Directorio centralizado de empleados y sus sucursales.',branches:'Consulta el estado operativo de cada ubicación.',approvals:'Revisa las solicitudes antes de autorizar la preparación.',inventory:'Órdenes generadas a partir de pedidos aprobados.',packages:'Agrupa kits por empleado y prepara los paquetes para envío.',shipments:'Guías y cronología de transporte. No hay conexión real con paqueterías.',receiving:'Verifica físicamente los paquetes recibidos en cada sucursal.',deliveries:'Entrega cada kit a su destinatario y registra conformidad individual.',incidents:'Documenta faltantes, daños, tallas incorrectas y resolución.',conformities:'Consulta evidencia de las entregas individuales finalizadas.',reports:'Indicadores operativos y exportaciones de datos.',notifications:'Avisos generados por los eventos de la operación.',users:'Perfiles de demostración y alcance visual de permisos.',settings:'Reglas configurables y herramientas del prototipo.',demo:'Recorre las etapas clave sin saltarte aprobaciones ni confirmaciones.'} as Record<string,string>)[p]||''}
function Status({value}:{value:string}){return <span className={`status status-${statusClass(value)}`}><i/>{value}</span>}
function OrdersTable({orders,data,onOpen,approval=false,onApprove,onReject}:{orders:Order[];data:AppData;onOpen:(o:Order)=>void;approval?:boolean;onApprove?:(o:Order)=>void;onReject?:(o:Order)=>void}){return <table><thead><tr><th>FOLIO</th><th>FECHA</th><th>SUCURSAL</th><th>EMPLEADOS</th><th>ARTÍCULOS</th><th>IMPORTE REF.</th><th>ESTADO</th><th>ACCIONES</th></tr></thead><tbody>{orders.map(o=>{const count=new Set(o.items.map(i=>i.employeeId)).size;const total=o.items.reduce((n,i)=>n+(data.products.find(p=>p.id===i.productId)?.price||0)*i.qty,0);return <tr key={o.id}><td><b>{o.id}</b></td><td>{o.created}</td><td>{o.branch}</td><td>{count}</td><td>{o.items.reduce((n,i)=>n+i.qty,0)}</td><td>{money(total)}</td><td><Status value={o.status}/></td><td><div className="row-actions"><button className="row-action" title="Ver detalle" onClick={()=>onOpen(o)}><Eye size={16}/></button>{approval&&<><button className="row-action good" title="Aprobar" onClick={()=>onApprove?.(o)}><Check size={16}/></button><button className="row-action bad" title="Rechazar" onClick={()=>onReject?.(o)}><X size={16}/></button></>}</div></td></tr>})}</tbody></table>}
function AuditList({events}:{events:AppData['audit']}){return <div className="audit-list">{events.map(e=><div className="audit-row" key={e.id}><div className="audit-symbol"><Activity size={15}/></div><div className="audit-copy"><b>{e.action}</b><p>{e.detail}</p><small>{e.user} · {e.date}</small></div></div>)}{events.length===0&&<Empty title="Sin actividad" text="Los eventos aparecerán aquí conforme uses el sistema."/>}</div>}
function Empty({title,text}:{title:string;text:string}){return <div className="empty-state"><div><ClipboardList size={24}/></div><b>{title}</b><p>{text}</p></div>}
function Modal({title,onClose,children}:{title:string;onClose:()=>void;children:React.ReactNode}){return <div className="modal-backdrop" onMouseDown={e=>{if(e.target===e.currentTarget)onClose()}}><div className="modal"><div className="modal-header"><div><h2>{title}</h2><p>Control Pro · Entorno de demostración</p></div><button className="icon-button" onClick={onClose}><X size={18}/></button></div><div className="modal-content">{children}</div></div></div>}
