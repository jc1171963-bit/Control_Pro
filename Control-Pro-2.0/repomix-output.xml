else if(page==='Recepción en sucursal'){v=table(['PAQUETE','PEDIDO','KITS','ESTADO DE RECEPCIÓN','ACCIÓN'],data.packages.map(p=>`<tr><td>${p.id}</td><td>${p.orderId}</td><td>${p.employeeIds.length}</td><td>${status(p.received?p.status:'Pendiente de recepción')}</td><td>${!p.received?`<button class="btn primary" onclick="openModal('receive','${p.id}')">Verificar recepción</button>`:'Confirmada'}</td></tr>`).join(''))}
