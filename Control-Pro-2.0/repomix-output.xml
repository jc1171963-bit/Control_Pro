import { useEffect, useMemo, useRef, useState } from 'react';
import { Activity, AlertTriangle, Archive, ArrowDownToLine, ArrowRight, Bell, Box, Building2, Check, CheckCircle2, ChevronDown, ClipboardCheck, ClipboardList, Clock3, Download, FileBarChart, FileCheck2, FileText, Fingerprint, LayoutDashboard, LifeBuoy, ListChecks, LogOut, Menu, Package, PackageCheck, Plus, Search, Settings, ShieldCheck, Shirt, Truck, Users, X, RotateCcw, Eye, CircleCheck, CircleAlert, CircleDollarSign } from 'lucide-react';
import type { AppData, Role, Order, Employee, Product, OrderItem } from './types';
import { initialData } from './data/seed';

const roles:Role[]=['Administrador','Representante de sucursal','Gerente de ventas','Responsable de inventario','Supervisor / auditor'];
const navGroups=[
 {label:'GENERAL',items:[['Dashboard','dashboard',LayoutDashboard],['Actividad reciente','activity',Activity]]},
 {label:'OPERACIÓN COMERCIAL',items:[['Pedidos','orders',ClipboardList],['Catálogo y kits','catalog',Shirt],['Empleados','employees',Users],['Sucursales','branches',Building2],['Aprobaciones','approvals',ClipboardCheck]]},
 {label:'INVENTARIO Y LOGÍSTICA',items:[['Órdenes de inventario','inventory',Archive],['Preparación y paquetes','packages',Package],['Envíos y guías','shipments',Truck],['Recepción en sucursal','receiving',PackageCheck]]},
 {label:'ENTREGAS',items:[['Entregas individuales','deliveries',FileCheck2],['Incidencias','incidents',AlertTriangle],['Conformidades','conformities',Fingerprint]]},
 {label:'ADMINISTRACIÓN',items:[['Reportes','reports',FileBarChart],['Notificaciones','notifications',Bell],['Usuarios y permisos','users',ShieldCheck],['Configuración','settings',Settings]]}
] as const;
const statusClass=(s:string)=>s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replaceAll(' ','-');
const money=(n:number)=>new Intl.NumberFormat('es-MX',{style:'currency',currency:'MXN',maximumFractionDigits:0}).format(n);
const now=()=>new Date().toLocaleString('es-MX',{dateStyle:'short',timeStyle:'short'});
const today=()=>new Date().toLocaleDateString('es-MX');
const id=(prefix:string)=>`${prefix}-${Date.now().toString().slice(-6)}`;

export default function App(){
 const [data,setData]=useState<AppData>(()=>{try{const saved=localStorage.getItem('control-pro-data');return saved?JSON.parse(saved):initialData}catch{return initialData}});
 const [page,setPage]=useState('dashboard'); const [role,setRole]=useState<Role>('Administrador'); const [search,setSearch]=useState(''); const [toast,setToast]=useState(''); const [modal,setModal]=useState(''); const [selected,setSelected]=useState(''); const [mobileNav,setMobileNav]=useState(false); const [filter,setFilter]=useState('Todos');
 useEffect(()=>{localStorage.setItem('control-pro-data',JSON.stringify(data))},[data]);
 useEffect(()=>{if(toast){const t=setTimeout(()=>setToast(''),3200);return()=>clearTimeout(t)}},[toast]);
 const update=(fn:(d:AppData)=>AppData)=>setData(prev=>fn(structuredClone(prev)));
 const log=(action:string,detail:string)=>update(d=>{d.audit.unshift({id:id('AUD'),date:now(),user:role,action,detail});return d});
 const notify=(text:string)=>update(d=>{d.notifications.unshift({id:id('NOT'),text,read:false,date:today()});return d});
 const employees=data.employees.filter(e=>`${e.name} ${e.number} ${e.branch} ${e.job}`.toLowerCase().includes(search.toLowerCase()));
 const orders=data.orders.filter(o=>`${o.id} ${o.branch} ${o.status}`.toLowerCase().includes(search.toLowerCase()));
 const unread=data.notifications.filter(n=>!n.read).length;
 const can=(allowed:Role[])=>allowed.includes(role)||role==='Administrador';
 const open=(m:string,which='')=>{setModal(m);setSelected(which)};
 const go=(p:string)=>{setPage(p);setSearch('');setMobileNav(false);setFilter('Todos')};
 const reset=()=>{if(confirm('¿Restablecer toda la demostración? Se perderán los cambios locales.')){setData(structuredClone(initialData));setPage('dashboard');setModal('');setToast('Datos de demostración restaurados.')}};
 const approve=(order:Order)=>{if(order.status==='Aprobado'||order.inventoryId){setToast('Este pedido ya tiene una orden de inventario.');return}const inv=id('INV-2026');update(d=>{const o=d.orders.find(x=>x.id===order.id)!;o.status='Aprobado';o.reviewer=role;o.inventoryId=inv;d.inventory.unshift({id:inv,orderId:o.id,branch:o.branch,status:'Pendiente de revisión',created:today()});d.audit.unshift({id:id('AUD'),date:now(),user:role,action:'Pedido aprobado',detail:`${o.id} · orden ${inv} generada`});d.notifications.unshift({id:id('NOT'),text:`Pedido ${o.id} aprobado. Orden ${inv} generada.`,read:false,date:today()});return d});setModal('');setToast(`Pedido aprobado. Se generó ${inv}.`)};
 const submitOrder=(form:HTMLFormElement)=>{const fd=new FormData(form);const branch=String(fd.get('branch')||'Toluca');const employeeId=String(fd.get('employee')||'');const productId=String(fd.get('product')||'');const size=String(fd.get('size')||'M');const qty=Number(fd.get('qty')||1);const product=data.products.find(p=>p.id===productId);if(!employeeId||!product){setToast('Selecciona empleado y producto.');return}const employee=data.employees.find(e=>e.id===employeeId);if(!employee){setToast('Empleado no encontrado.');return}if(!product.jobs.includes(employee.job)&&!String(fd.get('exception')||'').trim()){setToast(`El producto no está autorizado para ${employee.job}. Solicita una excepción con justificación.`);return}const orderId=id('PED-2026');const item:OrderItem={employeeId,productId,size,qty,...(!product.jobs.includes(employee.job)?{exception:String(fd.get('exception'))}:{})};update(d=>{d.orders.unshift({id:orderId,branch,created:today(),status:'En revisión',items:[item],note:String(fd.get('note')||'')});d.audit.unshift({id:id('AUD'),date:now(),user:role,action:'Pedido enviado',detail:orderId});d.notifications.unshift({id:id('NOT'),text:`Nuevo pedido ${orderId} pendiente de aprobación.`,read:false,date:today()});return d});setModal('');setToast(`Pedido ${orderId} creado y enviado a revisión.`)};
 const addEmployee=(form:HTMLFormElement)=>{const f=new FormData(form);const e:Employee={id:id('EMP'),number:String(f.get('number')||''),name:String(f.get('name')||''),branch:String(f.get('branch')||'Toluca'),job:String(f.get('job')||'Administración'),active:true,joined:today()};if(!e.number||!e.name){setToast('Completa nombre y número de empleado.');return}if(data.employees.some(x=>x.number===e.number)){setToast('Ese número de empleado ya existe.');return}update(d=>{d.employees.push(e);d.audit.unshift({id:id('AUD'),date:now(),user:role,action:'Empleado creado',detail:e.name});return d});setModal('');setToast('Empleado agregado correctamente.')};
 const addProduct=(form:HTMLFormElement)=>{const f=new FormData(form);const p:Product={id:id('PR'),sku:String(f.get('sku')||''),name:String(f.get('name')||''),category:String(f.get('category')||'Prendas'),sizes:String(f.get('sizes')||'S,M,L,XL').split(',').map(s=>s.trim()).filter(Boolean),price:Number(f.get('price')||0),active:true,jobs:String(f.get('jobs')||'Administración').split(',').map(s=>s.trim()).filter(Boolean)};if(!p.sku||!p.name){setToast('Completa SKU y nombre del producto.');return}update(d=>{d.products.unshift(p);d.audit.unshift({id:id('AUD'),date:now(),user:role,action:'Producto creado',detail:p.name});return d});setModal('');setToast('Producto agregado al catálogo.')};
 const filteredOrders=orders.filter(o=>filter==='Todos'||o.status===filter);
 const allItems=(o:Order)=>o.items.reduce((n,i)=>n+i.qty,0);
 const totalCost=(o:Order)=>o.items.reduce((n,i)=>n+(data.products.find(p=>p.id===i.productId)?.price||0)*i.qty,0);
 const makePackage=(orderId:string)=>{const order=data.orders.find(o=>o.id===orderId);if(!order){setToast('Pedido no encontrado.');return}const people:string[]=[...new Set<string>(order.items.map(i=>i.employeeId))];update(d=>{const pid=id('PAQ-2026');d.packages.unshift({id:pid,orderId,employeeIds:people,status:'Preparado',tracking:['Paquete preparado · '+today()],received:false});const inv=d.inventory.find(i=>i.orderId===orderId);if(inv)inv.status='En preparación';const o=d.orders.find(x=>x.id===orderId);if(o)o.status='En preparación';d.audit.unshift({id:id('AUD'),date:now(),user:role,action:'Paquete preparado',detail:`${pid} · ${orderId}`});return d});setToast('Paquete creado y kits asignados.');};
 const registerGuide=(form:HTMLFormElement)=>{const f=new FormData(form);const pkg=data.packages.find(p=>p.id===String(f.get('package')));if(!pkg){setToast('Selecciona un paquete.');return}update(d=>{const p=d.packages.find(x=>x.id===pkg.id)!;p.carrier=String(f.get('carrier')||'Transportes Castores');p.guide=String(f.get('guide')||'');p.status='En tránsito';p.tracking.push(`Guía registrada · ${today()}`);d.audit.unshift({id:id('AUD'),date:now(),user:role,action:'Guía registrada',detail:`${p.id} · ${p.guide}`});d.notifications.unshift({id:id('NOT'),text:`Guía registrada para ${p.id}.`,read:false,date:today()});return d});setModal('');setToast('Guía registrada. El seguimiento es simulado.')};
 const simulateTracking=(pkgId:string)=>{const stages=['En tránsito','Llegada a centro de distribución','En reparto','Entregado por transportista'];update(d=>{const p=d.packages.find(x=>x.id===pkgId)!;const next=stages.find(s=>!p.tracking.some(t=>t.startsWith(s)));if(!next){setToast('El seguimiento ya llegó al último evento.');return d}p.tracking.push(`${next} · ${today()} (simulado)`);p.status=next==='Entregado por transportista'?'Entregado por transportista':next;if(next==='Entregado por transportista')d.notifications.unshift({id:id('NOT'),text:`El transportista reportó entregado ${p.id}. Falta confirmar recepción en sucursal.`,read:false,date:today()});d.audit.unshift({id:id('AUD'),date:now(),user:role,action:'Seguimiento actualizado',detail:`${p.id} · ${next}`});return d});setToast('Evento de seguimiento actualizado. La recepción sigue pendiente.')};
 const confirmReceive=(pkgId:string,difference='')=>{update(d=>{const p=d.packages.find(x=>x.id===pkgId)!;p.received=true;p.difference=difference;p.status=difference?'Recibido con diferencias':'Recibido en sucursal';if(difference)d.incidents.unshift({id:id('INC-2026'),orderId:p.orderId,packageId:p.id,type:difference,priority:'Media',status:'Abierta',description:`Diferencia detectada al recibir ${p.id}.`,created:today()});for(const emp of p.employeeIds){if(!d.deliveries.some(x=>x.packageId===p.id&&x.employeeId===emp))d.deliveries.push({id:id('ENT'),orderId:p.orderId,packageId:p.id,employeeId:emp,status:'Pendiente'});}d.audit.unshift({id:id('AUD'),date:now(),user:role,action:'Recepción confirmada',detail:`${p.id}${difference?' · '+difference:''}`});return d});setToast(difference?'Recepción registrada con incidencia.':'Recepción confirmada. Entregas individuales habilitadas.')};
 const changeIncident=(incidentId:string,status:string,resolution='')=>{update(d=>{const x=d.incidents.find(i=>i.id===incidentId)!;x.status=status;if(resolution)x.resolution=resolution;d.audit.unshift({id:id('AUD'),date:now(),user:role,action:'Incidencia actualizada',detail:`${x.id} · ${status}`});return d});setToast('Incidencia actualizada.')};
 const exportCsv=(rows:Record<string,unknown>[],name:string)=>{if(!rows.length){setToast('No hay datos para exportar.');return}const keys=Object.keys(rows[0]);const csv=[keys.join(','),...rows.map(r=>keys.map(k=>`"${String(r[k]??'').replaceAll('"','""')}"`).join(','))].join('\r\n');const blob=new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8;'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;a.click();URL.revokeObjectURL(a.href);setToast('Archivo CSV descargado.')};
 const kpis=[{label:'Pedidos activos',value:data.orders.filter(o=>!['Completado','Rechazado'].includes(o.status)).length,icon:ClipboardList,color:'blue'},{label:'Pendientes de aprobación',value:data.orders.filter(o=>['En revisión','Pendiente de aprobación'].includes(o.status)).length,icon:Clock3,color:'amber'},{label:'Paquetes en tránsito',value:data.packages.filter(p=>p.status==='En tránsito'||p.status==='En reparto').length,icon:Truck,color:'violet'},{label:'Incidencias abiertas',value:data.incidents.filter(i=>!['Resuelta','Cerrada'].includes(i.status)).length,icon:AlertTriangle,color:'red'}];
 return <div className="app-shell">
  <aside className={`sidebar ${mobileNav?'open':''}`}><div className="brand"><div className="brand-mark"><PackageCheck size={23}/></div><div><b>Control Pro</b><small>GESTIÓN INTEGRAL</small></div><button className="mobile-close" onClick={()=>setMobileNav(false)}><X size={18}/></button></div><div className="workspace"><span className="workspace-dot"/><div><b>Operación central</b><small>Entorno de demostración</small></div><ChevronDown size={15}/></div><nav>{navGroups.map(group=><div className="nav-group" key={group.label}><div className="nav-label">{group.label}</div>{group.items.map(([label,key,Icon])=><button key={key} className={`nav-item ${page===key?'active':''}`} onClick={()=>go(key)}><Icon size={17}/><span>{label}</span>{key==='notifications'&&unread>0&&<em>{unread}</em>}</button>)}</div>)}</nav><div className="sidebar-bottom"><button className="demo-link" onClick={()=>go('demo')}><CircleCheck size={17}/><span><b>Modo demostración</b><small>Recorrer el proceso completo</small></span><ArrowRight size={15}/></button><div className="profile"><div className="avatar">{role.split(' ').map(s=>s[0]).slice(0,2).join('')}</div><div className="profile-text"><b>{role}</b><small>Usuario de prueba</small></div><button title="Restablecer demostración" onClick={reset}><RotateCcw size={16}/></button></div></div></aside>
  <main className="main-area"><header className="topbar"><button className="mobile-menu" onClick={()=>setMobileNav(true)}><Menu/></button><div className="crumb"><span>Control Pro</span><span className="slash">/</span><b>{pageTitle(page)}</b></div><div className="top-actions"><label className="searchbox"><Search size={16}/><input value={search} onChange={e=>setSearch(e.target.value)} placeholder="Buscar en este módulo…"/><kbd>⌘ K</kbd></label><button className="icon-button notification-button" onClick={()=>go('notifications')} title="Notificaciones"><Bell size={18}/>{unread>0&&<i/>}</button><div className="role-select"><span>Vista de</span><select value={role} onChange={e=>setRole(e.target.value as Role)} aria-label="Cambiar usuario de demostración">{roles.map(r=><option key={r}>{r}</option>)}</select></div></div></header>
  <div className="page-content"><div className="page-heading"><div><div className="eyebrow">PANEL DE CONTROL <span>•</span> {today()}</div><h1>{pageTitle(page)}</h1><p>{pageSubtitle(page)}</p></div><div className="heading-actions">{['orders','dashboard'].includes(page)&&<button className="btn primary" onClick={()=>open('new-order')}><Plus size={16}/> Nuevo pedido</button>}{page==='employees'&&<button className="btn primary" onClick={()=>open('new-employee')}><Plus size={16}/> Nuevo empleado</button>}{page==='catalog'&&<button className="btn primary" onClick={()=>open('new-product')}><Plus size={16}/> Nuevo producto</button>}{page==='shipments'&&<button className="btn primary" onClick={()=>open('new-guide')}><Plus size={16}/> Registrar guía</button>}</div></div>
  {page==='dashboard'&&<><div className="kpi-grid">{kpis.map(k=>{const Icon=k.icon;return <div className="kpi-card" key={k.label}><div className={`kpi-icon ${k.color}`}><Icon size={19}/></div><div className="kpi-label">{k.label}</div><div className="kpi-value">{k.value}</div><div className="kpi-foot"><span className="dot-green"/> Datos actualizados desde la operación</div></div>})}</div><div className="dashboard-grid"><section className="panel recent-panel"><div className="panel-header"><div><h2>Pedidos recientes</h2><p>Seguimiento de solicitudes por sucursal</p></div><button className="text-button" onClick={()=>go('orders')}>Ver todos <ArrowRight size={15}/></button></div><OrdersTable orders={orders.slice(0,5)} data={data} onOpen={o=>open('order-detail',o.id)} /></section><section className="panel"><div className="panel-header"><div><h2>Estado de operación</h2><p>Distribución actual de pedidos</p></div><Activity size={18} className="muted"/></div><div className="status-chart">{['En revisión','Aprobado','En preparación','En tránsito','Completado'].map((s,i)=>{const n=data.orders.filter(o=>o.status===s).length;const max=Math.max(1,...['En revisión','Aprobado','En preparación','En tránsito','Completado'].map(x=>data.orders.filter(o=>o.status===x).length));return <div className="bar-row" key={s}><div><span>{s}</span><b>{n}</b></div><div className="bar-track"><div className={`bar-fill b${i}`} style={{width:`${n/max*100}%`}}/></div></div>})}</div><div className="panel-divider"/><div className="mini-stat-row"><div><span className="mini-icon green"><CheckCircle2 size={16}/></span><span>Entregas completadas</span></div><b>{data.deliveries.filter(d=>d.status==='Entregado').length}</b></div><div className="mini-stat-row"><div><span className="mini-icon orange"><AlertTriangle size={16}/></span><span>Requieren atención</span></div><b>{data.incidents.filter(i=>!['Resuelta','Cerrada'].includes(i.status)).length}</b></div></section></div><div className="panel activity-panel"><div 