px}.btn.primary{background:var(--blue);border-color:var(--blue);color:white}.btn.danger{color:#b91c1c;border-color:#fecaca}.btn:hover{filter:brightness(.97)}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px;margin-bottom:17px}.card,.panel{background:white;border:1px solid #e6ecf3;border-radius:10px;overflow:hidden}.card{padding:17px}.card .label{font-size:11px;color:var(--muted)}.card strong{display:block;font-size:30px;color:var(--navy);margin:8px 0}.card small{font-size:10px;color:#94a3b8}.panel{margin-bottom:16px}.panelhead{display:flex;justify-content:space-between;align-items:center;padding:16px 18px;border-bottom:1px solid #edf1f6;gap:10px}.panelhead h2{font-size:14px;margin:0;color:#20344f}.panelhead p{font-size:11px;color:#94a3b8;margin:5px 0 0}.two{display:grid;grid-template-columns:1.5fr 1fr;gap:15px}table{width:100%;border-collapse:collapse;text-align:left}th{font-size:9px;letter-spacing:.5px;color:#94a3b8;background:#fbfcfe;padding:12px;border-bottom:1px solid #edf1f6;white-space:nowrap}td{font-size:11px;color:#526176;padding:13px 12px;border-bottom:1px solid #f0f3f7}td b{color:#26364d}tr:last-child td{border-bottom:0}.status{display:inline-block;font-size:9px;font-weight:700;border-radius:5px;padding:5px 7px;background:#f1f5f9;color:#64748b;white-space:nowrap}.green{background:#f0fdf4;color:#15803d}.blue{background:#eff6ff;color:#1d4ed8}.amber{background:#fffbeb;color:#a16207}.red{background:#fef2f2;color:#b91c1c}.orange{background:#fff7ed;color:#c2410c}.toolbar{padding:12px 15px;display:flex;justify-content:space-between;align-items:center;gap:10px;border-bottom:1px solid #edf1f6;flex-wrap:wrap}.toolbar input,.toolbar select{padding:8px;border:1px solid var(--line);border-radius:7px;font-size:11px}.bars{padding:18px}.bar{margin:13px 0}.bar label{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-bottom:7px}.track{height:7px;border-radius:10px;background:#edf2f7;overflow:hidden}.fill{height:100%;background:#2563eb;border-radius:10px}.activity{padding:8px 18px}.event{padding:12px 0;border-bottom:1px solid #f1f5f9}.event b{font-size:11px}.event p{font-size:11px;color:var(--muted);margin:4px 0}.event small{font-size:9px;color:#94a3b8}.actions{display:flex;gap:5px;flex-wrap:wrap}.actions button{font-size:10px;padding:6px 8px}.empty{padding:35px;text-align:center;color:#94a3b8;font-size:12px}.notice{background:#eff6ff;border:1px solid #dbeafe;color:#1e40af;border-radius:8px;padding:14px;font-size:11px;margin:15px 0;line-height:1.6}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;padding:15px}.prod{border:1px solid var(--line);border-radius:8px;padding:14px}.prod .symbol{height:80px;background:#f3f7fb;display:grid;place-items:center;font-size:30px;color:#52739a;border-radius:6px}.prod h3{font-size:13px;margin:12px 0 5px}.prod p{font-size:10px;color:#94a3b8}.prod strong{font-size:14px}.foot{padding:14px 28px;color:#94a3b8;border-top:1px solid var(--line);font-size:10px;display:flex;justify-content:space-between}.modalbg{position:fixed;inset:0;background:#0f1d32aa;display:none;align-items:center;justify-content:center;padding:20px;z-index:10}.modal{width:min(620px,100%);max-height:90vh;overflow:auto;background:white;border-radius:12px;box-shadow:0 20px 60px #0f172a40}.modalhead{display:flex;justify-content:space-between;align-items:center;padding:17px 20px;border-bottom:1px solid var(--line)}.modalhead h2{font-size:15px;margin:0}.modalbody{padding:20px}.form{display:grid;grid-template-columns:1fr 1fr;gap:13px}.form label{font-size:10px;color:#526176;display:flex;flex-direction:column;gap:6px}.form input,.form select,.form textarea{width:100%;padding:10px;border:1px solid #d5dfeb;border-radius:7px;font-size:11px;background:white}.form .wide{grid-column:1/-1}.modalactions{display:flex;justify-content:flex-end;gap:8px;margin-top:18px;padding-top:14px;border-top:1px solid #edf1f6}.toast{position:fixed;bottom:20px;right:20px;z-index:20;background:var(--navy);color:white;padding:13px 17px;border-radius:8px;font-size:12px;box-shadow:0 8px 25px #0f172a30}.signature{width:100%;height:130px;border:1px dashed #9aabc0;border-radius:8px;touch-action:none;background:repeating-linear-gradient(0deg,#fff,#fff 29px,#f1f5f9 30px)}.progress{height:7px;background:#e2e8f0;border-radius:9px;overflow:hidden;margin:8px 0 18px}.progress div{height:100%;background:#2563eb}.mobile{display:none}
@media(max-width:1000px){.side{width:210px}.main{margin-left:210px}.content{padding:20px}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.two{grid-template-columns:1fr}.cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:680px){.side{position:static;width:auto;height:auto;padding:12px}.brand{padding:0}.group{display:none}.sidefoot{display:none}.main{margin:0}.top{height:auto;position:static;padding:12px;flex-wrap:wrap}.top input{width:100%;flex:1}.content{padding:15px 10px}.heading{align-items:flex-start;flex-direction:column}.heading h1{font-size:22px}.grid{gap:8px}.card{padding:12px}.card strong{font-size:25px}.cards{grid-template-columns:1fr}.panel{overflow-x:auto}table{min-width:700px}.panelhead{min-width:480px}.form{grid-template-columns:1fr}.form .wide{grid-column:auto}.foot{padding:12px;gap:10px;flex-wrap:wrap}.modalbg{padding:8px;align-items:flex-end}.modal{max-height:94vh}.toolbar{min-width:480px}.toolbar input{width:150px}}
</style></head><body><div class="app"><aside class="side"><div class="brand"><span>◈</span><div>Control Pro<small>GESTIÓN INTEGRAL</small></div></div><div id="nav"></div><div class="sidefoot">● Entorno de demostración<br><br>Los cambios se guardan en este navegador.</div></aside><main class="main"><header class="top"><b id="crumb">Control Pro / Dashboard</b><input id="search" placeholder="Buscar en este módulo…" oninput="render()"><label style="font-size:10px;color:#94a3b8">Vista de <select id="role" onchange="render()"><option>Administrador</option><option>Representante de sucursal</option><option>Gerente de ventas</option><option>Responsable de inventario</option><option>Supervisor / auditor</option></select></label></header><section class="content"><div class="heading"><div><div class="eyebrow">PANEL DE CONTROL • <span id="date"></span></div><h1 id="title">Dashboard</h1><p id="subtitle">Vista general de pedidos, inventario y entregas.</p></div><button class="btn primary" onclick="openModal('order')">＋ Nuevo pedido</button></div><div id="view"></div></section><footer class="foot"><span>© 2026 Control Pro</span><span>● Prototipo funcional · Datos simulados</span><span>Versión 1.0.0</span></footer></main></div><div class="modalbg" id="modalbg"><div class="modal"><div class="modalhead"><h2 id="modaltitle">Control Pro</h2><button class="btn" onclick="closeModal()">✕</button></div><div class="modalbody" id="modalbody"></div></div></div><div id="toast" class="toast" style="display:none"></div>
<script>
const seed={employees:[['E-001','1001','Juan Pérez','Toluca','Administración'],['E-002','1002','Rosario Ramírez','Toluca','Enfermería'],['E-003','1003','Carlos Mendoza','Toluca','Mantenimiento'],['E-004','1004','Ana López','Toluca','Intendencia'],['E-005','1005','Luis Hernández','Toluca','Seguridad'],['E-006','1006','María Torres','Toluca','Enfermería'],['E-007','2001','Pedro García','Querétaro','Almacén'],['E-008','2002','Fernanda Ruiz','Querétaro','Administración'],['E-009','2003','Roberto Sánchez','Querétaro','Mantenimiento'],['E-010','3001','Daniela Flores','Puebla','Intendencia'],['E-011','3002','Miguel Castillo','Puebla','Seguridad'],['E-012','3003','Laura Jiménez','Puebla','Enfermería']].map(a=>({id:a[0],number:a[1],name:a[2],branch:a[3],job:a[4],active:true})),products:[['PR-01','BAT-001','Bata blanca','Batas','XS,S,M,L,XL',420,'Enfermería,Administración'],['PR-02','BAT-002','Bata de laboratorio','Batas','XS,S,M,L,XL',510,'Enfermería'],['PR-03','CAM-001','Camisa de trabajo','Prendas','S,M,L,XL,XXL',280,'Mantenimiento,Seguridad,Almacén'],['PR-04','PAN-001','Pantalón de trabajo','Prendas','S,M,L,XL,XXL',320,'Mantenimiento,Seguridad,Almacén,Intendencia'],['PR-05','POL-001','Polo corporativa','Prendas','XS,S,M,L,XL',250,'Administración,Intendencia'],['PR-06','CHA-001','Chaleco de seguridad','Protección','S,M,L,XL,XXL',390,'Seguridad,Mantenimiento'],['PR-07','BOT-001','Botas de seguridad','Calzado','22,23,24,25,26,27,28,29,30',790,'Seguridad,Mantenimiento,Almacén'],['PR-08','ZAP-001','Zapatos de enfermería','Calzado','22,23,24,25,26,27,28',640,'Enfermería'],['PR-09','GOR-001','Gorra de trabajo','Accesorios','Unitalla',120,'Mantenimiento,Seguridad,Intendencia']].map(a=>({id:a[0],sku:a[1],name:a[2],category:a[3],sizes:a[4].split(','),price:a[5],jobs:a[6].split(',')})),orders:[{id:'PED-2026-001',branch:'Toluca',date:dateNow(),status:'En revisión',items:[{employee:'E-001',product:'PR-05',size:'M',qty:2},{employee:'E-002',product:'PR-02',size:'M',qty:1},{employee:'E-003',product:'PR-03',size:'L',qty:2},{employee:'E-004',product:'PR-05',size:'S',qty:2},{employee:'E-005',product:'PR-06',size:'L',qty:1},{employee:'E-006',product:'PR-08',size:'24',qty:1}],note:'Pedido de demostración para seis empleados.'},{id:'PED-2026-002',branch:'Querétaro',date:'14/10/2026',status:'Aprobado',items:[{employee:'E-007',product:'PR-03',size:'M',qty:1}],inventoryId:'INV-2026-002'}],inventory:[{id:'INV-2026-002',orderId:'PED-2026-002',branch:'Querétaro',status:'Liberada para preparación'}],packages:[],deliveries:[],incidents:[{id:'INC-001',orderId:'PED-2026-002',type:'Talla incorrecta',description:'Validar talla de la prenda.',status:'Abierta',priority:'Media',date:'12/10/2026'}],audit:[{date:dateNow(),user:'Sistema',action:'Datos de demostración cargados',detail:'Escenario inicial'}],notifications:[{text:'El pedido PED-2026-001 está pendiente de aprobación.',read:false,date:dateNow()}]};
function dateNow(){return new Date().toLocaleDateString('es-MX')}let data;try{data=JSON.parse(localStorage.getItem('cp-demo'))||JSON.parse(JSON.stringify(seed))}catch{data=seed}let page='Dashboard',filter='Todos',selected=null;const pages={'GENERAL':['Dashboard','Actividad reciente'],'OPERACIÓN COMERCIAL':['Pedidos','Catálogo y kits','Empleados','Sucursales','Aprobaciones'],'INVENTARIO Y LOGÍSTICA':['Órdenes de inventario','Preparación y paquetes','Envíos y guías','Recepción en sucursal'],'ENTREGAS':['Entregas individuales','Incidencias','Conformidades'],'ADMINISTRACIÓN':['Reportes','Notificaciones','Usuarios y permisos','Configuración','Modo demostración']};function save(){localStorage.setItem('cp-demo',JSON.stringify(data))}function uid(p){return p+'-'+Date.now().toString().slice(-6)}function log(action,detail){data.audit.unshift({date:new Date().toLocaleString('es-MX'),user:document.getElementById('role').value,action,detail});save()}function toast(s){let el=document.getElementById('toast');el.textContent=s;el.style.display='block';setTimeout(()=>el.style.display='none',3000)}function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}function money(n){return new Intl.NumberFormat('es-MX',{style:'currency',currency:'MXN',maximumFractionDigits:0}).format(n)}function status(s){let c=/Aprobado|Completado|Entregado|Activo|Recibido|Resuelta|Liberada/.test(s)?'green':/Revisión|Pendiente|Abierta/.test(s)?'amber':/En tránsito|Preparación|En resolución/.test(s)?'blue':/Rechazado|Crítica|Alta/.test(s)?'red':'orange';return `<span class="status ${c}">${esc(s)}</span>`}function navBuild(){document.getElementById('nav').innerHTML=Object.entries(pages).map(([g,items])=>`<div class="group"><h5>${g}</h5>${items.map(i=>`<button class="nav ${page===i?'active':''}" onclick="go('${i}')">${({'Dashboard':'▦','Actividad reciente':'◷','Pedidos':'▤','Catálogo y kits':'♧','Empleados':'♙','Sucursales':'⌂','Aprobaciones':'✓','Órdenes de inventario':'▣','Preparación y paquetes':'▱','Envíos y guías':'⇢','Recepción en sucursal':'☑','Entregas individuales':'♧','Incidencias':'⚠','Conformidades':'✍','Reportes':'▥','Notificaciones':'♢','Usuarios y permisos':'♙','Configuración':'⚙','Modo demostración':'▷'})[i]} &nbsp; ${i}</button>`).join('')}</div>`).join('')}function go(p){page=p;filter='Todos';document.getElementById('search').value='';render()}function openModal(type,which){selected=which||null;let title='',body='';const empOptions=data.employees.map(e=>`<option value="${e.id}">${e.name} · ${e.job}</option>`).join('');const productOptions=data.products.map(p=>`<option value="${p.id}">${p.name} (${p.sku})</option>`).join('');const orderOptions=data.orders.map(o=>`<option value="${o.id}">${o.id} · ${o.branch} · ${o.status}</option>`).join('');const packageOptions=data.packages.filter(p=>!p.guide).map(p=>`<option value="${p.id}" ${p.id===selected?'selected':''}>${p.id} · ${p.orderId}</option>`).join('');
if(type==='order'){title='Crear pedido';body=`<form id="f" onsubmit="createOrder(event)"><div class="form"><label>Sucursal<select name="branch"><option>Toluca</option><option>Querétaro</option><option>Puebla</option></select></label><label>Empleado<select name="employee">${empOptions}</select></label><label>Producto<select name="product" id="pselect" onchange="updateSizes()">${productOptions}</select></label><label>Talla<select name="size" id="sizeselect"></select></label><label>Cantidad<input type="number" name="qty" min="1" value="1" required></label><label>Excepción / justificación<input name="exception" placeholder="Si el puesto no lo permite"></label><label class="wide">Observaciones<textarea name="note" rows="2"></textarea></label></div><p class="notice">Los productos no autorizados por puesto requieren justificación. El pedido quedará en revisión.</p><div class="modalactions"><button type="button" class="btn" onclick="closeModal()">Cancelar</button><button class="btn primary">Enviar a revisión</button></div></form>`}
else if(type==='employee'){title='Nuevo empleado';body=`<form id="f" onsubmit="createEmployee(event)"><div class="form"><label>Número<input name="number" required></label><label>Nombre completo<input name="name" required></label><label>Sucursal<select name="branch"><option>Toluca</option><option>Querétaro</option><option>Puebla</option></select></label><label>Puesto<select name="job">${['Administración','Enfermería','Mantenimiento','Seguridad','Intendencia','Almacén'].map(j=>`<option>${j}</option>`).join('')}</select></label></div><div class="modalactions"><button type="button" class="btn" onclick="closeModal()">Cancelar</button><button class="btn primary">Guardar empleado</button></div></form>`}
else if(type==='product'){title='Nuevo producto';body=`<form id="f" onsubmit="createProduct(event)"><div class="form"><label>SKU<input name="sku" required></label><label>Nombre<input name="name" required></label><label>Categoría<select name="category"><option>Batas</option><option>Prendas</option><option>Protección</option><option>Calzado</option><option>Accesorios</option></select></label><label>Precio MXN<input name="price" type="number" min="0" value="0"></label><label>Tallas separadas por coma<input name="sizes" value="S,M,L,XL"></label><label>Puestos autorizados separados por coma<input name="jobs" value="Administración"></label></div><div class="modalactions"><button type="button" class="btn" onclick="closeModal()">Cancelar</button><button class="btn primary">Agregar producto</button></div></form>`}
else if(type==='approve'){let o=data.orders.find(x=>x.id===which);title='Aprobar pedido '+which;body=`<p>¿Aprobar ${esc(which)} y generar su orden de inventario? Esta acción no se duplica.</p><div class="modalactions"><button class="btn" onclick="closeModal()">Cancelar</button><button class="btn primary" onclick="approveOrder('${which}')">Aprobar y generar orden</button></div>`}
else if(type==='reject'){title='Devolver o rechazar pedido';body=`<form onsubmit="rejectOrder(event,'${which}')"><div class="form"><label>Decisión<select name="status"><option>Devuelto para corrección</option><option>Rechazado</option></select></label><label class="wide">Motivo obligatorio<textarea name="reason" required rows="3"></textarea></label></div><div class="modalactions"><button type="button" class="btn" onclick="closeModal()">Cancelar</button><button class="btn danger">Registrar decisión</button></div></form>`}
else if(type==='package'){title='Crear paquete';body=`<form onsubmit="createPackage(event)"><label style="display:block;font-size:11px;margin:12px 0">Pedido aprobado<select name="order" style="display:block;width:100%;padding:10px;margin-top:6px;border:1px solid var(--line);border-radius:7px">${orderOptions}</select></label><div class="modalactions"><button type="button" class="btn" onclick="closeModal()">Cancelar</button><button class="btn primary">Crear paquete</button></div></form>`}
else if(type==='guide'){title='Registrar guía';body=`<form onsubmit="createGuide(event)"><div class="form"><label>Paquete<select name="package">${packageOptions}</select></label><label>Transportista<select name="carrier"><option>Transportes Castores</option><option>Estafeta (simulado)</option><option>FedEx (simulado)</option></select></label><label class="wide">Número de guía<input name="guide" required placeholder="CAST-000000"></label></div><p class="notice">Seguimiento ficticio. No hay conexión real con la paquetería.</p><div class="modalactions"><button type="button" class="btn" onclick="closeModal()">Cancelar</button><button class="btn primary">Guardar guía</button></div></form>`}
else if(type==='receive'){let p=data.packages.find(p=>p.id===which);title='Confirmar recepción';body=`<p>Paquete <b>${which}</b> · ${p?.employeeIds.length||0} kits esperados.</p><form onsubmit="receivePackage(event,'${which}')"><label style="display:block;font-size:11px">Resultado<select name="difference" style="display:block;width:100%;padding:10px;margin:8px 0;border:1px solid var(--line);border-radius:7px"><option value="">Recepción completa, sin diferencias</option><option>Paquete dañado</option><option>Faltan artículos</option><option>Sobrantes</option><option>Paquete incorrecto</option><option>Paquete no recibido</option></select></label><p class="notice">La recepción no marca automáticamente los kits como entregados a los empleados.</p><div class="modalactions"><button type="button" class="btn" onclick="closeModal()">Cancelar</button><button class="btn primary">Confirmar recepción</button></div></form>`}
else if(type==='deliver'){let d=data.deliveries.find(x=>x.id===which),e=data.employees.find(e=>e.id===d?.employee),o=data.orders.find(o=>o.id===d?.orderId);title='Entrega individual · '+(e?.name||'');body=`<p>${esc(e?.job||'')} · Pedido ${esc(d?.orderId||'')} · Paquete ${esc(d?.packageId||'')}</p><div>${(o?.items||[]).filter(i=>i.employee===d?.employee).map(i=>{let p=data.products.find(p=>p.id===i.product);return `<p style="font-size:11px">☐ ${esc(p?.name)} · Talla ${esc(i.size)} · Cantidad ${i.qty}</p>`}).join('')}</div><form onsubmit="finishDelivery(event,'${which}')"><label style="font-size:11px"><input type="checkbox" name="checked" required> Confirmo que revisé los artículos, tallas y cantidades.</label><div class="form" style="margin-top:12px"><label>Valoración<select name="rating"><option>5</option><option>4</option><option>3</option><option>2</option><option>1</option></select></label><label>Observaciones<input name="note"></label></div><label style="display:block;font-size:11px;margin-top:12px">Firma de conformidad (mouse o dedo)<canvas id="sig" class="signature" width="520" height="130"></canvas></label><button type="button" class="btn" onclick="clearSig()">Borrar firma</button><p class="notice">Firma simple para demostración, no es firma electrónica avanzada.</p><div class="modalactions"><button type="button" class="btn" onclick="closeModal()">Cancelar</button><button class="btn primary">Confirmar entrega</button></div></form>`}
else if(type==='incident'){title='Nueva incidencia';body=`<form onsubmit="createIncident(event)"><div class="form"><label>Pedido<select name="order">${orderOptions}</select></label><label>Tipo<select name="type">${['Talla incorrecta','Artículo faltante','Artículo incorrecto','Artículo dañado','Kit incompleto','Paquete no recibido','Otro'].map(s=>`<option>${s}</option>`).join('')}</select></label><label>Prioridad<select name="priority"><option>Baja</option><option selected>Media</option><option>Alta</option><option>Crítica</option></select></label><label class="wide">Descripción<textarea name="description" required></textarea></label></div><div class="modalactions"><button type="button" class="btn" onclick="closeModal()">Cancelar</button><button class="btn primary">Registrar incidencia</button></div></form>`}
else if(type==='incident-detail'){let i=data.incidents.find(i=>i.id===which);title='Gestionar '+which;body=`<p><b>${esc(i?.type)}</b> · ${esc(i?.description)}</p><form onsubmit="resolveIncident(event,'${which}')"><div class="form"><label>Estado<select name="status">${['Abierta','En revisión','En resolución','Resuelta','Cerrada'].map(s=>`<option ${s===i?.status?'selected':''}>${s}</option>`).join('')}</select></label><label class="wide">Resolución<textarea name="resolution" rows="3">${esc(i?.resolution||'')}</textarea></label></div><div class="modalactions"><button type="button" class="btn" onclick="closeModal()">Cerrar</button><button class="btn primary">Guardar resolución</button></div></form>`}
else if(type==='detail-order'){let o=data.orders.find(o=>o.id===which);title='Detalle '+which;body=`<p>${esc(o?.branch)} · ${esc(o?.date)} · ${status(o?.status||'')}</p><table><thead><tr><th>EMPLEADO</th><th>PRODUCTO</th><th>TALLA</th><th>CANT.</th></tr></thead><tbody>${(o?.items||[]).map(i=>`<tr><td>${esc(data.employees.find(e=>e.id===i.employee)?.name)}</td><td>${esc(data.products.find(p=>p.id===i.product)?.name)}</td><td>${esc(i.size)}</td><td>${i.qty}</td></tr>`).join('')}</tbody></table><p>${esc(o?.note||'')}</p>${o?.inventoryId?`<p class="notice">Orden de inventario generada: ${esc(o.inventoryId)}</p>`:''}<div class="modalactions"><button class="btn" onclick="closeModal()">Cerrar</button>${o?.status==='En revisión'?`<button class="btn primary" onclick="closeModal();openModal('approve','${which}')">Aprobar</button>`:''}</div>`}
else {title='Detalle';body='<p>Registro disponible en el módulo.</p><div class="modalactions"><button class="btn" onclick="closeModal()">Cerrar</button></div>'}document.getElementById('modaltitle').textContent=title;document.getElementById('modalbody').innerHTML=body;document.getElementById('modalbg').style.display='flex';if(type==='order')updateSizes();if(type==='deliver')setupSig()}
function closeModal(){document.getElementById('modalbg').style.display='none'}function updateSizes(){let p=data.products.find(p=>p.id===document.getElementById('pselect')?.value)||data.products[0];let s=document.getElementById('sizeselect');if(s)s.innerHTML=p.sizes.map(x=>`<option>${esc(x)}</option>`).join('')}
function createOrder(e){e.preventDefault();let f=new FormData(e.target),emp=data.employees.find(x=>x.id===f.get('employee')),p=data.products.find(x=>x.id===f.get('product')),exception=String(f.get('exception')||'');if(!p.jobs.includes(emp.job)&&!exception.trim()){toast('Producto no autorizado para '+emp.job+'. Agrega una justificación.');return}let o={id:uid('PED-2026'),branch:f.get('branch'),date:dateNow(),status:'En revisión',items:[{employee:emp.id,product:p.id,size:f.get('size'),qty:+f.get('qty'),exception:!p.jobs.includes(emp.job)?exception:''}],note:f.get('note')||''};data.orders.unshift(o);data.notifications.unshift({text:`Nuevo pedido ${o.id} pendiente de aprobación.`,read:false,date:dateNow()});log('Pedido enviado',o.id);save();closeModal();go('Pedidos');toast('Pedido creado y enviado a revisión.')}
function createEmployee(e){e.preventDefault();let f=new FormData(e.target);if(data.employees.some(x=>x.number===f.get('number'))){toast('Número de empleado duplicado.');return}data.employees.push({id:uid('E'),number:f.get('number'),name:f.get('name'),branch:f.get('branch'),job:f.get('job'),active:true});log('Empleado creado',f.get('name'));save();closeModal();render();toast('Empleado agregado.')}
function createProduct(e){e.preventDefault();let f=new FormData(e.target);data.products.unshift({id:uid('PR'),sku:f.get('sku'),name:f.get('name'),category:f.get('category'),sizes:String(f.get('sizes')).split(',').map(s=>s.trim()),price:+f.get('price'),jobs:String(f.get('jobs')).split(',').map(s=>s.trim())});log('Producto creado',f.get('name'));save();closeModal();render();toast('Producto agregado.')}
function approveOrder(oid){let o=data.orders.find(o=>o.id===oid);if(o.inventoryId){toast('Ya existe una orden para este pedido.');closeModal();return}let inv=uid('INV-2026');o.status='Aprobado';o.inventoryId=inv;data.inventory.unshift({id:inv,orderId:o.id,branch:o.branch,status:'Pendiente de revisión'});data.notifications.unshift({text:`Pedido ${o.id} aprobado. Orden ${inv} generada.`,read:false,date:dateNow()});log('Pedido aprobado',o.id+' · '+inv);save();closeModal();render();toast('Aprobado. Orden '+inv+' generada.')}
function rejectOrder(e,oid){e.preventDefault();let f=new FormData(e.target),o=data.orders.find(o=>o.id===oid);o.status=f.get('status');o.note=(o.note||'')+' · '+f.get('reason');log(o.status,oid+' · '+f.get('reason'));save();closeModal();render();toast('Decisión registrada.')}
function createPackage(e){e.preventDefault();let f=new FormData(e.target),o=data.orders.find(o=>o.id===f.get('order'));if(!o?.inventoryId){toast('Primero aprueba el pedido y genera inventario.');return}if(data.packages.some(p=>p.orderId===o.id&&!p.received)){toast('Este pedido ya tiene un paquete activo. Completa su recepción antes de crear otro.');return}let people=[...new Set(o.items.map(i=>i.employee))];let p={id:uid('PAQ'),orderId:o.id,employeeIds:people,status:'Preparado',carrier:'',guide:'',tracking:['Paquete preparado · '+dateNow()],received:false};data.packages.unshift(p);o.status='En preparación';let inv=data.inventory.find(i=>i.orderId===o.id);if(inv)inv.status='En preparación';log('Paquete preparado',p.id);save();closeModal();render();toast('Paquete creado con kits asignados.')}
function createGuide(e){e.preventDefault();let f=new FormData(e.target),p=data.packages.find(p=>p.id===f.get('package'));if(!p){toast('No hay paquete disponible para guía.');return}p.carrier=f.get('carrier');p.guide=f.get('guide');p.status='En tránsito';p.tracking.push('Guía registrada · '+dateNow());log('Guía registrada',p.id+' · '+p.guide);save();closeModal();render();toast('Guía registrada. Seguimiento simulado.')}
function simulate(id){let p=data.packages.find(p=>p.id===id),stages=['En tránsito','Llegada a centro de distribución','En reparto','Entregado por transportista'];let next=stages.find(s=>!p.tracking.some(t=>t.startsWith(s)));if(!next){toast('Seguimiento completo.');return}p.status=next;p.tracking.push(next+' · '+dateNow()+' (simulado)');log('Seguimiento actualizado',p.id+' · '+next);save();render();toast(next+'. Recepción física sigue pendiente.')}
function receivePackage(e,pid){e.preventDefault();let f=new FormData(e.target),p=data.packages.find(p=>p.id===pid),diff=f.get('difference');p.received=true;p.status=diff?'Recibido con diferencias':'Recibido en sucursal';if(diff)data.incidents.unshift({id:uid('INC'),orderId:p.orderId,type:diff,description:'Diferencia detectada en '+p.id,status:'Abierta',priority:'Media',date:dateNow()});p.employeeIds.forEach(emp=>{if(!data.deliveries.some(d=>d.packageId===p.id&&d.employee===emp))data.deliveries.push({id:uid('ENT'),orderId:p.orderId,packageId:p.id,employee:emp,status:'Pendiente'})});log('Recepción confirmada',p.id+(diff?' · '+diff:''));save();closeModal();render();toast('Recepción guardada; entregas individuales habilitadas.')}
let drawing=false,ink=false;function setupSig(){let c=document.getElementById('sig');if(!c)return;let ctx=c.getContext('2d');ctx.lineWidth=2;ctx.lineCap='round';ctx.strokeStyle='#142b4a';function point(e){let r=c.getBoundingClientRect();let t=e.touches?.[0]||e;return {x:(t.clientX-r.left)*c.width/r.width,y:(t.clientY-r.top)*c.height/r.height}}function start(e){e.preventDefault();drawing=true;ink=true;let p=point(e);ctx.beginPath();ctx.moveTo(p.x,p.y)}function move(e){if(!drawing)return;e.preventDefault();let p=point(e);ctx.lineTo(p.x,p.y);ctx.stroke()}c.addEventListener('mousedown',start);c.addEventListener('mousemove',move);window.addEventListener('mouseup',()=>drawing=false);c.addEventListener('touchstart',start,{passive:false});c.addEventListener('touchmove',move,{passive:false});c.addEventListener('touchend',()=>drawing=false)}function clearSig(){let c=document.getElementById('sig');if(c)c.getContext('2d').clearRect(0,0,c.width,c.height);ink=false}
function finishDelivery(e,id){e.preventDefault();if(!ink){toast('Dibuja la firma antes de confirmar.');return}let f=new FormData(e.target),d=data.deliveries.find(d=>d.id===id),c=document.getElementById('sig');d.status='Entregado';d.signature=c.toDataURL();d.signedAt=new Date().toLocaleString('es-MX');d.rating=f.get('rating');d.note=f.get('note');let o=data.orders.find(o=>o.id===d.orderId),related=data.deliveries.filter(x=>x.orderId===d.orderId);if(related.every(x=>x.status==='Entregado'))o.status='Completado';log('Entrega individual confirmada',d.employee+' · '+d.orderId);save();closeModal();render();toast('Entrega confirmada con firma.')}
function createIncident(e){e.preventDefault();let f=new FormData(e.target);data.incidents.unshift({id:uid('INC'),orderId:f.get('order'),type:f.get('type'),priority:f.get('priority'),description:f.get('description'),status:'Abierta',date:dateNow()});log('Incidencia registrada',f.get('type'));save();closeModal();render();toast('Incidencia registrada.')}
function resolveIncident(e,id){e.preventDefault();let f=new FormData(e.target),i=data.incidents.find(i=>i.id===id);i.status=f.get('status');i.resolution=f.get('resolution');log('Incidencia actualizada',id+' · '+i.status);save();closeModal();render();toast('Incidencia actualizada.')}
function exportCSV(rows,name){if(!rows.length){toast('No hay datos para exportar.');return}let keys=Object.keys(rows[0]),csv=[keys.join(','),...rows.map(r=>keys.map(k=>'"'+String(r[k]??'').replaceAll('"','""')+'"').join(','))].join('\r\n');let a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}));a.download=name;a.click();URL.revokeObjectURL(a.href);toast('CSV descargado.')}
function render(){save();navBuild();document.getElementById('date').textContent=dateNow();document.getElementById('crumb').textContent='Control Pro / '+page;document.getElementById('title').textContent=page;document.getElementById('subtitle').textContent=({'Dashboard':'Vista general de pedidos, inventario y entregas.','Pedidos':'Solicitudes consolidadas por sucursal y empleado.','Aprobaciones':'Revisa solicitudes antes de autorizar inventario.','Catálogo y kits':'Productos, tallas, precios de referencia y puestos autorizados.','Empleados':'Directorio de personal por sucursal y puesto.','Sucursales':'Estado operativo de las ubicaciones.','Órdenes de inventario':'Órdenes generadas al aprobar pedidos.','Preparación y paquetes':'Agrupa kits por empleado para su envío.','Envíos y guías':'Seguimiento simulado; sin conexión real con paqueterías.','Recepción en sucursal':'Verifica físicamente los paquetes.','Entregas individuales':'Entrega cada kit y registra la firma individual.','Incidencias':'Documenta y resuelve diferencias.','Conformidades':'Historial de firmas y entregas.','Reportes':'Consulta y exporta datos de operación.','Notificaciones':'Avisos generados por los eventos del sistema.','Actividad reciente':'Auditoría de las operaciones registradas.','Usuarios y permisos':'Selector de rol de demostración.','Configuración':'Reglas por puesto y restablecimiento local.','Modo demostración':'Recorrido por las etapas del proceso.'})[page]||'';let q=document.getElementById('search').value.toLowerCase();const table=(headers,rows)=>`<div class="panel"><table><thead><tr>${headers.map(h=>`<th>${h}</th>`).join('')}</tr></thead><tbody>${rows||''}</tbody></table>${rows?'':'<div class="empty">No hay registros en este módulo.</div>'}</div>`;const orderRows=data.orders.filter(o=>(filter==='Todos'||o.status===filter)&&`${o.id} ${o.branch} ${o.status}`.toLowerCase().includes(q)).map(o=>`<tr><td><b>${o.id}</b></td><td>${o.date}</td><td>${o.branch}</td><td>${new Set(o.items.map(i=>i.employee)).size}</td><td>${o.items.reduce((n,i)=>n+i.qty,0)}</td><td>${status(o.status)}</td><td><div class="actions"><button class="btn" onclick="openModal('detail-order','${o.id}')">Detalle</button>${page==='Aprobaciones'&&o.status==='En revisión'?`<button class="btn primary" onclick="openModal('approve','${o.id}')">Aprobar</button><button class="btn danger" onclick="openModal('reject','${o.id}')">Devolver</button>`:''}</div></td></tr>`).join('');let v='';
if(page==='Dashboard'){let active=data.orders.filter(o=>!['Completado','Rechazado'].includes(o.status)).length,pending=data.orders.filter(o=>o.status==='En revisión').length,transit=data.packages.filter(p=>['En tránsito','En reparto'].includes(p.status)).length,inc=data.incidents.filter(i=>!['Resuelta','Cerrada'].includes(i.status)).length;v=`<div class="grid">${[['Pedidos activos',active],['Pendientes de aprobación',pending],['Paquetes en tránsito',transit],['Incidencias abiertas',inc]].map(([a,b])=>`<div class="card"><div class="label">${a}</div><strong>${b}</strong><small>Calculado desde los registros</small></div>`).join('')}</div><div class="two"><div class="panel"><div class="panelhead"><div><h2>Pedidos recientes</h2><p>Solicitudes por sucursal</p></div><button class="btn" onclick="go('Pedidos')">Ver todos</button></div>${table(['FOLIO','FECHA','SUCURSAL','EMPLEADOS','ARTÍCULOS','ESTADO',''],orderRows.slice(0,5))}</div><div class="panel"><div class="panelhead"><div><h2>Estado de operación</h2><p>Conteo de pedidos actuales</p></div></div><div class="bars">${['En revisión','Aprobado','En preparación','En tránsito','Completado'].map((s,i)=>{let n=data.orders.filter(o=>o.status===s).length;return `<div class="bar"><label><span>${s}</span><b>${n}</b></label><div class="track"><div class="fill" style="width:${n/Math.max(1,data.orders.length)*100}%;background:${['#2563eb','#0d9488','#8b5cf6','#f59e0b','#16a34a'][i]}"></div></div></div>`}).join('')}</div></div></div><div class="panel"><div class="panelhead"><h2>Actividad reciente</h2><button class="btn" onclick="go('Actividad reciente')">Ver historial</button></div><div class="activity">${data.audit.slice(0,5).map(a=>`<div class="event"><b>${esc(a.action)}</b><p>${esc(a.detail)}</p><small>${esc(a.user||'Usuario')} · ${esc(a.date)}</small></div>`).join('')}</div></div><div class="notice">Entorno de demostración: los cambios se guardan en este navegador. Guías, eventos de transporte y firmas son simulados.</div>`}
