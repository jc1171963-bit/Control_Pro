  const abrir = (m: ModoMov) => {
    setModo(m);
    setVariante(m.fila ? { id: m.fila.variante_id, sku: m.fila.sku, etiqueta: `${m.fila.producto} · ${m.fila.color} · ${m.fila.talla}` } : null);
    setForm({ sucursal_id: m.fila?.sucursal_id ?? misSucursales?.[0]?.id ?? '', cantidad: 1, tipo: 'ajuste_positivo', minimo: m.fila?.minimo ?? 5, motivo: '' });
    setClave(claveIdempotencia('inv'));
  };
  const kardex = useQuery({ queryKey: ['kardex', modo?.fila?.sucursal_id, modo?.fila?.variante_id], enabled: modo?.tipo === 'kardex',
    queryFn: () => get<Pagina<Movimiento>>(`/admin/inventario/movimientos?sucursal_id=${modo!.fila!.sucursal_id}&variante_id=${modo!.fila!.variante_id}&por_pagina=50`) });
  const guardar = useMutation({
    mutationFn: () => {
      const base = { sucursal_id: Number(form.sucursal_id), variante_id: variante!.id };
      if (modo!.tipo === 'minimo') return put('/admin/inventario/minimo', { ...base, minimo: Number(form.minimo) });
      if (modo!.tipo === 'entrada') return post('/admin/inventario/entradas', { ...base, cantidad: Number(form.cantidad), motivo: form.motivo, clave_idempotencia: clave });
      return post('/admin/inventario/ajustes', { ...base, cantidad: Number(form.cantidad), tipo: form.tipo, motivo: form.motivo, clave_idempotencia: clave });
    },
    onSuccess: () => { qc.invalidateQueries({ queryKey: ['inventario'] }); setModo(null); avisar('Movimiento registrado en el kardex.'); },
  });

  return (
    <>
      <Encabezado titulo="Inventario por sucursal" sub="Disponible = físico − reservado − comprometido">
        <Boton variante="secundario" icono={<FileDown className="h-4 w-4" />} onClick={() => descargar(`/admin/reportes/exportar/inventario?formato=xlsx${params.get('sucursal_id') ? `&sucursal_id=${params.get('sucursal_id')}` : ''}`)}>Exportar</Boton>
        {puede('inventario.entrada') && <Boton icono={<ArrowDownToLine className="h-4 w-4" />} onClick={() => abrir({ tipo: 'entrada' })}>Registrar entrada</Boton>}
      </Encabezado>
      <Tarjeta>
        <div className="mb-4 flex flex-wrap items-center gap-2">
          <form onSubmit={(e) => { e.preventDefault(); set('q', texto); }} className="relative"><Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-tinta-300" />
            <Entrada value={texto} onChange={(e) => setTexto(e.target.value)} placeholder="Producto o SKU" className="w-60 pl-9" /></form>
          <FiltroSucursal valor={params.get('sucursal_id') || ''} onCambio={(v) => set('sucursal_id', v)} />
          <label className="flex items-center gap-2 text-sm font-semibold"><input type="checkbox" checked={params.get('bajo') === '1'} onChange={(e) => set('bajo', e.target.checked ? '1' : '')} className="accent-coral-500" />Solo existencias bajas</label>
        </div>
        <ErrorCaja error={q.error} />
        {q.isLoading ? <Cargando /> : (
          <Tabla columnas={['Sucursal', 'SKU', 'Producto', 'Físico', 'Reservado', 'Comprometido', 'En tránsito', 'Disponible', 'Mínimo', '']} vacia={!q.data?.items.length}>
            {q.data?.items.map((f) => (
              <tr key={`${f.sucursal_id}-${f.variante_id}`} className={cls(f.bajo && 'bg-amber-50/50')}>
                <Td className="text-xs">{f.sucursal}</Td><Td className="font-mono text-xs">{f.sku}</Td><Td>{f.producto}<p className="text-xs text-tinta-400">{f.color} · {f.talla}</p></Td>
                <Td>{f.fisico}</Td><Td className="text-amber-700">{f.reservado}</Td><Td className="text-sky-700">{f.comprometido}</Td><Td className="text-violet-700">{f.en_transito}</Td>
                <Td className={cls('font-bold', f.disponible <= 0 ? 'text-coral-600' : f.bajo ? 'text-amber-700' : 'text-menta-700')}>{f.disponible}</Td><Td>{f.minimo}</Td>
                <Td><div className="flex gap-1">
                  <button className="rounded-lg p-1.5 text-tinta-400 hover:bg-tinta-50" title="Kardex" aria-label="Kardex" onClick={() => abrir({ tipo: 'kardex', fila: f })}><History className="h-4 w-4" /></button>
                  {puede('inventario.entrada') && <button className="rounded-lg p-1.5 text-tinta-400 hover:bg-tinta-50" title="Entrada" aria-label="Entrada" onClick={() => abrir({ tipo: 'entrada', fila: f })}><Plus className="h-4 w-4" /></button>}
                  {puede('inventario.ajustar') && <button className="rounded-lg p-1.5 text-tinta-400 hover:bg-tinta-50" title="Ajuste o mínimo" aria-label="Ajuste" onClick={() => abrir({ tipo: 'ajuste', fila: f })}><SlidersHorizontal className="h-4 w-4" /></button>}
                </div></Td>
              </tr>
            ))}
          </Tabla>
        )}
        {q.data && <Paginacion pagina={q.data.pagina} paginas={q.data.paginas} total={q.data.total} onCambio={(p) => set('pagina', String(p))} />}
      </Tarjeta>

      <Modal abierto={!!modo} titulo={modo?.tipo === 'kardex' ? `Kardex · ${modo.fila?.sku} · ${modo.fila?.sucursal}` : modo?.tipo === 'entrada' ? 'Registrar entrada' : modo?.tipo === 'minimo' ? 'Existencia mínima' : 'Ajuste de inventario'}
        onCerrar={() => setModo(null)} ancho={modo?.tipo === 'kardex' ? 'max-w-3xl' : 'max-w-lg'}>
        {modo?.tipo === 'kardex' ? (kardex.isLoading ? <Cargando /> : (
          <Tabla columnas={['Fecha', 'Tipo', 'Cantidad', 'Saldo', 'Motivo', 'Usuario']} vacia={!kardex.data?.items.length}>
            {kardex.data?.items.map((m) => <tr key={m.id}><Td className="text-xs">{fechaHora(m.fecha)}</Td><Td className="text-xs">{TIPOS_MOVIMIENTO[m.tipo]}</Td>
              <Td className={m.cantidad < 0 ? 'text-coral-600' : 'text-menta-700'}>{m.cantidad > 0 ? '+' : ''}{m.cantidad}</Td><Td>{m.saldo}</Td><Td className="text-xs">{m.motivo}</Td><Td className="text-xs">{m.usuario}</Td></tr>)}
          </Tabla>
        )) : (
          <div className="space-y-4">
            {modo?.tipo === 'ajuste' && <div className="flex gap-2 text-sm"><button className={cls('rounded-full px-3 py-1 font-semibold ring-1', 'bg-tinta-900 text-white ring-tinta-900')}>Ajuste</button>
              <button className="rounded-full px-3 py-1 font-semibold ring-1 ring-tinta-200" onClick={() => setModo({ ...modo, tipo: 'minimo' })}>Cambiar mínimo</button></div>}
            {variante ? <p className="rounded-lg bg-tinta-50 p-3 text-sm"><b className="font-mono">{variante.sku}</b><br />{variante.etiqueta}
              {!modo?.fila && <button className="ml-2 text-xs font-semibold text-coral-600" onClick={() => setVariante(null)}>Cambiar</button>}</p> : <SelectorVariante onElegir={setVariante} />}
            <Campo etiqueta="Sucursal"><Selector value={form.sucursal_id} disabled={!!modo?.fila} onChange={(e) => setForm({ ...form, sucursal_id: e.target.value })}>
              {misSucursales?.map((s) => <option key={s.id} value={s.id}>{s.nombre}</option>)}</Selector></Campo>
            {modo?.tipo === 'minimo' ? (
              <Campo etiqueta="Existencia mínima (alerta)"><Entrada type="number" min={0} value={form.minimo} onChange={(e) => setForm({ ...form, minimo: e.target.value })} /></Campo>
            ) : <>
              {modo?.tipo === 'ajuste' && <Campo etiqueta="Tipo"><Selector value={form.tipo} onChange={(e) => setForm({ ...form, tipo: e.target.value })}>
                <option value="ajuste_positivo">Ajuste positivo (+)</option><option value="ajuste_negativo">Ajuste negativo (−)</option><option value="merma">Merma (daño, pérdida)</option></Selector></Campo>}
              <Campo etiqueta="Cantidad"><Entrada type="number" min={1} value={form.cantidad} onChange={(e) => setForm({ ...form, cantidad: e.target.value })} /></Campo>
              <Campo etiqueta={modo?.tipo === 'entrada' ? 'Motivo / referencia (factura, orden de compra)' : 'Motivo del ajuste'}><Texto value={form.motivo} onChange={(e) => setForm({ ...form, motivo: e.target.value })} /></Campo>
              {modo?.tipo === 'ajuste' && <Aviso>Los ajustes no pueden dejar el físico por debajo de lo reservado o comprometido con pedidos.</Aviso>}
            </>}
            <ErrorCaja error={guardar.error} />
            <div className="flex justify-end gap-2"><Boton variante="secundario" onClick={() => setModo(null)}>Cancelar</Boton>
              <Boton disabled={!variante || !form.sucursal_id || (modo?.tipo !== 'minimo' && String(form.motivo).trim().length < (modo?.tipo === 'entrada' ? 3 : 5))} cargando={guardar.isPending} onClick={() => guardar.mutate()}>Guardar</Boton></div>
          </div>
        )}
      </Modal>
    </>
  );
}

export function Transferencias() {
  const { puede, usuario } = useAuth();
  const qc = useQueryClient();
  const avisar = useAviso();
  const sucs = useSucursalesAdmin();
  const [estado, setEstado] = useState('');
  const [pagina, setPagina] = useState(1);
  const q = useQuery({ queryKey: ['transferencias', estado, pagina], queryFn: () => get<Pagina<Transferencia>>(`/admin/transferencias?pagina=${pagina}${estado ? `&estado=${estado}` : ''}`) });
  const [nueva, setNueva] = useState(false);
  const [form, setForm] = useState<{ origen: string; destino: string; motivo: string; partidas: (VarSel & { cantidad: number })[] }>({ origen: '', destino: '', motivo: '', partidas: [] });
  const [operar, setOperar] = useState<{ t: Transferencia; accion: 'enviar' | 'recibir' | 'cancelar' } | null>(null);
  const [cant, setCant] = useState<Record<number, number>>({});
  const [obs, setObs] = useState('');
  const mias = (id: number) => usuario?.rol.alcance_global || usuario?.sucursales.some((s) => s.id === id);
  const refrescar = () => qc.invalidateQueries({ queryKey: ['transferencias'] });
  const crear = useMutation({
    mutationFn: () => post('/admin/transferencias', { origen_id: Number(form.origen), destino_id: Number(form.destino), motivo: form.motivo, partidas: form.partidas.map((p) => ({ variante_id: p.id, cantidad: p.cantidad })) }),
    onSuccess: () => { refrescar(); setNueva(false); setForm({ origen: '', destino: '', motivo: '', partidas: [] }); avisar('Transferencia solicitada.'); },
  });
  const autorizar = useMutation({ mutationFn: (id: number) => post(`/admin/transferencias/${id}/autorizar`), onSuccess: () => { refrescar(); avisar('Transferencia autorizada.'); } });
  const ejecutar = useMutation({
    mutationFn: () => operar!.accion === 'cancelar' ? post(`/admin/transferencias/${operar!.t.id}/cancelar`, { motivo: obs })
      : post(`/admin/transferencias/${operar!.t.id}/${operar!.accion}`, { cantidades: Object.fromEntries(Object.entries(cant).map(([k, v]) => [k, Number(v)])), observaciones: obs || null }),
    onSuccess: () => { refrescar(); qc.invalidateQueries({ queryKey: ['inventario'] }); setOperar(null); avisar('Transferencia actualizada.'); },
  });
  const abrirOperar = (t: Transferencia, accion: 'enviar' | 'recibir' | 'cancelar') => {
    setCant(Object.fromEntries(t.detalles.map((d) => [d.id, accion === 'enviar' ? d.cantidad : d.enviada]))); setObs(''); setOperar({ t, accion });
  };
  return (
    <>
      <Encabezado titulo="Transferencias entre sucursales" sub="Salida en origen → tránsito → recepción en destino">
        {puede('transferencia.solicitar') && <Boton icono={<Plus className="h-4 w-4" />} onClick={() => setNueva(true)}>Solicitar transferencia</Boton>}
      </Encabezado>
      <Tarjeta accion={<Selector value={estado} onChange={(e) => { setEstado(e.target.value); setPagina(1); }} className="w-48"><option value="">Todos los estados</option>
        {['solicitada', 'autorizada', 'enviada', 'recibida', 'recibida_parcial', 'cancelada'].map((e) => <option key={e} value={e}>{e.replace('_', ' ')}</option>)}</Selector>}>
        <ErrorCaja error={q.error || autorizar.error} />
        {q.isLoading ? <Cargando /> : (
          <Tabla columnas={['Folio', 'Origen → destino', 'Partidas', 'Motivo', 'Actualizado', 'Estado', '']} vacia={!q.data?.items.length}>
            {q.data?.items.map((t) => (
              <tr key={t.id}>
                <Td className="font-semibold">{t.folio}</Td><Td>{t.origen.nombre} → {t.destino.nombre}</Td>
                <Td className="text-xs">{t.detalles.map((d) => `${d.cantidad}× ${d.sku}${d.enviada ? ` (env. ${d.enviada}${t.estado.startsWith('recibida') ? `, rec. ${d.recibida}` : ''})` : ''}`).join(' · ')}</Td>
                <Td className="max-w-xs text-xs">{t.motivo}{t.observaciones && <p className="text-tinta-400">{t.observaciones}</p>}</Td><Td className="text-xs">{fechaHora(t.actualizado)}</Td><Td><Estado valor={t.estado} /></Td>
                <Td><div className="flex flex-wrap gap-1">
                  {t.estado === 'solicitada' && puede('transferencia.autorizar') && mias(t.origen.id) && <Boton tam="sm" onClick={() => autorizar.mutate(t.id)}>Autorizar</Boton>}
                  {['solicitada', 'autorizada'].includes(t.estado) && puede('transferencia.autorizar') && mias(t.origen.id) && <Boton tam="sm" variante="fantasma" onClick={() => abrirOperar(t, 'cancelar')}>Cancelar</Boton>}
                  {t.estado === 'autorizada' && puede('transferencia.operar') && mias(t.origen.id) && <Boton tam="sm" variante="menta" onClick={() => abrirOperar(t, 'enviar')}>Enviar</Boton>}
                  {t.estado === 'enviada' && puede('transferencia.operar') && mias(t.destino.id) && <Boton tam="sm" variante="menta" onClick={() => abrirOperar(t, 'recibir')}>Recibir</Boton>}
                </div></Td>
              </tr>
            ))}
          </Tabla>
        )}
        {q.data && <Paginacion pagina={q.data.pagina} paginas={q.data.paginas} total={q.data.total} onCambio={setPagina} />}
      </Tarjeta>

      <Modal abierto={nueva} titulo="Solicitar transferencia" onCerrar={() => setNueva(false)} ancho="max-w-2xl">
        <div className="space-y-4">
          <div className="grid gap-3 sm:grid-cols-2">
            <Campo etiqueta="Sucursal origen"><Selector value={form.origen} onChange={(e) => setForm({ ...form, origen: e.target.value })}><option value="">Elige…</option>{sucs.data?.map((s) => <option key={s.id} value={s.id}>{s.nombre}</option>)}</Selector></Campo>
            <Campo etiqueta="Sucursal destino"><Selector value={form.destino} onChange={(e) => setForm({ ...form, destino: e.target.value })}><option value="">Elige…</option>{sucs.data?.filter((s) => String(s.id) !== form.origen).map((s) => <option key={s.id} value={s.id}>{s.nombre}</option>)}</Selector></Campo>
          </div>
          <Campo etiqueta="Motivo"><Entrada value={form.motivo} onChange={(e) => setForm({ ...form, motivo: e.target.value })} /></Campo>
          <div>
            <p className="mb-2 text-sm font-semibold">Partidas</p>
            {form.partidas.map((p, i) => (
              <div key={p.id} className="mb-2 flex items-center gap-2 rounded-lg p-2 text-sm ring-1 ring-tinta-100">
                <span className="flex-1"><b className="font-mono text-xs">{p.sku}</b> {p.etiqueta}</span>
                <Entrada type="number" min={1} className="w-20" value={p.cantidad} onChange={(e) => setForm({ ...form, partidas: form.partidas.map((x, j) => j === i ? { ...x, cantidad: Number(e.target.value) } : x) })} />
                <button onClick={() => setForm({ ...form, partidas: form.partidas.filter((_, j) => j !== i) })} aria-label="Quitar"><Trash2 className="h-4 w-4 text-tinta-400" /></button>
              </div>
            ))}
            <SelectorVariante onElegir={(v) => !form.partidas.some((p) => p.id === v.id) && setForm({ ...form, partidas: [...form.partidas, { ...v, cantidad: 1 }] })} />
          </div>
          <ErrorCaja error={crear.error} />
          <div className="flex justify-end gap-2"><Boton variante="secundario" onClick={() => setNueva(false)}>Cancelar</Boton>
            <Boton disabled={!form.origen || !form.destino || form.motivo.trim().length < 5 || !form.partidas.length} cargando={crear.isPending} onClick={() => crear.mutate()}>Solicitar</Boton></div>
        </div>
      </Modal>
      <Modal abierto={!!operar} titulo={operar ? `${operar.accion === 'enviar' ? 'Enviar' : operar.accion === 'recibir' ? 'Recibir' : 'Cancelar'} ${operar.t.folio}` : ''} onCerrar={() => setOperar(null)}>
        {operar && (
          <div className="space-y-3">
            {operar.accion !== 'cancelar' && operar.t.detalles.map((d) => (
              <div key={d.id} className="flex items-center justify-between gap-2 rounded-lg p-2 text-sm ring-1 ring-tinta-100">
                <span><b className="font-mono text-xs">{d.sku}</b> · {d.producto} {d.talla}</span>
                <span className="flex items-center gap-2"><Entrada type="number" min={0} max={operar.accion === 'enviar' ? d.cantidad : d.enviada} className="w-20" value={cant[d.id] ?? 0}
                  onChange={(e) => setCant({ ...cant, [d.id]: Number(e.target.value) })} />de {operar.accion === 'enviar' ? d.cantidad : d.enviada}</span>
              </div>
            ))}
            {operar.accion === 'recibir' && <Aviso>Si recibes menos de lo enviado se registra una incidencia de faltante.</Aviso>}
            <Campo etiqueta={operar.accion === 'cancelar' ? 'Motivo de cancelación' : 'Observaciones'}><Texto value={obs} onChange={(e) => setObs(e.target.value)} /></Campo>
            <ErrorCaja error={ejecutar.error} />
            <div className="flex justify-end gap-2"><Boton variante="secundario" onClick={() => setOperar(null)}>Volver</Boton>
              <Boton variante={operar.accion === 'cancelar' ? 'peligro' : 'primario'} disabled={operar.accion === 'cancelar' && obs.trim().length < 5} cargando={ejecutar.isPending} onClick={() => ejecutar.mutate()}>Confirmar</Boton></div>
          </div>
        )}
      </Modal>
    </>
  );
}
</file>

<file path="control-pro-plataforma/frontend/src/features/admin/Pagos.tsx">
import { useState } from 'react';
import { Link } from 'react-router-dom';
import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
import { FileDown, FileText } from 'lucide-react';
import { abrirPrivado, descargar, get, post } from '../../api/cliente';
import type { Pago, Pagina, Reembolso } from '../../api/tipos';
import { useAuth } from '../../app/auth';
import { Aviso, Boton, Campo, Cargando, Entrada, ErrorCaja, Estado, Modal, Paginacion, Tabla, Tarjeta, Td, Texto, useAviso } from '../../components/ui';
import { cls, dinero, fechaHora, METODOS } from '../../lib/formato';
import { Encabezado } from './AdminLayout';

const PESTANAS = [['en_proceso', 'Por validar'], ['pendiente', 'Créditos por cobrar'], ['confirmado,reembolsado_parcial,reembolsado', 'Confirmados'], ['rechazado,cancelado', 'Rechazados / cancelados'], ['reembolsos', 'Reembolsos']];

export default function Pagos() {
  const { puede } = useAuth();
  const qc = useQueryClient();
  const avisar = useAviso();
  const [tab, setTab] = useState('en_proceso');
  const [pagina, setPagina] = useState(1);
  const pagos = useQuery({ queryKey: ['admin-pagos', tab, pagina], enabled: tab !== 'reembolsos', queryFn: () => get<Pagina<Pago>>(`/admin/pagos?estado=${tab}&pagina=${pagina}`) });
  const reemb = useQuery({ queryKey: ['admin-reembolsos', pagina], enabled: tab === 'reembolsos', queryFn: () => get<Pagina<Reembolso>>(`/admin/reembolsos?pagina=${pagina}`) });
  const [accion, setAccion] = useState<{ tipo: 'validar' | 'rechazar' | 'cobrar' | 'reembolsar'; id: number; monto: string; folio: string } | null>(null);
  const [texto, setTexto] = useState('');
  const m = useMutation({
    mutationFn: () => {
      const a = accion!;
      if (a.tipo === 'rechazar') return post(`/admin/pagos/${a.id}/rechazar`, { motivo: texto });
      if (a.tipo === 'reembolsar') return post(`/admin/reembolsos/${a.id}/realizar`, { referencia: texto });
      return post(`/admin/pagos/${a.id}/validar`, { nota: texto || null });
    },
    onSuccess: () => { qc.invalidateQueries({ queryKey: ['admin-pagos'] }); qc.invalidateQueries({ queryKey: ['admin-reembolsos'] }); setAccion(null); setTexto(''); avisar('Registro actualizado.'); },
  });
  const textoObligatorio = accion?.tipo !== 'validar';
  return (
    <>
      <Encabezado titulo="Pagos y reembolsos" sub="La confirmación de un pago siempre la hace una persona autorizada">
        <Boton variante="secundario" icono={<FileDown className="h-4 w-4" />} onClick={() => descargar('/admin/reportes/exportar/pagos?formato=xlsx')}>Exportar</Boton>
      </Encabezado>
      <div className="mb-4"><Aviso>No hay pasarela de pago integrada: las transferencias se validan contra el estado de cuenta y el efectivo se registra en caja. Nunca se guardan datos de tarjetas.</Aviso></div>
      <Tarjeta>
        <div className="mb-4 flex flex-wrap gap-1.5">
          {PESTANAS.map(([v, n]) => <button key={v} onClick={() => { setTab(v); setPagina(1); }} className={cls('rounded-full px-3 py-1 text-xs font-semibold ring-1', tab === v ? 'bg-tinta-900 text-white ring-tinta-900' : 'ring-tinta-200')}>{n}</button>)}
        </div>
        {tab !== 'reembolsos' ? (pagos.isLoading ? <Cargando /> : (
          <>
            <ErrorCaja error={pagos.error} />
            <Tabla columnas={['Pago', 'Pedido', 'Cliente', 'Método', 'Referencia', 'Monto', 'Estado', '']} vacia={!pagos.data?.items.length}>
              {pagos.data?.items.map((p) => (
                <tr key={p.id}>
                  <Td><p className="font-semibold">{p.folio}</p><p className="text-xs text-tinta-400">{fechaHora(p.creado)}</p></Td>
                  <Td><Link to={`/admin/pedidos/${p.pedido?.id}`} className="font-semibold text-menta-700 hover:underline">{p.pedido?.folio}</Link><p className="text-xs text-tinta-400">Total {dinero(p.pedido?.total)}</p></Td>
                  <Td>{p.pedido?.cliente}</Td><Td className="text-xs">{METODOS[p.metodo]}</Td>
                  <Td className="text-xs">{p.referencia || '—'}{p.comprobante_url && <button onClick={() => abrirPrivado(p.comprobante_url!)} className="ml-1 inline-flex items-center gap-1 font-semibold text-menta-700"><FileText className="h-3 w-3" />comprobante</button>}
                    {p.motivo_rechazo && <p className="text-coral-600">{p.motivo_rechazo}</p>}</Td>
                  <Td className="font-semibold">{dinero(p.monto)}</Td><Td><Estado valor={p.estado} /></Td>
                  <Td>{puede('pago.validar') && (
                    p.estado === 'en_proceso' ? <div className="flex gap-1">
                      <Boton tam="sm" variante="menta" onClick={() => setAccion({ tipo: 'validar', id: p.id, monto: p.monto, folio: p.folio })}>Validar</Boton>
                      <Boton tam="sm" variante="secundario" onClick={() => setAccion({ tipo: 'rechazar', id: p.id, monto: p.monto, folio: p.folio })}>Rechazar</Boton></div>
                      : p.estado === 'pendiente' && p.metodo === 'credito_corporativo' ? <Boton tam="sm" onClick={() => setAccion({ tipo: 'cobrar', id: p.id, monto: p.monto, folio: p.folio })}>Registrar cobro</Boton> : null)}</Td>
                </tr>
              ))}
            </Tabla>
            {pagos.data && <Paginacion pagina={pagos.data.pagina} paginas={pagos.data.paginas} total={pagos.data.total} onCambio={setPagina} />}
          </>
        )) : (reemb.isLoading ? <Cargando /> : (
          <>
            <Tabla columnas={['Fecha', 'Pedido', 'Cliente', 'Tipo', 'Motivo', 'Monto', 'Estado', '']} vacia={!reemb.data?.items.length}>
              {reemb.data?.items.map((r) => (
                <tr key={r.id}><Td className="text-xs">{fechaHora(r.creado)}</Td><Td><Link to={`/admin/pedidos/${r.pedido?.id}`} className="font-semibold text-menta-700">{r.pedido?.folio}</Link></Td>
                  <Td>{r.pedido?.cliente}</Td><Td className="text-xs">{r.tipo === 'ajuste' ? 'Ajuste a crédito' : 'Reembolso'}</Td><Td className="max-w-xs text-xs">{r.motivo}{r.referencia && <p className="text-tinta-400">Ref. {r.referencia}</p>}</Td>
                  <Td className="font-semibold">{dinero(r.monto)}</Td><Td><Estado valor={r.estado} /></Td>
                  <Td>{r.estado === 'pendiente' && puede('reembolso.autorizar') && <Boton tam="sm" onClick={() => setAccion({ tipo: 'reembolsar', id: r.id, monto: r.monto, folio: r.pedido?.folio || '' })}>Registrar</Boton>}</Td></tr>
              ))}
            </Tabla>
            {reemb.data && <Paginacion pagina={reemb.data.pagina} paginas={reemb.data.paginas} total={reemb.data.total} onCambio={setPagina} />}
          </>
        ))}
      </Tarjeta>
      <Modal abierto={!!accion} titulo={accion ? { validar: 'Validar pago', rechazar: 'Rechazar pago', cobrar: 'Registrar cobro de crédito', reembolsar: 'Registrar reembolso' }[accion.tipo] + ` · ${accion.folio}` : ''} onCerrar={() => setAccion(null)}>
        <div className="space-y-4">
          <p className="text-sm">Monto: <b>{dinero(accion?.monto)}</b></p>
          {accion?.tipo === 'validar' && <Aviso>Confirma solo si el depósito aparece en el estado de cuenta con la referencia indicada.</Aviso>}
          {accion?.tipo === 'reembolsar' && <Aviso>Registra la referencia de la transferencia de devolución, el folio de caja o la nota de crédito.</Aviso>}
          <Campo etiqueta={accion?.tipo === 'rechazar' ? 'Motivo del rechazo' : accion?.tipo === 'validar' ? 'Nota (opcional)' : 'Referencia'}>
            {accion?.tipo === 'rechazar' ? <Texto value={texto} onChange={(e) => setTexto(e.target.value)} /> : <Entrada value={texto} onChange={(e) => setTexto(e.target.value)} />}
          </Campo>
          <ErrorCaja error={m.error} />
          <div className="flex justify-end gap-2"><Boton variante="secundario" onClick={() => setAccion(null)}>Cancelar</Boton>
            <Boton variante={accion?.tipo === 'rechazar' ? 'peligro' : 'primario'} disabled={textoObligatorio && texto.trim().length < (accion?.tipo === 'rechazar' ? 5 : 4)} cargando={m.isPending} onClick={() => m.mutate()}>Confirmar</Boton></div>
        </div>
      </Modal>
    </>
  );
}
</file>

<file path="control-pro-plataforma/frontend/src/features/admin/Pedidos.tsx">
import { useState } from 'react';
import { Link, useParams, useSearchParams } from 'react-router-dom';
import { keepPreviousData, useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
import { Ban, Check, CheckCheck, FileDown, Search, Undo2, X } from 'lucide-react';
import { claveIdempotencia, descargar, get, post } from '../../api/cliente';
import type { Pagina, Pedido, PedidoResumen } from '../../api/tipos';
import { useAuth } from '../../app/auth';
import { Aviso, Boton, Campo, Cargando, Entrada, ErrorCaja, Estado, Modal, Paginacion, Selector, Tabla, Tarjeta, Td, Texto, useAviso } from '../../components/ui';
import { cls, dinero, etiqueta, fechaHora, METODOS, mensajeError } from '../../lib/formato';
import { Encabezado, FiltroSucursal } from './AdminLayout';

const ESTADOS_FILTRO = [['', 'Todos'], ['en_revision', 'Por aprobar'], ['pendiente_pago,pago_en_revision', 'Por pagar'], ['confirmado,en_preparacion', 'Por surtir'],
  ['parcialmente_enviado,enviado', 'En camino'], ['parcialmente_entregado,entregado', 'Entregados'], ['cerrado', 'Cerrados'], ['cancelado,expirado,rechazado', 'Cancelados']];

export function Pedidos() {
  const [params, setParams] = useSearchParams();
  const [texto, setTexto] = useState(params.get('q') || '');
  const set = (k: string, v: string) => { const p = new URLSearchParams(params); v ? p.set(k, v) : p.delete(k); if (k !== 'pagina') p.delete('pagina'); setParams(p); };
  const q = useQuery({ queryKey: ['admin-pedidos', params.toString()], queryFn: () => get<Pagina<PedidoResumen>>(`/admin/pedidos?por_pagina=20&${params.toString()}`), placeholderData: keepPreviousData });
  return (
    <>
      <Encabezado titulo="Pedidos" sub="Tienda en línea y canal corporativo">
        <Boton variante="secundario" icono={<FileDown className="h-4 w-4" />} onClick={() => descargar(`/admin/reportes/exportar/pedidos?formato=xlsx${params.get('sucursal_id') ? `&sucursal_id=${params.get('sucursal_id')}` : ''}`)}>Exportar Excel</Boton>
      </Encabezado>
      <Tarjeta>
        <div className="mb-4 flex flex-wrap items-center gap-2">
          <form onSubmit={(e) => { e.preventDefault(); set('q', texto); }} className="relative">
            <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-tinta-300" />
            <Entrada value={texto} onChange={(e) => setTexto(e.target.value)} placeholder="Folio, cliente o correo" className="w-64 pl-9" />
          </form>
          <Selector value={params.get('canal') || ''} onChange={(e) => set('canal', e.target.value)} className="w-40"><option value="">Ambos canales</option><option value="tienda">Tienda</option><option value="corporativo">Corporativo</option></Selector>
          <FiltroSucursal valor={params.get('sucursal_id') || ''} onCambio={(v) => set('sucursal_id', v)} />
        </div>
        <div className="mb-4 flex flex-wrap gap-1.5">
          {ESTADOS_FILTRO.map(([v, n]) => <button key={v} onClick={() => set('estado', v)} className={cls('rounded-full px-3 py-1 text-xs font-semibold ring-1', (params.get('estado') || '') === v ? 'bg-tinta-900 text-white ring-tinta-900' : 'ring-tinta-200 hover:bg-tinta-50')}>{n}</button>)}
        </div>
        <ErrorCaja error={q.error} />
        {q.isLoading ? <Cargando /> : (
          <Tabla columnas={['Folio', 'Fecha', 'Cliente', 'Canal', 'Sucursales', 'Artículos', 'Total', 'Estado']} vacia={!q.data?.items.length}>
            {q.data?.items.map((p) => (
              <tr key={p.id} className="hover:bg-tinta-50/60">
                <Td><Link to={`/admin/pedidos/${p.id}`} className="font-semibold text-tinta-900 hover:text-menta-700">{p.folio}</Link></Td>
                <Td className="text-xs">{fechaHora(p.creado)}</Td><Td>{p.cliente.nombre}</Td>
                <Td><span className="text-xs font-semibold capitalize">{p.canal}</span><br /><span className="text-xs text-tinta-400">{p.modalidad === 'recoger' ? 'Recoger' : 'Envío'}</span></Td>
                <Td className="text-xs">{p.sucursales.join(', ') || '—'}</Td><Td>{p.articulos}</Td><Td className="font-semibold">{dinero(p.total)}</Td><Td><Estado valor={p.estado} /></Td>
              </tr>
            ))}
          </Tabla>
        )}
        {q.data && <Paginacion pagina={q.data.pagina} paginas={q.data.paginas} total={q.data.total} onCambio={(p) => set('pagina', String(p))} />}
      </Tarjeta>
    </>
  );
}

export function PedidoAdmin() {
  const { id } = useParams();
  const { puede } = useAuth();
  const qc = useQueryClient();
  const avisar = useAviso();
  const q = useQuery({ queryKey: ['admin-pedido', id], queryFn: () => get<Pedido>(`/admin/pedidos/${id}`) });
  const [modal, setModal] = useState<'aprobar' | 'devuelto' | 'rechazado' | 'cancelar' | 'cerrar' | 'efectivo' | 'incidencia' | null>(null);
  const [texto, setTexto] = useState('');
  const [aceptar, setAceptar] = useState(false);
  const [clave, setClave] = useState(() => claveIdempotencia('efectivo'));
  const [tipoInc, setTipoInc] = useState('seguimiento');
  const refrescar = () => { qc.invalidateQueries({ queryKey: ['admin-pedido', id] }); qc.invalidateQueries({ queryKey: ['admin-pedidos'] }); };
  const accion = useMutation({
    mutationFn: async () => {
      switch (modal) {
        case 'aprobar': return post(`/admin/pedidos/${id}/decision`, { decision: 'aprobado', motivo: texto || null, aceptar_excepciones: aceptar });
        case 'devuelto': case 'rechazado': return post(`/admin/pedidos/${id}/decision`, { decision: modal, motivo: texto });
        case 'cancelar': return post(`/admin/pedidos/${id}/cancelar`, { motivo: texto });
        case 'cerrar': return post(`/admin/pedidos/${id}/cerrar`, { nota: texto || null });
        case 'efectivo': return post(`/admin/pedidos/${id}/efectivo`, { monto: q.data!.saldo, referencia: texto || null, clave_idempotencia: clave });
        case 'incidencia': return post('/admin/incidencias', { tipo: tipoInc, descripcion: texto, pedido_id: Number(id), prioridad: 'media' });
      }
    },
    onSuccess: () => { refrescar(); avisar('Operación registrada.'); setModal(null); setTexto(''); setClave(claveIdempotencia('efectivo')); },
  });
  const validar = useMutation({ mutationFn: ({ pid }: { pid: number }) => post(`/admin/pagos/${pid}/validar`, { nota: 'Validado desde el detalle del pedido' }),
    onSuccess: () => { refrescar(); avisar('Pago actualizado.'); }, onError: (e) => avisar(mensajeError(e), 'error') });

  if (q.isLoading) return <Cargando />;
  if (!q.data) return <ErrorCaja error={q.error} />;
  const p = q.data;
  const excepciones = p.detalles.some((d) => d.excepcion);
  const titulos: Record<string, string> = { aprobar: 'Aprobar pedido', devuelto: 'Devolver para corrección', rechazado: 'Rechazar pedido', cancelar: 'Cancelar pedido', cerrar: 'Cerrar pedido', efectivo: 'Registrar cobro en efectivo', incidencia: 'Registrar incidencia' };
  const requiereTexto = ['devuelto', 'rechazado', 'cancelar', 'incidencia'].includes(modal || '');

  return (
    <>
      <Encabezado titulo={`Pedido ${p.folio}`} sub={`${p.canal === 'corporativo' ? 'Canal corporativo' : 'Tienda en línea'} · ${fechaHora(p.creado)}`}>
        <Boton variante="secundario" icono={<FileDown className="h-4 w-4" />} onClick={() => descargar(`/admin/pedidos/${p.id}/pdf`, `${p.folio}.pdf`)}>PDF</Boton>
        {p.estado === 'en_revision' && puede('pedido.aprobar') && <>
          <Boton variante="menta" icono={<Check className="h-4 w-4" />} onClick={() => setModal('aprobar')}>Aprobar</Boton>
          <Boton variante="secundario" icono={<Undo2 className="h-4 w-4" />} onClick={() => setModal('devuelto')}>Devolver</Boton>
          <Boton variante="peligro" icono={<X className="h-4 w-4" />} onClick={() => setModal('rechazado')}>Rechazar</Boton>
        </>}
        {p.estado === 'pendiente_pago' && p.metodo_pago === 'efectivo' && puede('pago.registrar_efectivo') && <Boton variante="menta" onClick={() => setModal('efectivo')}>Cobrar {dinero(p.saldo)} en efectivo</Boton>}
        {p.estado === 'entregado' && puede('pedido.cerrar') && <Boton icono={<CheckCheck className="h-4 w-4" />} onClick={() => setModal('cerrar')}>Cerrar pedido</Boton>}
        {['en_revision', 'devuelto', 'pendiente_pago', 'pago_en_revision', 'confirmado', 'en_preparacion'].includes(p.estado) && puede('pedido.cancelar') &&
          <Boton variante="fantasma" icono={<Ban className="h-4 w-4" />} onClick={() => setModal('cancelar')}>Cancelar</Boton>}
        {puede('incidencia.gestionar') && <Boton variante="fantasma" onClick={() => setModal('incidencia')}>Incidencia</Boton>}
      </Encabezado>

      <div className="grid gap-5 xl:grid-cols-[1fr_340px]">
        <div className="space-y-5">
          <Tarjeta titulo={<span className="flex items-center gap-2">Estado <Estado valor={p.estado} /></span>} sub={`${METODOS[p.metodo_pago]} · ${p.modalidad === 'recoger' ? `Recoge en ${p.sucursal_recoger?.nombre}` : 'Envío a domicilio'}`}>
            {excepciones && p.estado === 'en_revision' && <div className="mb-3"><Aviso tipo="alerta">Este pedido incluye productos fuera de la regla por puesto; revisa las justificaciones antes de aprobar.</Aviso></div>}
            <Tabla columnas={['Artículo', p.canal === 'corporativo' ? 'Empleado' : '', 'Cant.', 'Precio', 'Importe', 'Entregada / cancelada / devuelta']}>
              {p.detalles.map((d) => (
                <tr key={d.id}>
                  <Td><p className="font-semibold">{d.nombre}</p><p className="text-xs text-tinta-400">{d.sku} · {d.color} · {d.talla}</p>
                    {d.excepcion && <p className="mt-1 rounded bg-amber-50 px-2 py-0.5 text-xs text-amber-800">Excepción: {d.excepcion}</p>}</Td>
                  <Td className="text-xs">{d.empleado ? <>{d.empleado.nombre}<br /><span className="text-tinta-400">{d.empleado.puesto}</span></> : ''}</Td>
                  <Td>{d.cantidad}</Td><Td className="text-xs">{dinero(d.precio_unitario)}{Number(d.descuento_unitario) > 0 && <><br /><span className="text-coral-600">−{dinero(d.descuento_unitario)}</span></>}</Td>
                  <Td className="font-semibold">{dinero(d.importe)}</Td><Td className="text-xs">{d.cantidad_entregada} / {d.cantidad_cancelada} / {d.cantidad_devuelta}</Td>
                </tr>
              ))}
            </Tabla>
            <dl className="ml-auto mt-4 max-w-xs space-y-1 text-sm">
              <div className="flex justify-between"><dt>Subtotal</dt><dd>{dinero(p.subtotal)}</dd></div>
              <div className="flex justify-between"><dt>Descuento</dt><dd>−{dinero(p.descuento)}</dd></div>
              <div className="flex justify-between"><dt>Envío</dt><dd>{dinero(p.costo_envio)}</dd></div>
              <div className="flex justify-between border-t pt-1 font-display text-lg font-extrabold"><dt>Total</dt><dd>{dinero(p.total)}</dd></div>
              <div className="flex justify-between text-xs text-tinta-400"><dt>Saldo por cobrar</dt><dd>{dinero(p.saldo)}</dd></div>
            </dl>
          </Tarjeta>

          <Tarjeta titulo="Surtido por sucursal">
            {!p.asignaciones?.length ? <p className="text-sm text-tinta-400">Aún sin asignar: el inventario se aparta al confirmar (pago o aprobación).</p> : (
              <div className="grid gap-3 md:grid-cols-2">
                {p.asignaciones.map((a) => (
                  <div key={a.id} className="rounded-xl p-4 ring-1 ring-tinta-100">
                    <div className="flex items-center justify-between"><p className="font-semibold">{a.sucursal.nombre}</p><Estado valor={a.estado} /></div>
                    <p className="mt-1 text-xs text-tinta-500">{a.detalles.map((d) => `${d.cantidad}× ${d.sku}`).join(' · ')}</p>
                    <p className="mt-1 text-xs text-tinta-400">Surtidas {a.detalles.reduce((s, d) => s + d.surtida, 0)} · Despachadas {a.detalles.reduce((s, d) => s + d.despachada, 0)} · Faltantes {a.detalles.reduce((s, d) => s + d.faltante, 0)}</p>
                    {puede('surtido.operar') && <Link to={`/admin/surtido/${a.id}`} className="mt-2 inline-block text-xs font-semibold text-menta-700">Abrir surtido →</Link>}
                  </div>
                ))}
              </div>
            )}
          </Tarjeta>

          <Tarjeta titulo="Pagos y reembolsos">
            {!p.pagos.length ? <p className="text-sm text-tinta-400">Sin pagos registrados.</p> : (
              <Tabla columnas={['Folio', 'Método', 'Referencia', 'Monto', 'Estado', '']}>
                {p.pagos.map((x) => (
                  <tr key={x.id}><Td>{x.folio}</Td><Td>{METODOS[x.metodo]}</Td><Td className="text-xs">{x.referencia || '—'}{x.motivo_rechazo && <p className="text-coral-600">{x.motivo_rechazo}</p>}</Td>
                    <Td>{dinero(x.monto)}{Number(x.monto_reembolsado) > 0 && <p className="text-xs text-tinta-400">Reembolsado {dinero(x.monto_reembolsado)}</p>}</Td><Td><Estado valor={x.estado} /></Td>
                    <Td>{x.estado === 'en_proceso' && puede('pago.validar') && <div className="flex gap-1">
                      <Boton tam="sm" variante="menta" onClick={() => validar.mutate({ pid: x.id })}>Validar</Boton>
                      <Link to="/admin/pagos" className="inline-flex h-8 items-center rounded-lg px-3 text-xs font-semibold ring-1 ring-tinta-200">Rechazar…</Link></div>}</Td></tr>
                ))}
              </Tabla>
            )}
          </Tarjeta>

          {!!p.paquetes.length && (
            <Tarjeta titulo="Paquetes">
              <Tabla columnas={['Paquete', 'Sucursal', 'Contenido', 'Guía', 'Estado']}>
                {p.paquetes.map((pq) => <tr key={pq.id}><Td className="font-semibold">{pq.folio}</Td><Td>{pq.sucursal}</Td><Td className="text-xs">{pq.contenido.map((c) => `${c.cantidad}× ${c.sku}`).join(', ')}</Td>
                  <Td className="text-xs">{pq.envio ? `${pq.envio.paqueteria} · ${pq.envio.guia}` : '—'}{pq.recepcion && <p className="text-menta-700">Recepción {pq.recepcion.estado}</p>}</Td><Td><Estado valor={pq.estado} /></Td></tr>)}
              </Tabla>
            </Tarjeta>
          )}
          {!!p.entregas_individuales?.length && (
            <Tarjeta titulo="Entregas individuales (corporativo)">
              <Tabla columnas={['Empleado', 'Artículos', 'Valoración', 'Fecha', 'Estado']}>
                {p.entregas_individuales.map((e) => <tr key={e.id}><Td>{e.empleado.nombre}<p className="text-xs text-tinta-400">{e.empleado.puesto}</p></Td>
                  <Td className="text-xs">{e.detalles.map((d) => `${d.entregada}/${d.esperada} ${d.sku}`).join(', ')}</Td><Td>{e.valoracion ?? '—'}</Td><Td className="text-xs">{fechaHora(e.entregado_en)}</Td><Td><Estado valor={e.estado} /></Td></tr>)}
              </Tabla>
            </Tarjeta>
          )}
        </div>

        <div className="space-y-5">
          <Tarjeta titulo="Cliente">
            <p className="font-semibold">{p.cliente.razon_social || p.cliente.nombre}</p>
            <p className="text-sm text-tinta-500">{p.cliente.correo}<br />{p.cliente.telefono}</p>
            {p.direccion_envio && <p className="mt-3 text-sm"><b>Entrega:</b> {p.direccion_envio.calle} {p.direccion_envio.numero}, {p.direccion_envio.colonia}, {p.direccion_envio.ciudad}, {p.direccion_envio.estado} · CP {p.direccion_envio.cp}<br /><span className="text-tinta-400">Recibe {p.direccion_envio.destinatario} · {p.direccion_envio.telefono}</span></p>}
            {p.notas && <p className="mt-3 rounded-lg bg-tinta-50 p-2 text-xs">{p.notas}</p>}
            {puede('cliente.ver') && <Link to={`/admin/clientes?q=${encodeURIComponent(p.cliente.correo)}`} className="mt-2 inline-block text-xs font-semibold text-menta-700">Ver cliente →</Link>}
          </Tarjeta>
          {!!p.incidencias?.length && (
            <Tarjeta titulo="Incidencias">
              {p.incidencias.map((i) => <div key={i.id} className="mb-2 rounded-lg p-3 text-sm ring-1 ring-tinta-100"><div className="flex justify-between"><b>{i.folio}</b><Estado valor={i.estado} /></div><p className="text-xs">{i.descripcion}</p></div>)}
              <Link to="/admin/incidencias" className="text-xs font-semibold text-menta-700">Gestionar →</Link>
            </Tarjeta>
          )}
          {!!p.devoluciones.length && (
            <Tarjeta titulo="Devoluciones">{p.devoluciones.map((d) => <div key={d.id} className="mb-2 flex justify-between text-sm"><Link to="/admin/devoluciones" className="font-semibold hover:underline">{d.folio}</Link><Estado valor={d.estado} /></div>)}</Tarjeta>
          )}
          <Tarjeta titulo="Historial">
            <ol className="space-y-3 text-sm">
              {p.historial.map((h, i) => <li key={i} className="border-l-2 border-menta-300 pl-3"><p className="font-semibold">{etiqueta(h.nuevo)}</p><p className="text-xs text-tinta-400">{fechaHora(h.fecha)} · {h.actor}</p>{h.motivo && <p className="text-xs text-tinta-500">{h.motivo}</p>}</li>)}
            </ol>
          </Tarjeta>
        </div>
      </div>

      <Modal abierto={!!modal} titulo={modal ? titulos[modal] : ''} onCerrar={() => setModal(null)}>
        <div className="space-y-4">
          {modal === 'aprobar' && <>
            <p className="text-sm text-tinta-500">Al aprobar se asignan sucursales y se aparta el inventario. Si no hay existencias suficientes, la aprobación no procede.</p>
            {excepciones && <label className="flex items-start gap-2 rounded-lg bg-amber-50 p-3 text-sm text-amber-900"><input type="checkbox" checked={aceptar} onChange={(e) => setAceptar(e.target.checked)} className="mt-1" />Autorizo las excepciones por puesto incluidas en este pedido.</label>}
          </>}
          {modal === 'efectivo' && <Aviso>Confirma que recibiste {dinero(p.saldo)} en efectivo. El cobro queda registrado a tu nombre y confirma el pedido.</Aviso>}
          {modal === 'cerrar' && <p className="text-sm text-tinta-500">Solo se cierra si no hay incidencias abiertas, devoluciones en trámite, reembolsos pendientes ni entregas individuales pendientes.</p>}
          {modal === 'incidencia' && <Campo etiqueta="Tipo"><Selector value={tipoInc} onChange={(e) => setTipoInc(e.target.value)}>
            {['seguimiento', 'talla_incorrecta', 'articulo_faltante', 'articulo_danado', 'paquete_no_recibido', 'error_preparacion', 'otro'].map((t) => <option key={t} value={t}>{t.replace(/_/g, ' ')}</option>)}</Selector></Campo>}
          <Campo etiqueta={modal === 'efectivo' ? 'Folio de caja (opcional)' : requiereTexto ? 'Motivo / descripción (obligatorio)' : 'Comentario (opcional)'}>
            {modal === 'efectivo' ? <Entrada value={texto} onChange={(e) => setTexto(e.target.value)} /> : <Texto value={texto} onChange={(e) => setTexto(e.target.value)} />}
          </Campo>
          <ErrorCaja error={accion.error} />
          <div className="flex justify-end gap-2">
            <Boton variante="secundario" onClick={() => setModal(null)}>Volver</Boton>
            <Boton variante={['rechazado', 'cancelar'].includes(modal || '') ? 'peligro' : 'primario'} cargando={accion.isPending}
              disabled={(requiereTexto && texto.trim().length < (modal === 'incidencia' ? 10 : 5)) || (modal === 'aprobar' && excepciones && !aceptar)} onClick={() => accion.mutate()}>Confirmar</Boton>
          </div>
        </div>
      </Modal>
    </>
  );
}
</file>

<file path="control-pro-plataforma/frontend/src/features/admin/Posventa.tsx">
import { useState } from 'react';
import { Link } from 'react-router-dom';
import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
import { FileText } from 'lucide-react';
import { abrirPrivado, get, patch, post } from '../../api/cliente';
import type { Devolucion, Incidencia, Pagina } from '../../api/tipos';
import { useAuth } from '../../app/auth';
import { Aviso, Boton, Campo, Cargando, Entrada, ErrorCaja, Estado, Modal, Paginacion, Selector, Tabla, Tarjeta, Td, Texto, useAviso } from '../../components/ui';
import { cls, dinero, etiqueta, fechaHora, MOTIVOS_DEVOLUCION } from '../../lib/formato';
import { Encabezado, useSucursalesAdmin } from './AdminLayout';

const FILTROS_DEV = [['solicitada', 'Por autorizar'], ['autorizada,en_camino', 'Por recibir'], ['recibida', 'Por inspeccionar'], ['inspeccionada,reembolsada', 'Por cerrar'], ['', 'Todas']];

export function Devoluciones() {
  const { puede, usuario } = useAuth();
  const qc = useQueryClient();
  const avisar = useAviso();
  const sucs = useSucursalesAdmin();
  const [estado, setEstado] = useState('solicitada');
  const [pagina, setPagina] = useState(1);
  const q = useQuery({ queryKey: ['admin-devoluciones', estado, pagina], queryFn: () => get<Pagina<Devolucion>>(`/admin/devoluciones?pagina=${pagina}${estado ? `&estado=${estado}` : ''}`) });
  const [sel, setSel] = useState<Devolucion | null>(null);
  const [f, setF] = useState<any>({});
  const refrescar = () => qc.invalidateQueries({ queryKey: ['admin-devoluciones'] });
  const m = useMutation({
    mutationFn: (accion: string) => {
      const id = sel!.id;
      if (accion === 'autorizar') return post(`/admin/devoluciones/${id}/autorizar`, { sucursal_id: Number(f.sucursal_id), nota: f.nota || null });
      if (accion === 'rechazar') return post(`/admin/devoluciones/${id}/rechazar`, { motivo: f.nota });
      if (accion === 'recibir') return post(`/admin/devoluciones/${id}/recibir`, { cantidades: f.recibidas || {}, observaciones: f.nota || null });
      if (accion === 'inspeccionar') return post(`/admin/devoluciones/${id}/inspeccionar`, { resultados: f.resultados || {}, nota: f.nota || null });
      return post(`/admin/devoluciones/${id}/cerrar`, { nota: f.nota || null });
    },
    onSuccess: (d: Devolucion) => { refrescar(); setSel(d); setF({}); avisar(`Devolución ${etiqueta(d.estado).toLowerCase()}.`); },
  });
  const puedeRecibir = sel?.sucursal_recibe && (usuario?.rol.alcance_global || usuario?.sucursales.some((s) => s.id === sel.sucursal_recibe!.id)) && puede('devolucion.recibir');
  const abrir = (d: Devolucion) => {
    setSel(d);
    setF({ recibidas: Object.fromEntries(d.detalles.map((x) => [x.id, x.cantidad])), resultados: Object.fromEntries(d.detalles.map((x) => [x.id, { aptas: x.recibida, merma: 0 }])) });
  };
  return (
    <>
      <Encabezado titulo="Devoluciones" sub="Solicitud con evidencia → autorización → recepción → inspección → reembolso" />
      <Tarjeta>
        <div className="mb-4 flex flex-wrap gap-1.5">{FILTROS_DEV.map(([v, n]) => <button key={v} onClick={() => { setEstado(v); setPagina(1); }} className={cls('rounded-full px-3 py-1 text-xs font-semibold ring-1', estado === v ? 'bg-tinta-900 text-white ring-tinta-900' : 'ring-tinta-200')}>{n}</button>)}</div>
        {q.isLoading ? <Cargando /> : (
          <Tabla columnas={['Folio', 'Pedido', 'Motivo', 'Artículos', 'Recibe', 'Monto', 'Estado', '']} vacia={!q.data?.items.length}>
            {q.data?.items.map((d) => (
              <tr key={d.id}><Td><p className="font-semibold">{d.folio}</p><p className="text-xs text-tinta-400">{fechaHora(d.creado)}</p></Td>
                <Td><Link to={`/admin/pedidos/${d.pedido_id}`} className="text-menta-700 hover:underline">{d.pedido_folio}</Link></Td><Td className="text-xs">{MOTIVOS_DEVOLUCION[d.motivo]}</Td>
                <Td className="text-xs">{d.detalles.map((x) => `${x.cantidad}× ${x.sku}`).join(', ')}</Td><Td className="text-xs">{d.sucursal_recibe?.nombre || '—'}</Td>
                <Td>{Number(d.monto_reembolso) ? dinero(d.monto_reembolso) : '—'}</Td><Td><Estado valor={d.estado} /></Td><Td><Boton tam="sm" variante="secundario" onClick={() => abrir(d)}>Gestionar</Boton></Td></tr>
            ))}
          </Tabla>
        )}
        {q.data && <Paginacion pagina={q.data.pagina} paginas={q.data.paginas} total={q.data.total} onCambio={setPagina} />}
      </Tarjeta>
      <Modal abierto={!!sel} titulo={sel ? `Devolución ${sel.folio}` : ''} onCerrar={() => setSel(null)} ancho="max-w-2xl">
        {sel && (
          <div className="space-y-4 text-sm">
            <div className="flex items-center justify-between"><span>{MOTIVOS_DEVOLUCION[sel.motivo]} · pedido {sel.pedido_folio}</span><Estado valor={sel.estado} /></div>
            <p className="rounded-lg bg-tinta-50 p-3">{sel.descripcion}</p>
            <div className="flex flex-wrap gap-2">{sel.evidencias.map((e, i) => e.startsWith('/api/') ? <button key={e} onClick={() => abrirPrivado(e)} className="inline-flex items-center gap-1 text-xs font-semibold text-menta-700"><FileText className="h-3 w-3" />Evidencia {i + 1}</button> : <span key={e} className="text-xs text-tinta-500">{e}</span>)}</div>
            {sel.guia_retorno && <p className="text-xs">Guía de retorno: {sel.guia_retorno}</p>}

            {sel.estado === 'solicitada' && puede('devolucion.gestionar') && <>
              <Campo etiqueta="Sucursal que recibe"><Selector value={f.sucursal_id || ''} onChange={(e) => setF({ ...f, sucursal_id: e.target.value })}><option value="">Elige…</option>{sucs.data?.map((s) => <option key={s.id} value={s.id}>{s.nombre}</option>)}</Selector></Campo>
              <Campo etiqueta="Nota para el cliente / motivo de rechazo"><Texto value={f.nota || ''} onChange={(e) => setF({ ...f, nota: e.target.value })} /></Campo>
              <div className="flex justify-end gap-2"><Boton variante="peligro" disabled={(f.nota || '').trim().length < 5} onClick={() => m.mutate('rechazar')}>Rechazar</Boton><Boton disabled={!f.sucursal_id} onClick={() => m.mutate('autorizar')}>Autorizar</Boton></div>
            </>}
            {['autorizada', 'en_camino'].includes(sel.estado) && (puedeRecibir ? <>
              <p className="font-semibold">Unidades recibidas físicamente</p>
              {sel.detalles.map((x) => <div key={x.id} className="flex items-center justify-between gap-2"><span>{x.sku} · {x.nombre} {x.talla}</span>
                <span className="flex items-center gap-2"><Entrada type="number" min={0} max={x.cantidad} className="w-20" value={f.recibidas?.[x.id] ?? x.cantidad} onChange={(e) => setF({ ...f, recibidas: { ...f.recibidas, [x.id]: Number(e.target.value) } })} />de {x.cantidad}</span></div>)}
              <Campo etiqueta="Observaciones"><Texto value={f.nota || ''} onChange={(e) => setF({ ...f, nota: e.target.value })} /></Campo>
              <div className="flex justify-end"><Boton onClick={() => m.mutate('recibir')}>Registrar recepción</Boton></div>
            </> : <Aviso>Se recibe en {sel.sucursal_recibe?.nombre}; solo esa sucursal registra la recepción.</Aviso>)}
            {sel.estado === 'recibida' && (puedeRecibir ? <>
              <p className="font-semibold">Inspección: ¿regresa al inventario?</p>
              {sel.detalles.map((x) => (
                <div key={x.id} className="grid items-end gap-2 sm:grid-cols-[1fr_90px_90px]"><span>{x.sku} · recibidas {x.recibida}</span>
                  <Campo etiqueta="Aptas"><Entrada type="number" min={0} max={x.recibida} value={f.resultados?.[x.id]?.aptas ?? x.recibida} onChange={(e) => setF({ ...f, resultados: { ...f.resultados, [x.id]: { aptas: Number(e.target.value), merma: x.recibida - Number(e.target.value) } } })} /></Campo>
                  <Campo etiqueta="Merma"><Entrada type="number" value={f.resultados?.[x.id]?.merma ?? 0} readOnly /></Campo></div>
              ))}
              <Aviso>Las piezas aptas reingresan al inventario de {sel.sucursal_recibe?.nombre}; la merma no. Se genera el reembolso (o ajuste si el pedido es a crédito) por lo recibido.</Aviso>
              <Campo etiqueta="Dictamen"><Texto value={f.nota || ''} onChange={(e) => setF({ ...f, nota: e.target.value })} /></Campo>
              <div className="flex justify-end"><Boton onClick={() => m.mutate('inspeccionar')}>Guardar inspección</Boton></div>
            </> : <Aviso>Pendiente de inspección en {sel.sucursal_recibe?.nombre}.</Aviso>)}
            {['inspeccionada', 'reembolsada'].includes(sel.estado) && puede('devolucion.gestionar') && <>
              {sel.estado === 'inspeccionada' && Number(sel.monto_reembolso) > 0 && <Aviso tipo="alerta">Falta registrar el reembolso de {dinero(sel.monto_reembolso)} en Pagos y reembolsos.</Aviso>}
              <div className="flex justify-end"><Boton onClick={() => m.mutate('cerrar')}>Cerrar devolución</Boton></div>
            </>}
            <ErrorCaja error={m.error} />
            <div className="border-t border-tinta-100 pt-3"><p className="mb-1 text-xs font-semibold uppercase text-tinta-400">Historial</p>
              {sel.historial.map((h, i) => <p key={i} className="text-xs">{fechaHora(h.fecha)} · <b>{etiqueta(h.nuevo)}</b> · {h.actor}{h.motivo ? ` — ${h.motivo}` : ''}</p>)}</div>
          </div>
        )}
      </Modal>
    </>
  );
}

export function Incidencias() {
  const qc = useQueryClient();
  const avisar = useAviso();
  const [estado, setEstado] = useState('abierta,en_atencion');
  const [pagina, setPagina] = useState(1);
  const q = useQuery({ queryKey: ['admin-incidencias', estado, pagina], queryFn: () => get<Pagina<Incidencia>>(`/admin/incidencias?pagina=${pagina}${estado ? `&estado=${estado}` : ''}`) });
  const [sel, setSel] = useState<Incidencia | null>(null);
  const [nuevoEstado, setNuevoEstado] = useState('');
  const [comentario, setComentario] = useState('');
  const m = useMutation({
    mutationFn: () => patch<Incidencia>(`/admin/incidencias/${sel!.id}`, { estado: nuevoEstado || null, comentario: comentario || null }),
    onSuccess: (i) => { qc.invalidateQueries({ queryKey: ['admin-incidencias'] }); setSel(i); setComentario(''); avisar('Incidencia actualizada.'); },
  });
  return (
    <>
      <Encabezado titulo="Incidencias" sub="Faltantes, daños, diferencias de recepción y problemas de entrega" />
      <Tarjeta>
        <div className="mb-4 flex flex-wrap gap-1.5">{[['abierta,en_atencion', 'Abiertas'], ['resuelta', 'Resueltas'], ['cerrada', 'Cerradas'], ['', 'Todas']].map(([v, n]) =>
          <button key={v} onClick={() => { setEstado(v); setPagina(1); }} className={cls('rounded-full px-3 py-1 text-xs font-semibold ring-1', estado === v ? 'bg-tinta-900 text-white ring-tinta-900' : 'ring-tinta-200')}>{n}</button>)}</div>
        {q.isLoading ? <Cargando /> : (
          <Tabla columnas={['Folio', 'Tipo', 'Referencia', 'Descripción', 'Prioridad', 'Estado', '']} vacia={!q.data?.items.length}>
            {q.data?.items.map((i) => (
              <tr key={i.id}><Td><p className="font-semibold">{i.folio}</p><p className="text-xs text-tinta-400">{fechaHora(i.creado)}</p></Td><Td className="text-xs">{i.tipo.replace(/_/g, ' ')}</Td>
                <Td className="text-xs">{i.pedido_id ? <Link to={`/admin/pedidos/${i.pedido_id}`} className="text-menta-700">Pedido #{i.pedido_id}</Link> : i.transferencia_id ? `Transferencia #${i.transferencia_id}` : i.devolucion_id ? `Devolución #${i.devolucion_id}` : '—'}</Td>
                <Td className="max-w-sm text-xs">{i.descripcion}</Td><Td><Estado valor={i.prioridad} /></Td><Td><Estado valor={i.estado} /></Td>
                <Td><Boton tam="sm" variante="secundario" onClick={() => { setSel(i); setNuevoEstado(''); }}>Gestionar</Boton></Td></tr>
            ))}
          </Tabla>
        )}
        {q.data && <Paginacion pagina={q.data.pagina} paginas={q.data.paginas} total={q.data.total} onCambio={setPagina} />}
      </Tarjeta>
      <Modal abierto={!!sel} titulo={sel ? `Incidencia ${sel.folio}` : ''} onCerrar={() => setSel(null)}>
        {sel && (
          <div className="space-y-4 text-sm">
            <div className="flex items-center gap-2"><Estado valor={sel.estado} /><Estado valor={sel.prioridad} /></div>
            <p className="rounded-lg bg-tinta-50 p-3"><b>Descripción original:</b> {sel.descripcion}</p>
            {sel.resolucion && <div><p className="text-xs font-semibold uppercase text-tinta-400">Seguimiento</p><pre className="whitespace-pre-wrap font-sans text-xs">{sel.resolucion}</pre></div>}
            <Campo etiqueta="Agregar comentario o resolución" ayuda="Se agrega al historial; no reemplaza lo anterior."><Texto value={comentario} onChange={(e) => setComentario(e.target.value)} /></Campo>
            <Campo etiqueta="Cambiar estado"><Selector value={nuevoEstado} onChange={(e) => setNuevoEstado(e.target.value)}><option value="">Sin cambio</option>
              {['abierta', 'en_atencion', 'resuelta', 'cerrada'].filter((x) => x !== sel.estado).map((x) => <option key={x} value={x}>{etiqueta(x)}</option>)}</Selector></Campo>
            <ErrorCaja error={m.error} />
            <div className="flex justify-end gap-2"><Boton variante="secundario" onClick={() => setSel(null)}>Cerrar</Boton><Boton disabled={!comentario.trim() && !nuevoEstado} cargando={m.isPending} onClick={() => m.mutate()}>Guardar</Boton></div>
          </div>
        )}
      </Modal>
    </>
  );
}
</file>

<file path="control-pro-plataforma/frontend/src/features/admin/Reportes.tsx">
import { useState } from 'react';
import { FileSpreadsheet, FileText } from 'lucide-react';
import { descargar } from '../../api/cliente';
import { Boton, Campo, Entrada, Tarjeta, useAviso } from '../../components/ui';
import { mensajeError } from '../../lib/formato';
import { Encabezado, FiltroSucursal } from './AdminLayout';

const REPORTES = [
  ['pedidos', 'Pedidos', 'Folio, canal, cliente, estado, montos y sucursales que surten.'],
  ['pagos', 'Pagos', 'Método, estado, monto, reembolsos y fecha de validación.'],
  ['inventario', 'Inventario actual', 'Físico, reservado, comprometido, en tránsito y disponible por sucursal.'],
  ['movimientos', 'Movimientos de inventario', 'Kardex del periodo: entradas, salidas, ajustes, transferencias y reingresos.'],
  ['devoluciones', 'Devoluciones', 'Motivo, estado, unidades y monto reembolsado.'],
  ['sucursales', 'Comparativa de sucursales', 'Pedidos, unidades, faltantes, importe surtido y valor de existencias.'],
];

export default function Reportes() {
  const avisar = useAviso();
  const hoy = new Date().toISOString().slice(0, 10);
  const [desde, setDesde] = useState(new Date(Date.now() - 29 * 864e5).toISOString().slice(0, 10));
  const [hasta, setHasta] = useState(hoy);
  const [sucursal, setSucursal] = useState('');
  const bajar = (r: string, formato: string) =>
    descargar(`/admin/reportes/exportar/${r}?formato=${formato}&desde=${desde}&hasta=${hasta}${sucursal ? `&sucursal_id=${sucursal}` : ''}`).catch((e) => avisar(mensajeError(e), 'error'));
  return (
    <>
      <Encabezado titulo="Reportes y exportaciones" sub="Datos tomados directamente de la base central y limitados a tu alcance" />
      <Tarjeta className="mb-5">
        <div className="flex flex-wrap items-end gap-3">
          <Campo etiqueta="Desde"><Entrada type="date" value={desde} max={hasta} onChange={(e) => setDesde(e.target.value)} /></Campo>
          <Campo etiqueta="Hasta"><Entrada type="date" value={hasta} max={hoy} onChange={(e) => setHasta(e.target.value)} /></Campo>
          <FiltroSucursal valor={sucursal} onCambio={setSucursal} />
        </div>
      </Tarjeta>
      <div className="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {REPORTES.map(([k, n, d]) => (
          <Tarjeta key={k} titulo={n}>
            <p className="mb-4 text-sm text-tinta-500">{d}</p>
            <div className="flex gap-2">
              <Boton tam="sm" icono={<FileSpreadsheet className="h-4 w-4" />} onClick={() => bajar(k, 'xlsx')}>Excel</Boton>
              <Boton tam="sm" variante="secundario" icono={<FileText className="h-4 w-4" />} onClick={() => bajar(k, 'csv')}>CSV</Boton>
            </div>
          </Tarjeta>
        ))}
      </div>
      <p className="mt-4 text-xs text-tinta-400">El comprobante PDF de cada pedido se descarga desde su detalle. Los PDF no son comprobantes fiscales (CFDI): la facturación requiere un proveedor certificado (PAC).</p>
    </>
  );
}
</file>

<file path="control-pro-plataforma/frontend/src/features/admin/Sistema.tsx">
import { useState } from 'react';
import { Link, useSearchParams } from 'react-router-dom';
import { keepPreviousData, useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
import { Building2, Pencil, Plus, Search, UserPlus } from 'lucide-react';
import { get, post, put } from '../../api/cliente';
import type { Cliente, Pagina, Sucursal, Usuario } from '../../api/tipos';
import { useAuth } from '../../app/auth';
import { Boton, Campo, Cargando, Entrada, ErrorCaja, Estado, Modal, Paginacion, Selector, Tabla, Tarjeta, Td, useAviso } from '../../components/ui';
import { cls, dinero, fecha, fechaHora } from '../../lib/formato';
import { ListaNotificaciones } from '../cuenta/Notificaciones';
import { Encabezado, useSucursalesAdmin } from './AdminLayout';

export function Clientes() {
  const [params, setParams] = useSearchParams();
  const [texto, setTexto] = useState(params.get('q') || '');
  const [pagina, setPagina] = useState(1);
  const [tipo, setTipo] = useState('');
