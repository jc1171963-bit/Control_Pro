else if(page==='Preparación y paquetes'){v=`<div class="panel"><div class="panelhead"><div><h2>Preparación y paquetes</h2><p>Un kit solo puede estar en un paquete activo.</p></div><button class="btn primary" onclick="openModal('package')">＋ Crear paquete</button></div>${table(['PAQUETE','PEDIDO','EMPLEADOS / KITS','GUÍA','ESTADO','ACCIONES'],data.packages.map(p=>`<tr><td><b>${p.id}</b></td><td>${p.orderId}</td><td>${p.employeeIds.length}</td><td>${p.guide||'—'}</td><td>${status(p.status)}</td><td><button class="btn" onclick="alert('${p.id}\nEmpleados: '+${JSON.stringify(p.employeeIds.length)}+'\nEstado: ${p.status}')">Contenido</button>${p.status==='Preparado'?` <button class="btn" onclick="openModal('guide','${p.id}')">Guía</button>`:''}</td></tr>`).join(''))}</div>`}
