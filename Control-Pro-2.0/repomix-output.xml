    assert pagos[0]["estado"] == "reembolsado"
    assert fin.post(f"/api/admin/reembolsos/{reemb[0]['id']}/realizar", {"referencia": "DUPLICADO"}).status_code == 409


def test_ajustes_respetan_reservas(como, app):
