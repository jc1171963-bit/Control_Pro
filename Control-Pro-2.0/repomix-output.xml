<file path="control-pro-plataforma/frontend/src/features/cuenta/Perfil.tsx">
import { FormEvent, useState } from 'react';
import { patch, post } from '../../api/cliente';
import type { Cliente } from '../../api/tipos';
import { useAuth } from '../../app/auth';
import { Boton, Campo, Entrada, ErrorCaja, Tarjeta, useAviso } from '../../components/ui';

export default function Perfil() {
  const { cliente, actualizarCuenta } = useAuth();
  const avisar = useAviso();
  const [e1, setE1] = useState<unknown>(null);
  const [e2, setE2] = useState<unknown>(null);
  const guardar = async (e: FormEvent<HTMLFormElement>) => {
    e.preventDefault();
    const f = Object.fromEntries(new FormData(e.currentTarget)) as Record<string, string>;
    try {
      const d = await patch<Cliente>('/cuenta/perfil', { nombre: f.nombre, telefono: f.telefono || null, ...(cliente?.tipo === 'empresa' ? { razon_social: f.razon_social } : {}) });
      actualizarCuenta(d); setE1(null); avisar('Perfil actualizado.');
    } catch (err) { setE1(err); }
  };
  const cambiar = async (e: FormEvent<HTMLFormElement>) => {
    e.preventDefault();
    const form = e.currentTarget;
    const f = Object.fromEntries(new FormData(form)) as Record<string, string>;
    if (f.nueva !== f.confirmar) { setE2(new Error('Las contraseñas no coinciden.')); return; }
    try { await post('/auth/password', { actual: f.actual, nueva: f.nueva }); form.reset(); setE2(null); avisar('Contraseña actualizada.'); } catch (err) { setE2(err); }
  };
  return (
    <div className="space-y-5">
      <Tarjeta titulo="Datos de contacto">
        <form onSubmit={guardar} className="grid gap-4 sm:grid-cols-2">
          {cliente?.tipo === 'empresa' && <Campo etiqueta="Razón social"><Entrada name="razon_social" defaultValue={cliente.razon_social || ''} /></Campo>}
          <Campo etiqueta="Nombre"><Entrada name="nombre" defaultValue={cliente?.nombre} required minLength={3} /></Campo>
          <Campo etiqueta="Teléfono"><Entrada name="telefono" defaultValue={cliente?.telefono || ''} /></Campo>
          <Campo etiqueta="Correo" ayuda="Para cambiarlo, contacta a atención a clientes."><Entrada value={cliente?.correo} disabled /></Campo>
          <div className="sm:col-span-2"><ErrorCaja error={e1} /></div>
          <div className="sm:col-span-2"><Boton type="submit">Guardar cambios</Boton></div>
        </form>
      </Tarjeta>
      <Tarjeta titulo="Contraseña">
        <form onSubmit={cambiar} className="grid gap-4 sm:grid-cols-3">
          <Campo etiqueta="Actual"><Entrada name="actual" type="password" required autoComplete="current-password" /></Campo>
          <Campo etiqueta="Nueva"><Entrada name="nueva" type="password" required minLength={8} autoComplete="new-password" /></Campo>
          <Campo etiqueta="Confirmar"><Entrada name="confirmar" type="password" required autoComplete="new-password" /></Campo>
          <div className="sm:col-span-3"><ErrorCaja error={e2} /></div>
          <div><Boton type="submit">Cambiar contraseña</Boton></div>
        </form>
      </Tarjeta>
    </div>
  );
}
</file>

<file path="control-pro-plataforma/frontend/src/features/tienda/Carrito.tsx">
import { Link } from 'react-router-dom';
import { useMutation, useQueryClient } from '@tanstack/react-query';
import { Minus, Plus, ShoppingBag, Trash2 } from 'lucide-react';
import { del, patch } from '../../api/cliente';
import { useAuth } from '../../app/auth';
import { Aviso, Boton, Cargando, ErrorCaja, useAviso, Vacio } from '../../components/ui';
import { dinero, mensajeError } from '../../lib/formato';
import { ImagenProducto } from './ProductoCard';
import { useCarrito } from './TiendaLayout';

export default function Carrito() {
  const { tipo } = useAuth();
  const q = useCarrito();
  const qc = useQueryClient();
  const avisar = useAviso();
  const cambiar = useMutation({
    mutationFn: ({ id, cantidad }: { id: number; cantidad: number }) => patch(`/cuenta/carrito/items/${id}`, { cantidad }),
    onSuccess: (d) => qc.setQueryData(['carrito'], d), onError: (e) => avisar(mensajeError(e), 'error'),
  });
  const quitar = useMutation({ mutationFn: (id: number) => del(`/cuenta/carrito/items/${id}`), onSuccess: (d) => qc.setQueryData(['carrito'], d) });

  if (tipo !== 'cliente') {
    return <div className="contenedor py-16"><Vacio titulo="Inicia sesión para ver tu carrito" texto="Guardamos tu carrito en tu cuenta para que lo veas desde cualquier dispositivo."
      accion={<Link to="/entrar?siguiente=/carrito" className="mt-2 rounded-full bg-tinta-900 px-5 py-2 text-sm font-semibold text-white">Entrar</Link>} /></div>;
  }
  if (q.isLoading) return <Cargando />;
  const c = q.data;
  if (!c || c.items.length === 0) {
    return <div className="contenedor py-16"><Vacio titulo="Tu carrito está vacío" texto="Explora el catálogo y agrega uniformes por talla y color."
      accion={<Link to="/catalogo" className="mt-2 rounded-full bg-tinta-900 px-5 py-2 text-sm font-semibold text-white">Ir al catálogo</Link>} /></div>;
  }
  const faltaEnvioGratis = Number(c.envio_gratis_desde) - (Number(c.totales.subtotal) - Number(c.totales.descuento));
  const bloqueado = c.items.some((i) => !i.activo || i.cantidad > i.disponible);

  return (
    <div className="contenedor py-8">
      <h1 className="mb-6 font-display text-3xl font-extrabold tracking-tight">Tu carrito</h1>
      <div className="grid gap-8 lg:grid-cols-[1fr_360px]">
        <div className="space-y-3">
          {c.avisos.map((a) => <Aviso key={a} tipo="alerta">{a}</Aviso>)}
          <ErrorCaja error={q.error} />
          {c.items.map((i) => (
            <article key={i.id} className="flex gap-4 rounded-2xl bg-white p-3 ring-1 ring-arena-200 sm:p-4">
              <Link to={`/producto/${i.slug}`} className="h-24 w-24 shrink-0 overflow-hidden rounded-xl bg-arena-100 sm:h-28 sm:w-28"><ImagenProducto src={i.imagen} alt={i.producto} /></Link>
              <div className="flex flex-1 flex-col">
                <div className="flex justify-between gap-2">
                  <div>
                    <Link to={`/producto/${i.slug}`} className="font-display font-bold hover:underline">{i.producto}</Link>
                    <p className="text-xs text-tinta-400">{i.sku}</p>
                    <p className="mt-1 flex items-center gap-2 text-sm text-tinta-600"><span className="h-3 w-3 rounded-full ring-1 ring-tinta-200" style={{ background: i.color_hex }} />{i.color} · Talla {i.talla}</p>
                    {i.promocion && <p className="mt-1 text-xs font-semibold text-coral-600">{i.promocion}</p>}
                  </div>
                  <p className="font-display font-extrabold">{dinero(i.importe)}</p>
                </div>
                <div className="mt-auto flex items-center justify-between pt-2">
                  <div className="flex h-9 items-center rounded-lg ring-1 ring-arena-300">
                    <button className="px-2.5 disabled:opacity-30" disabled={i.cantidad <= 1 || cambiar.isPending} onClick={() => cambiar.mutate({ id: i.id, cantidad: i.cantidad - 1 })} aria-label="Menos"><Minus className="h-3.5 w-3.5" /></button>
                    <span className="w-8 text-center text-sm font-bold">{i.cantidad}</span>
                    <button className="px-2.5 disabled:opacity-30" disabled={i.cantidad >= i.disponible || cambiar.isPending} onClick={() => cambiar.mutate({ id: i.id, cantidad: i.cantidad + 1 })} aria-label="Más"><Plus className="h-3.5 w-3.5" /></button>
                  </div>
                  <span className="text-xs text-tinta-400">{dinero(Number(i.precio) - Number(i.descuento))} c/u · {i.disponible} disp.</span>
                  <button onClick={() => quitar.mutate(i.id)} className="rounded-lg p-2 text-tinta-400 hover:bg-coral-50 hover:text-coral-600" aria-label="Quitar"><Trash2 className="h-4 w-4" /></button>
                </div>
              </div>
            </article>
          ))}
        </div>
        <aside className="h-fit rounded-2xl bg-white p-5 ring-1 ring-arena-200 lg:sticky lg:top-32">
          <h2 className="font-display text-lg font-bold">Resumen</h2>
          <dl className="mt-4 space-y-2 text-sm">
            <div className="flex justify-between"><dt>Subtotal ({c.articulos} artículos)</dt><dd>{dinero(c.totales.subtotal)}</dd></div>
            {Number(c.totales.descuento) > 0 && <div className="flex justify-between text-coral-600"><dt>Descuentos</dt><dd>−{dinero(c.totales.descuento)}</dd></div>}
            <div className="flex justify-between"><dt>Envío a domicilio</dt><dd>{Number(c.totales.costo_envio) ? dinero(c.totales.costo_envio) : 'Sin costo'}</dd></div>
            <div className="flex justify-between border-t border-arena-200 pt-3 font-display text-lg font-extrabold"><dt>Total</dt><dd>{dinero(c.totales.total)}</dd></div>
            <p className="text-xs text-tinta-400">Incluye IVA de {dinero(c.totales.impuestos)}. Si recoges en sucursal, el envío no tiene costo.</p>
          </dl>
          {faltaEnvioGratis > 0 && <p className="mt-4 rounded-xl bg-menta-50 p-3 text-xs font-semibold text-menta-800">Te faltan {dinero(faltaEnvioGratis)} para envío sin costo.</p>}
          <Link to={bloqueado ? '#' : '/checkout'} aria-disabled={bloqueado}
            className={`mt-5 flex h-12 items-center justify-center gap-2 rounded-xl font-semibold text-white ${bloqueado ? 'pointer-events-none bg-tinta-300' : 'bg-menta-500 hover:bg-menta-600'}`}>
            <ShoppingBag className="h-5 w-5" />Continuar con la compra
          </Link>
          {bloqueado && <p className="mt-2 text-xs text-coral-600">Ajusta las cantidades marcadas para continuar.</p>}
          <p className="mt-3 text-center text-xs text-tinta-400">Las piezas se apartan cuando confirmas el pedido, por {c.reserva_horas} h si pagas por transferencia.</p>
          <Boton variante="fantasma" tam="sm" className="mt-2 w-full" onClick={() => history.back()}>Seguir comprando</Boton>
        </aside>
      </div>
    </div>
  );
}
</file>

<file path="control-pro-plataforma/frontend/src/features/tienda/Catalogo.tsx">
import { useState } from 'react';
import { useSearchParams } from 'react-router-dom';
import { keepPreviousData, useQuery } from '@tanstack/react-query';
import { SlidersHorizontal, X } from 'lucide-react';
import { get } from '../../api/cliente';
import type { Pagina, ProductoResumen } from '../../api/tipos';
import { Boton, Cargando, ErrorCaja, Paginacion, Vacio } from '../../components/ui';
import { cls } from '../../lib/formato';
import ProductoCard from './ProductoCard';

type Resp = Pagina<ProductoResumen> & { facetas: { tallas: string[]; colores: { nombre: string; hex: string }[] } };
type Cat = { id: number; nombre: string; slug: string; productos: number };

export default function Catalogo() {
  const [params, setParams] = useSearchParams();
  const [panel, setPanel] = useState(false);
  const consulta = params.toString();
  const datos = useQuery({ queryKey: ['catalogo', consulta], queryFn: () => get<Resp>(`/tienda/productos?por_pagina=12&${consulta}`), placeholderData: keepPreviousData });
  const cats = useQuery({ queryKey: ['categorias'], queryFn: () => get<Cat[]>('/tienda/categorias'), staleTime: 300_000 });

  const fijar = (k: string, v: string | null) => {
    const p = new URLSearchParams(params);
    if (v === null || v === '' || p.get(k) === v) p.delete(k); else p.set(k, v);
    if (k !== 'pagina') p.delete('pagina');
    setParams(p);
  };
  const activos = ['q', 'categoria', 'talla', 'color', 'precio_min', 'precio_max', 'disponible', 'promocion'].filter((k) => params.get(k));
  const catActual = cats.data?.find((c) => c.slug === params.get('categoria'));

  const filtros = (
    <div className="space-y-6 text-sm">
      <div>
        <p className="mb-2 font-display font-bold">Categoría</p>
        <div className="space-y-1">
          {cats.data?.map((c) => (
            <button key={c.slug} onClick={() => fijar('categoria', c.slug)}
              className={cls('flex w-full items-center justify-between rounded-lg px-2 py-1.5 text-left hover:bg-arena-200', params.get('categoria') === c.slug && 'bg-tinta-900 text-white hover:bg-tinta-800')}>
              {c.nombre}<span className="text-xs opacity-60">{c.productos}</span>
            </button>
          ))}
        </div>
      </div>
      <div>
        <p className="mb-2 font-display font-bold">Talla</p>
        <div className="flex flex-wrap gap-1.5">
          {datos.data?.facetas.tallas.map((t) => (
            <button key={t} onClick={() => fijar('talla', t)} className={cls('min-w-10 rounded-lg px-2 py-1.5 text-xs font-semibold ring-1', params.get('talla') === t ? 'bg-tinta-900 text-white ring-tinta-900' : 'bg-white ring-arena-300 hover:ring-tinta-400')}>{t}</button>
          ))}
        </div>
      </div>
      <div>
        <p className="mb-2 font-display font-bold">Color</p>
        <div className="flex flex-wrap gap-2">
          {datos.data?.facetas.colores.map((c) => (
            <button key={c.nombre} onClick={() => fijar('color', c.nombre)} title={c.nombre} aria-label={c.nombre}
              className={cls('h-7 w-7 rounded-full ring-2 ring-offset-2 ring-offset-arena-100', params.get('color') === c.nombre ? 'ring-tinta-900' : 'ring-arena-300')} style={{ background: c.hex }} />
          ))}
        </div>
      </div>
      <div>
        <p className="mb-2 font-display font-bold">Precio (MXN)</p>
        <form className="flex items-center gap-2" onSubmit={(e) => { e.preventDefault(); const f = new FormData(e.currentTarget); const p = new URLSearchParams(params);
          ['precio_min', 'precio_max'].forEach((k) => { const v = String(f.get(k) || ''); v ? p.set(k, v) : p.delete(k); }); p.delete('pagina'); setParams(p); }}>
          <input name="precio_min" type="number" min={0} defaultValue={params.get('precio_min') || ''} placeholder="Mín" className="h-9 w-full rounded-lg border-0 px-2 ring-1 ring-arena-300" />
          <input name="precio_max" type="number" min={0} defaultValue={params.get('precio_max') || ''} placeholder="Máx" className="h-9 w-full rounded-lg border-0 px-2 ring-1 ring-arena-300" />
          <Boton tam="sm" type="submit">OK</Boton>
        </form>
      </div>
      <label className="flex items-center gap-2 font-semibold">
        <input type="checkbox" checked={params.get('disponible') === '1'} onChange={(e) => fijar('disponible', e.target.checked ? '1' : null)} className="h-4 w-4 rounded accent-menta-500" />
        Solo con existencias
      </label>
    </div>
  );

  return (
    <div className="contenedor py-8">
      <div className="mb-6 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p className="text-xs font-semibold uppercase tracking-widest text-menta-700">Catálogo</p>
          <h1 className="font-display text-3xl font-extrabold tracking-tight">{params.get('q') ? `Resultados para “${params.get('q')}”` : catActual?.nombre || 'Todos los productos'}</h1>
          <p className="text-sm text-tinta-400">{datos.data?.total ?? '…'} producto(s)</p>
        </div>
        <div className="flex items-center gap-2">
          <Boton variante="secundario" className="lg:hidden" onClick={() => setPanel(true)} icono={<SlidersHorizontal className="h-4 w-4" />}>Filtros</Boton>
          <select value={params.get('orden') || 'relevancia'} onChange={(e) => fijar('orden', e.target.value === 'relevancia' ? null : e.target.value)} aria-label="Ordenar"
            className="h-10 rounded-lg border-0 bg-white pr-8 text-sm ring-1 ring-arena-300">
            <option value="relevancia">Más relevantes</option><option value="precio_asc">Menor precio</option>
            <option value="precio_desc">Mayor precio</option><option value="nuevos">Más recientes</option><option value="nombre">Nombre A–Z</option>
          </select>
        </div>
      </div>
      {activos.length > 0 && (
        <div className="mb-5 flex flex-wrap gap-2">
          {activos.map((k) => (
            <button key={k} onClick={() => fijar(k, null)} className="flex items-center gap-1 rounded-full bg-white px-3 py-1 text-xs font-semibold ring-1 ring-arena-300">
              {k === 'disponible' ? 'Con existencias' : k === 'promocion' ? 'En promoción' : `${k.replace('_', ' ')}: ${params.get(k)}`}<X className="h-3 w-3" />
            </button>
          ))}
          <button onClick={() => setParams({})} className="text-xs font-semibold text-coral-600">Limpiar todo</button>
        </div>
      )}
      <div className="grid gap-8 lg:grid-cols-[230px_1fr]">
        <aside className="hidden lg:block">{filtros}</aside>
        <div>
          <ErrorCaja error={datos.error} />
          {datos.isLoading ? <Cargando /> : datos.data && datos.data.items.length === 0 ? (
            <Vacio titulo="No encontramos productos" texto="Prueba con otros filtros o una búsqueda diferente." />
          ) : (
            <div className={cls('grid grid-cols-2 gap-3 sm:gap-5 xl:grid-cols-3', datos.isFetching && 'opacity-60')}>
              {datos.data?.items.map((p) => <ProductoCard key={p.id} p={p} />)}
            </div>
          )}
          {datos.data && <Paginacion pagina={datos.data.pagina} paginas={datos.data.paginas} total={datos.data.total} onCambio={(p) => fijar('pagina', String(p))} />}
        </div>
      </div>
      {panel && (
        <div className="fixed inset-0 z-50 bg-tinta-950/40 lg:hidden" onClick={() => setPanel(false)}>
          <div className="absolute inset-y-0 left-0 w-80 max-w-[85vw] overflow-y-auto bg-arena-50 p-5" onClick={(e) => e.stopPropagation()}>
            <div className="mb-4 flex items-center justify-between"><p className="font-display text-lg font-bold">Filtros</p><button onClick={() => setPanel(false)} aria-label="Cerrar"><X className="h-5 w-5" /></button></div>
            {filtros}
          </div>
        </div>
      )}
    </div>
  );
}
</file>

<file path="control-pro-plataforma/frontend/src/features/tienda/Checkout.tsx">
import { useState } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
import { Banknote, Check, CreditCard, Home, Landmark, Store } from 'lucide-react';
import { claveIdempotencia, get, post } from '../../api/cliente';
import type { Direccion, Pedido, Sucursal } from '../../api/tipos';
import { Aviso, Boton, Cargando, ErrorCaja, Texto } from '../../components/ui';
import { cls, dinero } from '../../lib/formato';
import { FormDireccion } from '../cuenta/Direcciones';
import { useCarrito } from './TiendaLayout';

const PASOS = ['Entrega', 'Pago', 'Revisión'];

function Opcion({ activo, onClick, icono, titulo, texto, deshabilitado }: { activo: boolean; onClick: () => void; icono: React.ReactNode; titulo: string; texto: string; deshabilitado?: boolean }) {
  return (
    <button type="button" disabled={deshabilitado} onClick={onClick}
      className={cls('flex w-full items-start gap-3 rounded-2xl bg-white p-4 text-left ring-2 transition', activo ? 'ring-menta-500' : 'ring-arena-200 hover:ring-arena-300', deshabilitado && 'cursor-not-allowed opacity-50')}>
      <span className={cls('grid h-10 w-10 shrink-0 place-items-center rounded-xl', activo ? 'bg-menta-500 text-white' : 'bg-arena-100 text-tinta-600')}>{icono}</span>
      <span><span className="block font-display font-bold">{titulo}</span><span className="text-sm text-tinta-500">{texto}</span></span>
      {activo && <Check className="ml-auto h-5 w-5 text-menta-600" />}
    </button>
  );
}

export default function Checkout() {
  const nav = useNavigate();
  const qc = useQueryClient();
  const carrito = useCarrito();
  const dirs = useQuery({ queryKey: ['direcciones'], queryFn: () => get<Direccion[]>('/cuenta/direcciones') });
  const sucs = useQuery({ queryKey: ['sucursales-publicas'], queryFn: () => get<Sucursal[]>('/tienda/sucursales') });
  const [paso, setPaso] = useState(0);
  const [modalidad, setModalidad] = useState<'envio' | 'recoger'>('envio');
  const [direccion, setDireccion] = useState<number | null>(null);
  const [sucursal, setSucursal] = useState<number | null>(null);
  const [metodo, setMetodo] = useState<'transferencia' | 'efectivo'>('transferencia');
  const [notas, setNotas] = useState('');
  const [nuevaDir, setNuevaDir] = useState(false);
  const [clave] = useState(() => claveIdempotencia('checkout'));

  const dirSel = direccion ?? dirs.data?.find((d) => d.predeterminada)?.id ?? dirs.data?.[0]?.id ?? null;
  const confirmar = useMutation({
    mutationFn: () => post<Pedido>('/cuenta/checkout', {
      modalidad, metodo_pago: metodo, clave_idempotencia: clave, notas: notas || null,
      ...(modalidad === 'envio' ? { direccion_id: dirSel } : { sucursal_id: sucursal }),
    }),
    onSuccess: (p) => { qc.invalidateQueries({ queryKey: ['carrito'] }); nav(`/cuenta/pedidos/${p.id}?nuevo=1`, { replace: true }); },
  });

  if (carrito.isLoading || dirs.isLoading) return <Cargando />;
  if (!carrito.data?.items.length) return <div className="contenedor py-16 text-center"><p>Tu carrito está vacío.</p><Link to="/catalogo" className="font-semibold text-menta-700">Ir al catálogo</Link></div>;
  const c = carrito.data;
  const listoEntrega = modalidad === 'envio' ? !!dirSel : !!sucursal;
  const envio = modalidad === 'recoger' ? 0 : Number(c.totales.costo_envio);
  const totalEstimado = Number(c.totales.subtotal) - Number(c.totales.descuento) + envio;

  return (
    <div className="contenedor max-w-5xl py-8">
      <h1 className="font-display text-3xl font-extrabold tracking-tight">Finalizar compra</h1>
      <ol className="mt-5 flex gap-2 text-sm font-semibold" aria-label="Pasos">
        {PASOS.map((p, i) => (
          <li key={p} className={cls('flex flex-1 items-center gap-2 rounded-full px-3 py-2', i === paso ? 'bg-tinta-900 text-white' : i < paso ? 'bg-menta-100 text-menta-800' : 'bg-white text-tinta-400 ring-1 ring-arena-200')}>
            <span className="grid h-6 w-6 place-items-center rounded-full bg-white/20 text-xs">{i < paso ? <Check className="h-3.5 w-3.5" /> : i + 1}</span>{p}
          </li>
        ))}
      </ol>

      <div className="mt-8 grid gap-8 lg:grid-cols-[1fr_320px]">
        <div className="space-y-4">
          {paso === 0 && (
            <>
              <div className="grid gap-3 sm:grid-cols-2">
                <Opcion activo={modalidad === 'envio'} onClick={() => { setModalidad('envio'); setMetodo('transferencia'); }} icono={<Home className="h-5 w-5" />} titulo="Envío a domicilio" texto="Surtimos desde la sucursal de tu zona." />
                <Opcion activo={modalidad === 'recoger'} onClick={() => setModalidad('recoger')} icono={<Store className="h-5 w-5" />} titulo="Recoger en sucursal" texto="Sin costo de envío; paga ahí en efectivo." />
              </div>
              {modalidad === 'envio' ? (
                <div className="space-y-2">
                  <p className="font-display font-bold">¿A dónde lo enviamos?</p>
                  {dirs.data?.map((d) => (
                    <label key={d.id} className={cls('flex cursor-pointer gap-3 rounded-2xl bg-white p-4 ring-2', dirSel === d.id ? 'ring-menta-500' : 'ring-arena-200')}>
                      <input type="radio" name="dir" checked={dirSel === d.id} onChange={() => setDireccion(d.id)} className="mt-1 accent-menta-500" />
                      <span className="text-sm"><span className="font-bold">{d.alias}</span> · {d.destinatario}<br />{d.calle} {d.numero}, {d.colonia}, {d.ciudad}, {d.estado} · CP {d.cp}</span>
                    </label>
                  ))}
                  {nuevaDir ? (
                    <div className="rounded-2xl bg-white p-4 ring-1 ring-arena-200">
                      <FormDireccion onGuardada={(d) => { setDireccion(d.id); setNuevaDir(false); qc.invalidateQueries({ queryKey: ['direcciones'] }); }} onCancelar={() => setNuevaDir(false)} />
                    </div>
                  ) : <Boton variante="secundario" onClick={() => setNuevaDir(true)}>Agregar dirección</Boton>}
                </div>
              ) : (
                <div className="space-y-2">
                  <p className="font-display font-bold">Elige la sucursal</p>
                  {sucs.data?.filter((s) => s.permite_recoger).map((s) => (
                    <label key={s.id} className={cls('flex cursor-pointer gap-3 rounded-2xl bg-white p-4 ring-2', sucursal === s.id ? 'ring-menta-500' : 'ring-arena-200')}>
                      <input type="radio" name="suc" checked={sucursal === s.id} onChange={() => setSucursal(s.id)} className="mt-1 accent-menta-500" />
                      <span className="text-sm"><span className="font-bold">{s.nombre}</span><br />{s.direccion}, {s.ciudad} · {Object.entries(s.horario || {}).map(([k, v]) => `${k}: ${v}`).join(' · ')}</span>
                    </label>
                  ))}
                  <p className="text-xs text-tinta-400">Al recoger, todo el pedido debe estar disponible en esa sucursal; si falta algo te lo indicaremos al confirmar.</p>
                </div>
              )}
              <div className="flex justify-end"><Boton disabled={!listoEntrega} onClick={() => setPaso(1)}>Continuar al pago</Boton></div>
            </>
          )}

          {paso === 1 && (
            <>
              <Opcion activo={metodo === 'transferencia'} onClick={() => setMetodo('transferencia')} icono={<Landmark className="h-5 w-5" />} titulo="Transferencia bancaria (SPEI)"
                texto="Al confirmar te damos los datos. Registra la referencia y Finanzas la valida antes de preparar tu pedido." />
              <Opcion activo={metodo === 'efectivo'} deshabilitado={modalidad !== 'recoger'} onClick={() => setMetodo('efectivo')} icono={<Banknote className="h-5 w-5" />} titulo="Efectivo en sucursal"
                texto={modalidad === 'recoger' ? 'Paga en caja; tu pedido se prepara en cuanto se registra el cobro.' : 'Disponible solo si recoges en sucursal.'} />
              <Opcion activo={false} deshabilitado onClick={() => undefined} icono={<CreditCard className="h-5 w-5" />} titulo="Tarjeta de crédito o débito"
                texto="Aún no disponible: requiere integrar una pasarela de pago certificada." />
              <div className="flex justify-between"><Boton variante="secundario" onClick={() => setPaso(0)}>Atrás</Boton><Boton onClick={() => setPaso(2)}>Revisar pedido</Boton></div>
            </>
          )}

          {paso === 2 && (
            <>
              <div className="rounded-2xl bg-white p-4 ring-1 ring-arena-200">
                <p className="mb-2 font-display font-bold">Artículos</p>
                <ul className="divide-y divide-arena-200 text-sm">
                  {c.items.map((i) => (
                    <li key={i.id} className="flex justify-between py-2"><span>{i.cantidad} × {i.producto} <span className="text-tinta-400">({i.color}, {i.talla})</span></span><span className="font-semibold">{dinero(i.importe)}</span></li>
                  ))}
                </ul>
              </div>
              <div className="grid gap-3 text-sm sm:grid-cols-2">
                <div className="rounded-2xl bg-white p-4 ring-1 ring-arena-200"><p className="font-bold">Entrega</p>
                  {modalidad === 'envio' ? (() => { const d = dirs.data?.find((x) => x.id === dirSel); return d && <p>{d.calle} {d.numero}, {d.colonia}, {d.ciudad} · CP {d.cp}</p>; })()
                    : <p>Recoger en {sucs.data?.find((s) => s.id === sucursal)?.nombre}</p>}
                </div>
                <div className="rounded-2xl bg-white p-4 ring-1 ring-arena-200"><p className="font-bold">Pago</p><p>{metodo === 'transferencia' ? 'Transferencia bancaria' : 'Efectivo en sucursal'}</p></div>
              </div>
              <label className="block text-sm font-semibold">Notas para tu pedido (opcional)<Texto value={notas} onChange={(e) => setNotas(e.target.value)} maxLength={500} className="mt-1" /></label>
              <Aviso>Al confirmar, apartamos las piezas. {metodo === 'transferencia' ? `Si no registras tu pago en ${c.reserva_horas} h, la reserva se libera.` : 'Pasa a pagar a la sucursal elegida.'} El total final lo calcula el sistema con las promociones vigentes.</Aviso>
              <ErrorCaja error={confirmar.error} />
              <div className="flex justify-between"><Boton variante="secundario" onClick={() => setPaso(1)}>Atrás</Boton>
                <Boton variante="menta" tam="lg" cargando={confirmar.isPending} onClick={() => confirmar.mutate()}>Confirmar pedido</Boton></div>
            </>
          )}
        </div>

        <aside className="h-fit rounded-2xl bg-white p-5 ring-1 ring-arena-200">
          <p className="font-display font-bold">Resumen</p>
          <dl className="mt-3 space-y-2 text-sm">
            <div className="flex justify-between"><dt>Subtotal</dt><dd>{dinero(c.totales.subtotal)}</dd></div>
            {Number(c.totales.descuento) > 0 && <div className="flex justify-between text-coral-600"><dt>Descuentos</dt><dd>−{dinero(c.totales.descuento)}</dd></div>}
            <div className="flex justify-between"><dt>Envío</dt><dd>{envio ? dinero(envio) : 'Sin costo'}</dd></div>
            <div className="flex justify-between border-t border-arena-200 pt-2 font-display text-lg font-extrabold"><dt>Total estimado</dt><dd>{dinero(totalEstimado)}</dd></div>
          </dl>
        </aside>
      </div>
    </div>
  );
}
</file>

<file path="control-pro-plataforma/frontend/src/features/tienda/Inicio.tsx">
import { Link } from 'react-router-dom';
import { useQuery } from '@tanstack/react-query';
import { ArrowRight, Building2, ClipboardCheck, MapPin, ShieldCheck, Truck } from 'lucide-react';
import { get } from '../../api/cliente';
import type { ProductoResumen } from '../../api/tipos';
import { Cargando, ErrorCaja } from '../../components/ui';
import { fecha } from '../../lib/formato';
import ProductoCard from './ProductoCard';

type Inicio = { destacados: ProductoResumen[]; novedades: ProductoResumen[]; promociones: ProductoResumen[];
  promociones_vigentes: { id: number; nombre: string; tipo: string; valor: string; fin: string }[] };

const CATS = [
  { n: 'Batas', s: 'batas', d: 'Clínica y laboratorio' }, { n: 'Camisas y polos', s: 'camisas-polos', d: 'Oficina, piso y quirófano' },
  { n: 'Pantalones', s: 'pantalones', d: 'Cargo y quirúrgicos' }, { n: 'Protección', s: 'proteccion', d: 'Alta visibilidad' },
  { n: 'Calzado', s: 'calzado', d: 'Seguridad y clínico' }, { n: 'Accesorios', s: 'accesorios', d: 'Gorras y mandiles' },
];

function Seccion({ titulo, enlace, productos }: { titulo: string; enlace: string; productos: ProductoResumen[] }) {
  if (!productos.length) return null;
  return (
    <section className="contenedor mt-14">
      <div className="mb-5 flex items-end justify-between">
        <h2 className="font-display text-2xl font-extrabold tracking-tight text-tinta-900">{titulo}</h2>
        <Link to={enlace} className="flex items-center gap-1 text-sm font-semibold text-menta-700 hover:text-menta-800">Ver todo <ArrowRight className="h-4 w-4" /></Link>
      </div>
      <div className="grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">{productos.slice(0, 8).map((p) => <ProductoCard key={p.id} p={p} />)}</div>
    </section>
  );
}

export default function Inicio() {
  const q = useQuery({ queryKey: ['inicio'], queryFn: () => get<Inicio>('/tienda/inicio') });
  return (
    <>
      <section className="relative overflow-hidden bg-tinta-900 text-white">
        <div className="pointer-events-none absolute -right-24 -top-24 h-96 w-96 rounded-full bg-menta-500/20 blur-3xl" />
        <div className="pointer-events-none absolute bottom-0 left-1/3 h-40 w-[40rem] rounded-full bg-coral-500/10 blur-3xl" />
        <div className="contenedor relative grid gap-10 py-14 md:grid-cols-[1.25fr_1fr] md:py-20">
          <div>
            <p className="mb-4 inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-menta-200">
              <span className="h-1.5 w-1.5 rounded-full bg-menta-400" /> Tres sucursales, un solo inventario visible
            </p>
            <h1 className="texto-equilibrado font-display text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl">
              Uniformes listos para trabajar, surtidos desde la sucursal más cercana.
            </h1>
            <p className="mt-5 max-w-xl text-base text-tinta-200 sm:text-lg">
              Compra por talla y color con existencias reales. Paga por transferencia o recoge y paga en Toluca, Querétaro o Puebla.
            </p>
            <div className="mt-8 flex flex-wrap gap-3">
              <Link to="/catalogo" className="inline-flex h-12 items-center gap-2 rounded-full bg-menta-500 px-6 font-semibold text-white hover:bg-menta-400">Ver catálogo <ArrowRight className="h-4 w-4" /></Link>
              <Link to="/registro?tipo=empresa" className="inline-flex h-12 items-center gap-2 rounded-full bg-white/10 px-6 font-semibold text-white ring-1 ring-white/20 hover:bg-white/15"><Building2 className="h-4 w-4" />Cuenta para empresas</Link>
            </div>
          </div>
          <ul className="grid content-center gap-3 text-sm">
            {[
              [MapPin, 'Asignación por cercanía', 'El pedido se surte desde la sucursal de tu zona; si hace falta, se divide.'],
              [ShieldCheck, 'Reserva al confirmar', 'Las piezas se apartan al hacer el pedido: no vendemos lo que no hay.'],
              [Truck, 'Seguimiento por paquete', 'Cada paquete tiene guía y eventos registrados por la sucursal.'],
              [ClipboardCheck, 'Entrega por empleado', 'Para empresas: aprobación, recepción y firma de conformidad por persona.'],
            ].map(([Icono, t, d]: any) => (
              <li key={t} className="flex gap-3 rounded-2xl bg-white/5 p-4 ring-1 ring-white/10">
                <Icono className="mt-0.5 h-5 w-5 shrink-0 text-menta-300" />
                <div><p className="font-semibold text-white">{t}</p><p className="text-tinta-300">{d}</p></div>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section className="contenedor relative z-10 -mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
        {CATS.map((c) => (
          <Link key={c.s} to={`/catalogo?categoria=${c.s}`} className="rounded-2xl bg-white p-4 shadow-suave ring-1 ring-arena-200 transition hover:ring-menta-400">
            <p className="font-display font-bold text-tinta-900">{c.n}</p>
            <p className="text-xs text-tinta-400">{c.d}</p>
          </Link>
        ))}
      </section>

      {q.isLoading && <Cargando />}
      <div className="contenedor"><ErrorCaja error={q.error} /></div>
      {q.data && (
        <>
          {q.data.promociones_vigentes.length > 0 && (
            <section className="contenedor mt-12">
              <div className="flex flex-col gap-3 rounded-3xl bg-coral-500 p-6 text-white sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <p className="text-xs font-bold uppercase tracking-widest text-coral-100">Promoción vigente</p>
                  {q.data.promociones_vigentes.map((p) => (
                    <p key={p.id} className="font-display text-xl font-extrabold">{p.nombre} · {p.tipo === 'porcentaje' ? `${Number(p.valor)}% de descuento` : `$${Number(p.valor)} menos`} <span className="text-sm font-semibold text-coral-100">hasta el {fecha(p.fin)}</span></p>
                  ))}
                </div>
                <Link to="/catalogo?promocion=1" className="inline-flex h-11 shrink-0 items-center gap-2 rounded-full bg-white px-5 text-sm font-bold text-coral-600">Aprovechar <ArrowRight className="h-4 w-4" /></Link>
              </div>
            </section>
          )}
          <Seccion titulo="Más pedidos por los equipos" enlace="/catalogo" productos={q.data.destacados} />
          <Seccion titulo="En promoción" enlace="/catalogo" productos={q.data.promociones} />
          <Seccion titulo="Novedades" enlace="/catalogo?orden=nuevos" productos={q.data.novedades} />
        </>
      )}

      <section className="contenedor mt-16">
        <div className="grid gap-6 rounded-3xl bg-white p-8 ring-1 ring-arena-200 md:grid-cols-[1.4fr_1fr] md:items-center">
          <div>
            <p className="text-xs font-bold uppercase tracking-widest text-menta-700">Canal corporativo</p>
